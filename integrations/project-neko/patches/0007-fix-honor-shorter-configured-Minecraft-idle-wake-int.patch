diff --git a/plugin/plugins/game_agent_minecraft/test_nudge_timing.py b/plugin/plugins/game_agent_minecraft/test_nudge_timing.py
new file mode 100644
index 0000000..16714dd
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_nudge_timing.py
@@ -0,0 +1,43 @@
+import asyncio
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from plugin.plugins.game_agent_minecraft.service import GameAgentService
+
+
+class NudgeTimingTests(unittest.IsolatedAsyncioTestCase):
+    async def observe(self, interval, *, busy=False, reload_at=None):
+        clock = [1000.0]
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append((clock[0] - 1000, kw)))
+        service.configure({'system_prompt_interval_seconds': interval})
+        service._task_finished = not busy
+        service._last_task_finished_at = 1000.0
+        if busy:
+            service._pending = SimpleNamespace(start_time=1000.0, task_text='正在行动')
+
+        async def step(_):
+            clock[0] += 0.5
+            if reload_at and clock[0] - 1000 == reload_at:
+                service.configure({'system_prompt_interval_seconds': 10.0})
+            if clock[0] > 1025:
+                raise asyncio.CancelledError
+
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.asyncio.sleep', step), patch(module + '.time.time', lambda: clock[0]):
+            await service._system_prompt_loop()
+        return [(at, msg['coalesce_key']) for at, msg in calls]
+
+    async def test_configured_ten_second_idle_interval_is_honored(self):
+        self.assertEqual(await self.observe(10.0), [(10.0, 'mc_keep_going'), (20.0, 'mc_keep_going')])
+
+    async def test_interval_reload_takes_effect_without_restarting_loop(self):
+        self.assertEqual(await self.observe(45.0, reload_at=12.0), [(12.0, 'mc_keep_going'), (22.0, 'mc_keep_going')])
+
+    async def test_shorter_idle_interval_does_not_interrupt_pending_task(self):
+        self.assertEqual(await self.observe(10.0, busy=True), [])
+
+
+if __name__ == '__main__':
+    unittest.main()
