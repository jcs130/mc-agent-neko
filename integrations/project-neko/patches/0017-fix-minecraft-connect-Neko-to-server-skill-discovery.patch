+import asyncio
+import json
+import unittest
+from pathlib import Path
+
+import websockets
+
+from .client import GameAgentClient
+from .observations import GameObservations
+from .test_observations import frame
+
+
+class ServerCommandTests(unittest.IsolatedAsyncioTestCase):
+    async def test_tool_exists_and_disconnected_request_is_failed(self):
+        source = Path(__file__).with_name('__init__.py').read_text(encoding='utf-8')
+        self.assertTrue('name="minecraft_server"' in source)
+        client = GameAgentClient('ws://127.0.0.1:1')
+        self.assertEqual((await client.send_server_command('/mycli help'))['status'], 'failed')
+
+    async def test_correlates_replies_by_id_and_releases_waiters(self):
+        seen = []
+
+        async def handler(ws):
+            for _ in range(2):
+                seen.append(json.loads(await ws.recv()))
+            for request in reversed(seen):
+                await ws.send(json.dumps({'type': 'server_command_result', 'request_id': request['request_id'],
+                                          'status': 'received', 'command': request['command']}))
+            await ws.wait_closed()
+
+        async with websockets.serve(handler, '127.0.0.1', 0) as server:
+            client = GameAgentClient(f'ws://127.0.0.1:{server.sockets[0].getsockname()[1]}')
+            runner = asyncio.create_task(client.start())
+            try:
+                async with asyncio.timeout(3):
+                    while not client.is_connected:
+                        await asyncio.sleep(.01)
+                commands = ['/mycli help', '/mycli spells explain selfheal']
+                results = await asyncio.gather(*(client.send_server_command(c) for c in commands))
+                self.assertEqual([r['command'] for r in results], commands)
+                self.assertEqual([r['type'] for r in seen], ['server_command'] * 2)
+                self.assertEqual(client._server_waiters, {})
+            finally:
+                await client.stop()
+                await asyncio.wait_for(runner, 2)
+
+    async def test_disconnect_returns_uncertain_instead_of_claiming_success(self):
+        async def handler(ws):
+            await ws.recv()
+            await ws.close()
+
+        async with websockets.serve(handler, '127.0.0.1', 0) as server:
+            client = GameAgentClient(f'ws://127.0.0.1:{server.sockets[0].getsockname()[1]}', reconnect_interval=10)
+            runner = asyncio.create_task(client.start())
+            try:
+                async with asyncio.timeout(3):
+                    while not client.is_connected:
+                        await asyncio.sleep(.01)
+                result = await asyncio.wait_for(client.send_server_command('/mycli skills learn selfheal'), 1)
+                self.assertEqual(result['status'], 'unknown')
+                self.assertEqual(client._server_waiters, {})
+            finally:
+                await client.stop()
+                runner.cancel()
+                await asyncio.gather(runner, return_exceptions=True)
+
+    def test_server_skill_entry_and_points_survive_compact_context_reduction(self):
+        from utils.tokenize import count_tokens
+        info = GameObservations()
+        initial = frame()
+        server = initial['state']['server']
+        server['commandCatalog'] = {'namesText': ', '.join(['placeholder'] * 220 + ['mycli'])}
+        server['channels']['mcagent:state'] = {'observedAt': initial['observedAt'], 'value': {
+            'mana': {'current': 24, 'max': 24},
+            'profession': {'points': {'remaining': 7}, 'prepared': []},
+            'abilities': [{'id': 'magicspells:help'}, {'id': 'magicspells:list'}]}}
+        initial['state']['inventory']['slots'] = [{'name': 'written_book', 'book': {'pages': [{'text': '书页' * 2000}]}}]
+        info.ingest_state(initial)
+        text = info.context()
+        self.assertIn('minecraft_server', text)
+        self.assertIn('/mycli spells list 1', text)
+        summary = json.loads(text.split('\n', 1)[1])
+        self.assertEqual(summary['serverSkills']['pointsRemaining'], 7)
+        self.assertEqual(summary['serverSkills']['mana']['current'], 24)
+        self.assertLessEqual(count_tokens(text), 700)
+
+    def test_many_long_ability_ids_fit_small_attention_budget_without_losing_entry(self):
+        from utils.tokenize import count_tokens
+        info = GameObservations()
+        initial = frame()
+        initial['state']['server']['channels']['mcagent:state'] = {'value': {
+            'abilities': [{'id': 'custom:' + 'long_ability_' * 40} for _ in range(8)],
+            'profession': {'points': {'remaining': 7}}, 'mana': {'current': 24, 'max': 24}}}
+        info.ingest_state(initial)
+        text = info.context(max_tokens=400)
+        self.assertLessEqual(count_tokens(text), 400)
+        self.assertIn('minecraft_server', text)
+        self.assertIn('/mycli spells list 1', text)
+
+    def test_unexpected_plugin_payload_does_not_break_context(self):
+        for value in ('binary unavailable', [], {'profession': 'unknown', 'abilities': 'unknown'}):
+            info = GameObservations()
+            initial = frame()
+            initial['state']['server']['channels']['mcagent:state'] = {'value': value}
+            info.ingest_state(initial)
+            self.assertIsInstance(info.context(), str)
+
+    def test_subsecond_host_clock_jitter_does_not_hide_just_received_skill_state(self):
+        info = GameObservations(clock=lambda: 1000.0)
+        initial = frame()
+        initial['observedAt'] = 1000000.25
+        info.ingest_state(initial)
+        self.assertTrue(info.fresh)
+        self.assertIsNotNone(info.view()['state'])
+        info.observed_at = 1002
+        self.assertFalse(info.fresh, 'large future timestamps remain unknown')
+        info.observed_at = 954
+        self.assertFalse(info.fresh, 'stale state remains unknown')
+
+
+if __name__ == '__main__':
+    unittest.main()
