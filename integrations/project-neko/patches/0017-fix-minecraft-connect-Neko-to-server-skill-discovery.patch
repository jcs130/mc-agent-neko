+    async def send_server_command(self, command: str) -> dict[str, Any]:
+        """Request one server gameplay command, independently of body tasks."""
+        if self._ws is None or not self.is_connected:
+            return {'status': 'failed', 'reason': 'disconnected'}
+        request_id = uuid.uuid4().hex
+        future = asyncio.get_running_loop().create_future()
+        self._server_waiters[request_id] = future
+        try:
+            await self._ws.send(json.dumps({'type': 'server_command', 'command': command,
+                                           'request_id': request_id}))
+            return await asyncio.wait_for(future, timeout=4.5)
+        except Exception as exc:
+            return {'status': 'unknown', 'confirmed': False, 'command': command,
+                    'reason': type(exc).__name__}
+        finally:
+            self._server_waiters.pop(request_id, None)
+
+    def _fail_server_waiters(self, reason: str) -> None:
+        for future in tuple(self._server_waiters.values()):
+            if not future.done():
+                future.set_result({'status': 'unknown', 'confirmed': False, 'reason': reason})
+
