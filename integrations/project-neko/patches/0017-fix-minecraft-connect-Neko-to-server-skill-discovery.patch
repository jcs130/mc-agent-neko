+    @llm_tool(
+        name="minecraft_server",
+        description="Query or execute actual Minecraft server gameplay commands via /mycli. Server spells are separate from local runSkill scripts. Discover with /mycli help and /mycli spells list 1 (follow MC_SPELL_NEXT); explain a stable ID with /mycli spells explain <ID>. Use the server's exact learning/casting syntax and required arguments. Check available points, mana, prerequisites and cooldowns first. received/submitted only describes transport, not success: verify server replies and fresh abilities/points/effects/inventory. Use minecraft_chat for conversation.",
+        parameters={'type': 'object', 'properties': {'command': {'type': 'string', 'maxLength': 200}},
+                    'required': ['command']},
+        timeout=10.0,
+    )
+    async def minecraft_server(self, *, command=None, **_):
+        if not isinstance(command, str) or not command.strip() or len(command) > 200:
+            return {'status': 'failed', 'reason': 'command must be one /mycli command of at most 200 characters'}
+        if not await self._ensure_service_started():
+            return {'status': 'failed', 'reason': 'disconnected'}
+        result = await self._service._client.send_server_command(command)
+        self.logger.info('[server-command] command={} status={}', command, result.get('status'))
+        if result.get('status') != 'failed':
+            observation = await self._service.observe_game(['self', 'server'], max_events=0)
+            state = observation.get('state') or {}
+            own = state.get('self') or {}
+            protocol = (((state.get('server') or {}).get('channels') or {}).get('mcagent:state') or {})
+            result['current'] = {'fresh': observation.get('fresh'), 'observedAt': observation.get('observedAt'),
+                                 'self': {key: own.get(key) for key in ('health', 'food', 'position', 'effects')},
+                                 'serverState': protocol.get('value'), 'serverStateObservedAt': protocol.get('observedAt')}
+        return result
+
