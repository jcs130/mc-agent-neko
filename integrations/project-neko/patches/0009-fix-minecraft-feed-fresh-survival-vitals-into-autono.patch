diff --git a/plugin/plugins/game_agent_minecraft/test_survival_state.py b/plugin/plugins/game_agent_minecraft/test_survival_state.py
new file mode 100644
index 0000000..87b30ac
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_survival_state.py
@@ -0,0 +1,73 @@
+import asyncio
+import json
+import time
+import unittest
+from unittest.mock import patch
+
+import websockets
+
+from plugin.plugins.game_agent_minecraft.client import GameAgentClient
+from plugin.plugins.game_agent_minecraft.service import GameAgentService
+
+
+class SurvivalStateTests(unittest.IsolatedAsyncioTestCase):
+    def service(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        return service, calls
+
+    async def test_numeric_vitals_reach_model_and_low_food_wakes_recovery(self):
+        service, calls = self.service()
+        await service._on_vitals({'hp': 16, 'food': 8, 'hostiles': 0})
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(calls[0]['coalesce_key'], 'mc_survival')
+        self.assertIn('16/20', calls[0]['parts'][0]['text'])
+        self.assertIn('8/20', calls[0]['parts'][0]['text'])
+        await service._on_vitals({'hp': 16, 'food': 8, 'hostiles': 0})
+        self.assertEqual(len(calls), 1, 'identical danger must not flood the model')
+        await service._fire_keep_going_nudge()
+        self.assertIn('8/20', calls[-1]['parts'][0]['text'])
+
+    async def test_stale_and_invalid_vitals_are_not_reported_as_current(self):
+        service, calls = self.service()
+        await service._on_vitals({'hp': 20, 'food': 20, 'hostiles': 0})
+        self.assertEqual(calls, [])
+        with patch('plugin.plugins.game_agent_minecraft.service.time.time', return_value=time.time()+60):
+            self.assertIsNone(service._vitals_section())
+        await service._on_vitals({'hp': '!command', 'food': float('nan'), 'hostiles': 0})
+        self.assertEqual(service._last_vitals['hp'], 20)
+
+    async def test_disabled_unattended_mode_only_caches_vitals(self):
+        service, calls = self.service()
+        service.configure({'unattended_enabled': False})
+        await service._on_vitals({'hp': 4, 'food': 1, 'hostiles': 2})
+        self.assertEqual(calls, [])
+        self.assertIn('4/20', service._vitals_section())
+
+    async def test_bridge_routes_real_vitals_frames(self):
+        received = asyncio.Event()
+        values = []
+
+        async def handler(ws):
+            await ws.send(json.dumps({'type': 'vitals', 'hp': 12, 'food': 7, 'hostiles': 1}))
+            await ws.wait_closed()
+
+        async def observe(value):
+            values.append(value)
+            received.set()
+
+        async with websockets.serve(handler, '127.0.0.1', 0) as server:
+            port = server.sockets[0].getsockname()[1]
+            client = GameAgentClient(f'ws://127.0.0.1:{port}', on_vitals=observe)
+            task = asyncio.create_task(client.start())
+            try:
+                await asyncio.wait_for(received.wait(), 2)
+                self.assertEqual(values[0]['food'], 7)
+            finally:
+                await client.stop()
+                await asyncio.wait_for(task, 2)
+
+
+if __name__ == '__main__':
+    unittest.main()
