+    async def _on_vitals(self, data: dict[str, Any]) -> None:
+        # Accept numeric game telemetry only; stale text/logs are not vitals.
+        values = {key: data.get(key) for key in ('hp', 'food', 'hostiles')}
+        if any(type(value) not in (int, float) or not 0 <= value <= (10000 if key == 'hostiles' else 20)
+               for key, value in values.items()):
+            return
+        self._last_vitals = {key: int(value) for key, value in values.items()}
+        self._last_vitals_at = time.time()
+        hp, food, hostiles = (values[key] for key in ('hp', 'food', 'hostiles'))
+        level = (hp <= 10, food <= 8, hostiles > 0 and hp <= 16, hp <= 6 or food <= 2)
+        if not any(level):
+            self._survival_level = None
+            return
+        if not self._unattended.enabled:
+            return
+        if level == self._survival_level and self._last_vitals_at - self._survival_cue_at < 30:
+            return
+        self._survival_level = level
+        self._survival_cue_at = self._last_vitals_at
+        self._push_message(source='game_agent_minecraft', visibility=[], ai_behavior='respond',
+            parts=[{'type': 'text', 'text': self._vitals_section() + '\n'
+                    + prompts.t('SURVIVAL_RECOVERY', lang=self._lang)}],
+            priority=5, coalesce_key='mc_survival')
+
+    def _vitals_section(self) -> Optional[str]:
+        if not self._last_vitals or time.time() - self._last_vitals_at > 45:
+            return None
+        return prompts.t('VITALS_BRIEF', lang=self._lang, **self._last_vitals)
+
