@@ -0,0 +1,131 @@
+import asyncio
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from .service import GameAgentService
+
+
+class AdaptiveHeartbeatTests(unittest.IsolatedAsyncioTestCase):
+    def service(self, clock):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append((clock[0], kw)))
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI',
+                           'system_prompt_interval_seconds': 10.0})
+        service._client = SimpleNamespace(is_connected=True)
+        service._last_task_finished_at = clock[0]
+        return service, calls
+
+    def frame(self, clock, seq):
+        return {'schemaVersion': 1, 'sessionId': 'heartbeat-fixture', 'seq': seq,
+                'observedAt': clock[0] * 1000, 'online': True, 'recentEvents': [],
+                'state': {'self': {'position': {'x': 101.5, 'y': 66, 'z': 203.5}, 'health': 20,
+                                   'food': 20, 'oxygen': 20},
+                          'world': {'dimension': 'overworld', 'timeOfDay': 1000 + seq, 'age': seq},
+                          'activity': {'action': '', 'skill': None, 'digging': None,
+                                       'mobility': {'state': 'FREE', 'since': 1000}},
+                          'inventory': {'counts': {'iron_ingot': 3}},
+                          'nearby': {'sampledBlocks': [{'name': 'stone', 'position': {'x': seq, 'y': 64, 'z': 200}}],
+                                     'entities': [{'id': 12, 'name': 'villager',
+                                                  'position': {'x': 103 + seq/10, 'y': 66, 'z': 204}}]},
+                          'server': {'channels': {'mcagent:state': {'observedAt': clock[0]*1000,
+                                      'value': {'tick': seq, 'mana': 20 + seq % 10}}}}}}
+
+    async def test_clock_entity_and_routine_server_telemetry_do_not_reset_backoff(self):
+        clock = [1000.0]
+        service, calls = self.service(clock)
+        seq = [0]
+
+        async def step(_):
+            clock[0] += .5
+            if clock[0] > 1090:
+                raise asyncio.CancelledError
+            if clock[0] % 2 == 0:
+                seq[0] += 1
+                await service._on_game_state(self.frame(clock, seq[0]))
+
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]), patch(module + '.asyncio.sleep', step):
+            await service._system_prompt_loop()
+        wakes = [stamp - 1000 for stamp, call in calls if call['ai_behavior'] == 'respond']
+        self.assertEqual(wakes, [10.0, 40.0], 'unchanged idle should back off to 30 then 60 seconds')
+
+    async def test_unchanged_facts_are_not_requeued_and_inventory_change_is_published(self):
+        clock = [1000.0]
+        service, calls = self.service(clock)
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]):
+            for seq in range(20):
+                clock[0] = 1000 + seq * 2
+                await service._on_game_state(self.frame(clock, seq))
+            self.assertEqual(len(calls), 1, 'routine ticks must not append duplicate passive callbacks')
+            clock[0] = 1040
+            changed = self.frame(clock, 21)
+            changed['state']['inventory']['counts']['oak_log'] = 2
+            await service._on_game_state(changed)
+        self.assertEqual(len(calls), 2)
+        self.assertIn('oak_log', calls[-1][1]['parts'][0]['text'])
+        self.assertTrue(all(call['ai_behavior'] == 'read' for _, call in calls))
+
+    async def test_running_task_timer_does_not_requeue_unchanged_context(self):
+        clock = [1000.0]
+        service, calls = self.service(clock)
+        service._pending = SimpleNamespace(task_text='寻找木材', start_time=1000)
+        service._task_finished = False
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]):
+            await service._on_game_state(self.frame(clock, 1))
+            for stamp in (1030, 1060, 1090):
+                clock[0] = stamp
+                await service._on_game_state(self.frame(clock, stamp))
+                await service._fire_in_progress_nudge()
+        self.assertEqual(len(calls), 1)
+
+    async def test_new_private_message_bypasses_passive_state_throttle(self):
+        clock = [1000.0]
+        service, calls = self.service(clock)
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]):
+            await service._on_game_state(self.frame(clock, 1))
+            clock[0] += 1
+            data = self.frame(clock, 2)
+            data['recentEvents'] = [{'id': 'new-whisper', 'kind': 'whisper', 'player': 'Friend_1',
+                                    'text': '要不要一起去矿洞？', 'observedAt': clock[0] * 1000}]
+            await service._on_game_state(data)
+        self.assertEqual(calls[-1][1]['ai_behavior'], 'respond')
+        self.assertIn('Friend_1', calls[-1][1]['parts'][0]['text'])
+
+    async def test_rejected_passive_push_does_not_mark_facts_delivered(self):
+        clock = [1000.0]
+        service, calls = self.service(clock)
+        attempts = []
+        def submit(**kw):
+            attempts.append(kw)
+            return {'submitted': len(attempts) > 1}
+        service._push_message = submit
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]):
+            await service._on_game_state(self.frame(clock, 1))
+            clock[0] += 16
+            await service._on_game_state(self.frame(clock, 2))
+        self.assertEqual(len(attempts), 2)
+
+    async def test_skill_readiness_and_downed_teammates_remain_decision_changes(self):
+        clock = [1000.0]
+        service, _ = self.service(clock)
+        info = service._game_observations
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]):
+            revisions = []
+            for seq, cooldown, downed in ((1, 3000, []), (2, 2000, []), (3, 0, []), (4, 0, ['Friend_1'])):
+                data = self.frame(clock, seq)
+                data['state']['server']['channels']['mcagent:state']['value'].update(
+                    abilities=[{'id': 'mycli:prospect', 'cooldownRemainingMs': cooldown}],
+                    trialRescue={'downedTeammates': downed})
+                await service._on_game_state(data)
+                revisions.append(info.decision_revision)
+        self.assertEqual(revisions, [1, 1, 2, 3])
+
+
+if __name__ == '__main__':
+    unittest.main()
