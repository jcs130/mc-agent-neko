index 0000000..eb32c8f
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/static/viewer.js
@@ -0,0 +1,116 @@
+const pluginId = 'game_agent_minecraft';
+const frame = document.querySelector('#game');
+const status = document.querySelector('#status');
+const placeholder = document.querySelector('#placeholder');
+const openLink = document.querySelector('#open');
+const refreshButton = document.querySelector('#refresh');
+let copy = {};
+let mountedUrl = '';
+let refreshing = false;
+const t = (key, fallback) => copy[`viewer.${key}`] || fallback;
+
+async function language() {
+    const query = new URLSearchParams(location.search);
+    let locale = query.get('locale') || query.get('lang');
+    if (!locale) {
+        try {
+            const current = await fetch(`/plugin/${pluginId}/ui-api/locale`, { signal: AbortSignal.timeout(3000) });
+            if (current.ok) locale = (await current.json()).locale;
+        } catch { /* Keep the page usable if the language endpoint is unavailable. */ }
+    }
+    locale = locale || 'zh-CN';
+    if (locale === 'zh' || locale === 'zh-Hans') locale = 'zh-CN';
+    if (locale === 'zh-Hant') locale = 'zh-TW';
+    if (!locale.startsWith('zh')) locale = locale.split('-')[0];
+    if (!['zh-CN', 'zh-TW', 'en', 'ja', 'ko', 'ru', 'es', 'pt'].includes(locale)) locale = 'en';
+    const response = await fetch(`/plugin/${pluginId}/ui-api/i18n/${locale}.json`);
+    if (response.ok) copy = await response.json();
+    document.documentElement.lang = locale;
+    document.querySelectorAll('[data-i18n]').forEach(node => {
+        node.textContent = copy[node.dataset.i18n] || node.textContent;
+    });
+    frame.title = t('title', 'Minecraft Viewer');
+    document.title = frame.title;
+}
+
+async function callStatus() {
+    const securityResponse = await fetch('/security/csrf-token', { signal: AbortSignal.timeout(5000) });
+    if (!securityResponse.ok) throw new Error(`HTTP ${securityResponse.status}`);
+    const security = await securityResponse.json();
+    const response = await fetch('/runs', {
+        method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': security.csrf_token },
+        body: JSON.stringify({ plugin_id: pluginId, entry_id: 'game_agent_status', args: {} }),
+        signal: AbortSignal.timeout(8000),
+    });
+    if (!response.ok) throw new Error(`HTTP ${response.status}`);
+    const created = await response.json();
+    const id = created.run_id || created.id;
+    if (!id) throw new Error('Missing run id');
+    const deadline = Date.now() + 10000;
+    while (Date.now() < deadline) {
+        await new Promise(resolve => setTimeout(resolve, 250));
+        const runResponse = await fetch(`/runs/${encodeURIComponent(id)}`, { signal: AbortSignal.timeout(3000) });
+        if (!runResponse.ok) throw new Error(`HTTP ${runResponse.status}`);
+        const run = await runResponse.json();
+        if (run.status === 'succeeded') {
+            const exported = await fetch(`/runs/${encodeURIComponent(id)}/export`, { signal: AbortSignal.timeout(3000) });
+            if (!exported.ok) throw new Error(`HTTP ${exported.status}`);
+            const result = await exported.json();
+            const value = result.items?.find(item => item.type === 'json')?.json;
+            if (value?.success === false || value?.error) throw new Error('Status query failed');
+            return value?.data || value || {};
+        }
+        if (['failed', 'canceled', 'timeout'].includes(run.status)) throw new Error(run.status);
+    }
+    throw new Error('Status query timed out');
+}
+
+function viewerUrl(viewer) {
+    const url = new URL(viewer.url);
+    if (viewer.lan_url && !['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)) {
+        const lan = new URL(viewer.lan_url);
+        if (lan.protocol === 'http:' && !lan.username && !lan.password && lan.hostname === location.hostname)
+            return new URL('dungeon/', lan).href;
+    }
+    if (url.protocol !== 'http:' || url.username || url.password
+        || !['127.0.0.1', 'localhost', location.hostname].includes(url.hostname)) throw new Error('Invalid viewer URL');
+    return new URL('dungeon/', url).href;
+}
+
+async function refresh(reload = false) {
+    if (refreshing) return;
+    refreshing = true;
+    refreshButton.disabled = true;
+    try {
+        const data = await callStatus();
+        const viewer = data.viewer;
+        if (!data.connected || !viewer?.available || viewer.type !== 'modern') {
+            status.dataset.connected = 'false';
+            status.textContent = t('unavailable', 'Modern viewer is unavailable');
+            frame.hidden = true;
+            frame.removeAttribute('src');
+            mountedUrl = '';
+            openLink.hidden = true;
+            placeholder.hidden = false;
+            return;
+        }
+        const url = viewerUrl(viewer);
+        status.dataset.connected = 'true';
+        status.textContent = `${t('connected', 'Connected')} · ${viewer.username || ''} · ${viewer.version || ''}`;
+        placeholder.hidden = true;
+        frame.hidden = false;
+        if (url !== mountedUrl || reload) { frame.src = url; mountedUrl = url; }
+        openLink.href = url;
+        openLink.hidden = false;
+    } catch (error) {
+        status.dataset.connected = 'false';
+        status.textContent = `${t('error', 'Connection error')}: ${error.message}`;
+    } finally {
+        refreshing = false;
+        refreshButton.disabled = false;
+    }
+}
+
+refreshButton.addEventListener('click', () => refresh(true));
+language().catch(() => {}).finally(() => refresh());
+setInterval(() => { if (!document.hidden) refresh(); }, 20000);
