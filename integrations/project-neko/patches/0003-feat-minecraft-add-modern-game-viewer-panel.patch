+import asyncio
+import json
+import unittest
+
+import websockets
+
+from plugin.plugins.game_agent_minecraft.client import GameAgentClient
+from plugin.plugins.game_agent_minecraft.service import GameAgentService
+
+
+class ViewerTests(unittest.IsolatedAsyncioTestCase):
+    async def test_metadata_is_received_without_llm_and_cleared_on_disconnect(self):
+        close = asyncio.Event()
+        viewer = {"available": True, "type": "modern", "url": "http://127.0.0.1:3000/",
+                  "username": "ag_NEKO", "views": ["first", "third", "dungeon"]}
+
+        async def handler(ws):
+            await ws.send(json.dumps({"type": "viewer_info", "viewer": viewer}))
+            await close.wait()
+            await ws.close()
+
+        async with websockets.serve(handler, "127.0.0.1", 0) as server:
+            client = GameAgentClient(f"ws://127.0.0.1:{server.sockets[0].getsockname()[1]}", reconnect_interval=10)
+            service = GameAgentService(logger=None, push_message_fn=lambda **_: None)
+            service._client = client
+            runner = asyncio.create_task(client.start())
+            try:
+                async with asyncio.timeout(3):
+                    while client.viewer_info is None:
+                        await asyncio.sleep(0.01)
+                self.assertEqual(service.get_status()["viewer"], viewer)
+                self.assertTrue(service.get_status()["connected"])
+                close.set()
+                async with asyncio.timeout(3):
+                    while client.is_connected:
+                        await asyncio.sleep(0.01)
+                self.assertIsNone(service.get_status()["viewer"])
+            finally:
+                close.set()
+                await client.stop()
+                runner.cancel()
+                await asyncio.gather(runner, return_exceptions=True)
+            self.assertIsNone(client.viewer_info)
+
+
+if __name__ == "__main__":
+    unittest.main()
