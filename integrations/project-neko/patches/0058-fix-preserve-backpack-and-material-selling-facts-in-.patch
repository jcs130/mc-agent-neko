diff --git a/plugin/plugins/game_agent_minecraft/test_economy_storage_context.py b/plugin/plugins/game_agent_minecraft/test_economy_storage_context.py
new file mode 100644
index 0000000..a3cf4c7
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_economy_storage_context.py
@@ -0,0 +1,75 @@
+import copy
+import unittest
+
+from .observations import GameObservations
+from .test_grounded_recovery import crowded_frame
+
+
+class EconomyStorageContextTests(unittest.TestCase):
+    def observations(self):
+        data = crowded_frame()
+        inv = data['state']['inventory']
+        inv['counts'].update(coal=64, emerald=0, player_head=1)
+        inv['emptySlots'] = 2
+        inv['slots'].append({'slot': 36, 'name': 'player_head', 'count': 1,
+                             'customName': '大背包', 'lore': []})
+        obs = GameObservations()
+        self.assertTrue(obs.ingest_state(data))
+        return obs
+
+    def test_named_backpack_survives_the_real_callback_budget(self):
+        obs = self.observations()
+        before = copy.deepcopy(obs.state)
+        view = obs.focused_view(mode='decision', max_tokens=700, max_events=0)
+        backpack = view['resources']['storage'][0]
+        self.assertEqual((backpack['slot'], backpack['id'], backpack['name']),
+                         (36, 'player_head', '大背包'))
+        self.assertEqual(obs.state, before)
+
+    def test_unnamed_heads_are_not_inferred_to_be_backpacks(self):
+        obs = self.observations()
+        obs.state['inventory']['slots'][-1].pop('customName')
+        self.assertNotIn('storage', obs.operational_resources())
+        obs.online = False
+        self.assertIsNone(obs.operational_resources())
+
+    def test_loaded_containers_are_discovery_facts_without_public_access_claims(self):
+        obs = self.observations()
+        obs.state['nearby']['containers'] = [{'name': 'barrel', 'position': {'x': 8, 'y': 64, 'z': 2}, 'distance': 3.5}]
+        view = obs.focused_view(max_tokens=1800, max_events=0)
+        self.assertEqual(view['state']['nearby']['containers'][0]['name'], 'barrel')
+        self.assertNotIn('public', view['state']['nearby']['containers'][0])
+
+    def test_late_affordable_sell_quote_beats_unaffordable_purchases(self):
+        obs = self.observations()
+        purchases = [{'index': i, 'costs': [{'item': 'emerald', 'count': 5}],
+                      'result': {'item': 'bread', 'count': 1},
+                      'uses': 0, 'maxUses': 16, 'disabled': False} for i in range(1, 4)]
+        sell = {'index': 4, 'costs': [{'item': 'coal', 'count': 15}],
+                'result': {'item': 'emerald', 'count': 1},
+                'uses': 2, 'maxUses': 16, 'disabled': False}
+        obs.state['window'] = {'id': 7, 'type': 'minecraft:merchant', 'slots': [],
+                              'merchantOffers': {'status': 'ready', 'receivedCount': 4,
+                                                 'offers': purchases + [sell]}}
+        before = copy.deepcopy(obs.state)
+        merchant = obs.focused_view(max_tokens=1800, max_events=0)['merchant']
+        self.assertEqual(merchant['offers'][0]['index'], 4)
+        self.assertEqual(merchant['offers'][0]['maxExecutions'], 4)
+        self.assertEqual(merchant['offers'][0]['direction'], 'sell_for_emeralds')
+        self.assertEqual(obs.state, before)
+
+    def test_exhausted_stock_and_incomplete_payments_do_not_invent_affordability(self):
+        obs = self.observations()
+        quote = {'index': 1, 'costs': [{'item': 'coal', 'count': 15}],
+                 'result': {'item': 'emerald', 'count': 1},
+                 'uses': 16, 'maxUses': 16, 'disabled': True}
+        obs.state['window'] = {'id': 7, 'type': 'minecraft:merchant', 'slots': [],
+                              'merchantOffers': {'status': 'ready', 'receivedCount': 1, 'offers': [quote]}}
+        self.assertEqual(obs.focused_view(max_tokens=1800, max_events=0)['merchant']['offers'][0]['maxExecutions'], 0)
+        obs.truncated = ['$.inventory.counts']
+        quote.update(disabled=False, uses=0)
+        self.assertNotIn('maxExecutions', obs.focused_view(max_tokens=1800, max_events=0)['merchant']['offers'][0])
+
+
+if __name__ == '__main__':
+    unittest.main()
