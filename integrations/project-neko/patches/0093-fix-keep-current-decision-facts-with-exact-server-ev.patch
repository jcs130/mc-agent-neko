+def server_reply_input(archive, reply):
+    """Keep command facts whole; index duplicate protocol and full skill state."""
+    value = deepcopy(reply)
+    current = value.get('current')
+    state = current.get('serverState') if isinstance(current, dict) else None
+    messages = reply.get('messages') or []
+    represented = {}
+    for message_index, message in enumerate(messages):
+        match = re.fullmatch(r'\s*(MC_[A-Z0-9_]+)\s+(\{.*\}|\[.*\])\s*', message, re.DOTALL) if isinstance(message, str) else None
+        if not match:
+            continue
+        try:
+            original = json.loads(match[2])
+        except ValueError:
+            continue
+        encoded = json.dumps(original, ensure_ascii=False, sort_keys=True, separators=(',', ':'))
+        represented.setdefault((match[1], encoded), message_index)
+    duplicates = {}
+    for index, record in enumerate(value.get('records') or []):
+        if (not isinstance(record, dict) or set(record) != {'kind', 'value'}
+                or not isinstance(record['kind'], str)):
+            continue
+        encoded = json.dumps(record['value'], ensure_ascii=False, sort_keys=True, separators=(',', ':'))
+        key = record['kind'], encoded
+        if key in represented:
+            duplicates[index] = represented[key]
+    if not isinstance(state, dict) and not duplicates:
+        return value
+    value['replyEvidence'] = archive.save(reply)
+    value['replyEvidence']['read'] = 'minecraft_observe(evidence_id=replyEvidence.id,reference_path="<path>")'
+    if isinstance(state, dict):
+        current['serverState'] = {'evidence': 'replyEvidence.id', 'path': '/current/serverState',
+            'kind': 'dict', 'fields': list(state),
+            'note': 'Full skill state is queryable. Current mana/profession are below; read exact abilities/cooldowns when needed.'}
+        for key in ('mana', 'profession'):
+            if key in state:
+                current[key] = deepcopy(state[key])
+    for index, message_index in duplicates.items():
+        record = value['records'][index]
+        record['value'] = {'evidence': 'replyEvidence.id', 'path': f'/records/{index}/value',
+                           'representedInMessage': message_index}
+        record['valueIsReference'] = True
+    # References can cost more than small replies. Keep those replies whole;
+    # this is a representation choice, never a text budget or an omitted fact.
+    if len(json.dumps(value, ensure_ascii=False)) >= len(json.dumps(reply, ensure_ascii=False)):
+        return deepcopy(reply)
+    return value
+
+
