+    def test_server_reply_indexes_only_exact_duplicate_machine_records(self):
+        from .evidence import server_reply_input
+        archive = GameEvidence()
+        fact = {'description': '完整说明' * 3000, 'learned': True, 'cost': 10}
+        messages = ['真实玩家文本和服务端条件保持全文。', 'MC_SPELL_ITEM ' + json.dumps(fact),
+                    'MC_STATUS {"flag":true}', 'MC_ERROR {"why":"unknown"} trailing explanation']
+        records = [{'kind': 'MC_SPELL_ITEM', 'value': fact},
+                   {'kind': 'MC_STATUS', 'value': {'flag': 1}},
+                   {'kind': 'MC_ERROR', 'value': {'why': 'unknown'}},
+                   {'kind': 'MC_SPELL_ITEM', 'value': fact, 'newField': '不能丢未知字段'},
+                   {'kind': ['unexpected'], 'value': fact}]
+        original = {'status': 'received', 'messages': messages, 'records': records}
+        result = server_reply_input(archive, original)
+        self.assertEqual(result['messages'], messages)
+        self.assertTrue(result['records'][0]['valueIsReference'])
+        self.assertEqual(result['records'][0]['value']['representedInMessage'], 1)
+        self.assertEqual(archive.read(result['replyEvidence']['id'], '/records/0/value')['value'], fact)
+        self.assertEqual(result['records'][1:], records[1:])
+        self.assertEqual(archive.read(result['replyEvidence']['id'], '/')['value'], original)
+
