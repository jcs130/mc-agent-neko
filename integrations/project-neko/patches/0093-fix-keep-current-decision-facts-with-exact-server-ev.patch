+    def test_decision_indexes_historical_welcome_but_keeps_current_play_and_social_facts(self):
+        info = self.observations()
+        welcome = {'sessionId': info.session_id, 'messages': [
+            {'id': 'login', 'source': 'server', 'kind': 'system',
+             'text': '旧登录提示' * 1000, 'observedAt': 10000},
+            {'id': 'guide', 'source': 'server', 'kind': 'system',
+             'text': '倒地救援靠近4格10秒自动复活，无需法杖。', 'observedAt': 10001}]}
+        info.state['server']['welcome'] = welcome
+        entities = [{'id': 1, 'type': 'player', 'username': 'Friend', 'name': 'player',
+                     'health': 18, 'distance': 2, 'equipment': [{'name': 'iron_sword'}]},
+                    {'id': 2, 'type': 'hostile', 'name': 'zombie', 'distance': 3, 'health': 20},
+                    {'id': 3, 'type': 'other', 'name': 'item', 'distance': 1,
+                     'droppedItem': {'name': 'diamond', 'count': 2}}]
+        info.state['nearby'] = {'entities': entities}
+        before = json.dumps(info.view(), ensure_ascii=False, sort_keys=True)
+        view = decision_input(info)
+        self.assertNotIn('旧登录提示', json.dumps(view, ensure_ascii=False))
+        reference = view['state']['server']['welcome']
+        self.assertEqual(reference['path'], '/state/server/welcome')
+        self.assertTrue(reference['historical'])
+        self.assertEqual(reference['messageCount'], 2)
+        self.assertEqual(info.evidence.read(view['rawEvidence']['id'], reference['path'])['value'], welcome)
+        self.assertEqual(view['serverSkills']['abilities'][0]['name'], '闪现')
+        self.assertEqual(view['state']['self']['health'], 20)
+        self.assertEqual(view['state']['nearby']['entities']['entries'], len(entities))
+        self.assertIn('Friend', json.dumps(view, ensure_ascii=False))
+        self.assertIn('diamond', json.dumps(view, ensure_ascii=False))
+        self.assertEqual(info.evidence.read(view['rawEvidence']['id'], '/recentEvents/0/text')['value'], '来拿装备' * 1000)
+        self.assertEqual(json.dumps(info.view(), ensure_ascii=False, sort_keys=True), before)
+
+    def test_server_reply_keeps_exact_messages_vitals_and_resources_with_complete_state_query(self):
+        from .evidence import server_reply_input
+        archive = GameEvidence()
+        state = {'mana': {'current': 19, 'max': 28},
+                 'profession': {'id': 'mage', 'points': {'remaining': 3}},
+                 'abilities': [{'id': 'blink', 'name': '闪现', 'description': '完整法术说明' * 10000,
+                                'cooldownRemaining': 7, 'learned': True}]}
+        messages = ['实际查询返回：缺少3铁锭。', 'MC_STATUS 原始结果' * 2000]
+        original = {'status': 'received', 'command': '/mycli guild status',
+                    'readOnly': True, 'messages': messages,
+                    'current': {'fresh': True, 'observedAt': 20, 'self': {'health': 20, 'food': 18,
+                        'position': {'x': 1, 'y': 64, 'z': -2}, 'effects': []},
+                        'serverStateObservedAt': 19999, 'serverState': state},
+                    'decision': {'status': 'ready_if_authorized'}}
+        before = json.dumps(original, ensure_ascii=False, sort_keys=True)
+        view = server_reply_input(archive, original)
+        self.assertEqual(view['messages'], messages)
+        self.assertEqual(view['command'], original['command'])
+        self.assertEqual(view['current']['mana'], state['mana'])
+        self.assertEqual(view['current']['profession'], state['profession'])
+        self.assertEqual(view['current']['self'], original['current']['self'])
+        self.assertEqual(view['current']['serverStateObservedAt'], 19999)
+        self.assertEqual(view['decision'], original['decision'])
+        index = view['current']['serverState']
+        self.assertEqual(index['evidence'], 'replyEvidence.id')
+        self.assertEqual(index['path'], '/current/serverState')
+        self.assertEqual(set(index['fields']), set(state))
+        self.assertNotIn('完整法术说明', json.dumps(view, ensure_ascii=False))
+        self.assertEqual(archive.read(view['replyEvidence']['id'], '/')['value'], original)
+        self.assertEqual(archive.read(view['replyEvidence']['id'], index['path'])['value'], state)
+        self.assertEqual(json.dumps(original, ensure_ascii=False, sort_keys=True), before)
+        view['messages'][0] = 'changed'
+        self.assertEqual(original['messages'], messages)
+
