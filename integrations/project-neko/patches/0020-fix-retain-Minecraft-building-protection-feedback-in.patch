diff --git a/plugin/plugins/game_agent_minecraft/test_server_commands.py b/plugin/plugins/game_agent_minecraft/test_server_commands.py
index 2e8f3ec..a063122 100644
--- a/plugin/plugins/game_agent_minecraft/test_server_commands.py
+++ b/plugin/plugins/game_agent_minecraft/test_server_commands.py
@@ -11,6 +11,24 @@ from .test_observations import frame
 
 
 class ServerCommandTests(unittest.IsolatedAsyncioTestCase):
+    def test_protection_permission_and_failure_survive_small_context_budget(self):
+        from utils.tokenize import count_tokens
+        for budget in (400, 700):
+            info = GameObservations()
+            initial = frame()
+            initial['state']['server']['protection'] = {'enabled': True, 'installed': True, 'lastBlocked': {
+                'action': 'break', 'world': 'minecraft:overworld', 'x': 104, 'y': 17, 'z': 203,
+                'status': 'deny', 'allowed': False, 'reason': 'original_building', 'observedAt': initial['observedAt']}}
+            initial['state']['inventory']['counts'] = {'custom_' + 'long_name_' * 50 + str(i): i for i in range(32)}
+            info.ingest_state(initial)
+            text = info.context(max_tokens=budget)
+            summary = json.loads(text.split('\n', 1)[1])
+            self.assertEqual(summary['protection']['lastBlocked']['status'], 'deny')
+            self.assertEqual(summary['protection']['lastBlocked']['x'], 104)
+            self.assertEqual(summary['protection']['lastBlocked']['reason'], 'original_building')
+            self.assertIn('/mycli protect break', text)
+            self.assertLessEqual(count_tokens(text), budget)
+
     async def test_tool_exists_and_disconnected_request_is_failed(self):
         source = Path(__file__).with_name('__init__.py').read_text(encoding='utf-8')
         self.assertTrue('name="minecraft_server"' in source)
