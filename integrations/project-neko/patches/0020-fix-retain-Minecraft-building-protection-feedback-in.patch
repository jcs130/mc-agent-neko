diff --git a/plugin/plugins/game_agent_minecraft/test_observations.py b/plugin/plugins/game_agent_minecraft/test_observations.py
index f816279..6588250 100644
--- a/plugin/plugins/game_agent_minecraft/test_observations.py
+++ b/plugin/plugins/game_agent_minecraft/test_observations.py
@@ -35,6 +35,24 @@ class ObservationTests(unittest.IsolatedAsyncioTestCase):
         service.set_lang('zh')
         return service, calls
 
+    async def test_blocked_dig_and_plain_protection_denial_wake_judgment(self):
+        for kind, text, data in (
+                ('protection', 'Server protection deny at (104,17,203): original_building',
+                 {'action': 'break', 'status': 'deny', 'x': 104, 'y': 17, 'z': 203}),
+                ('system', '这里是受保护的建筑，请停止挖掘。', {})):
+            service, calls = self.service()
+            await service._on_game_state(frame(recentEvents=[event('fixture:protection', kind, text, data=data)]))
+            responses = [call for call in calls if call['ai_behavior'] == 'respond']
+            self.assertEqual(len(responses), 1, kind)
+            self.assertIn(text[:60], responses[0]['parts'][0]['text'])
+
+    async def test_routine_solicited_protection_replies_do_not_wake_again(self):
+        service, calls = self.service()
+        await service._on_game_state(frame(recentEvents=[event('fixture:reply', 'server_record', 'MC_PROTECTION deny',
+            data={'kind': 'MC_PROTECTION', 'value': {'status': 'deny'},
+                  'solicitedCommand': '/mycli protect break 104 17 203'})]))
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+
