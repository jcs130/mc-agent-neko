diff --git a/plugin/plugins/game_agent_minecraft/test_query_progress.py b/plugin/plugins/game_agent_minecraft/test_query_progress.py
new file mode 100644
index 0000000..b47a0f1
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_query_progress.py
@@ -0,0 +1,98 @@
+"""Queries are references; accepted-task reports and physical progress are distinct."""
+import copy
+import json
+import unittest
+
+from utils.tokenize import count_tokens
+
+from .observations import GameObservations
+from .test_server_play_context import gameplay_frame
+
+
+class QueryProgressTests(unittest.TestCase):
+    def info(self):
+        self.clock = [1000.0]
+        info = GameObservations(clock=lambda: self.clock[0])
+        self.data = gameplay_frame()
+        self.data['observedAt'] = 1000000
+        self.data['recentEvents'] = []
+        info.ingest_state(self.data)
+        return info
+
+    def event(self, ident, command=None, kind='system', text='任务目录说明'):
+        return {'id': ident, 'kind': kind, 'text': text, 'observedAt': self.clock[0] * 1000,
+                'data': {'solicitedCommand': command} if command else {}}
+
+    def events(self, info, events):
+        info.ingest_events({**self.data, 'events': events})
+
+    def test_solicited_query_replies_remain_readable_without_resetting_idle_backoff(self):
+        info = self.info()
+        revision = info.decision_revision
+        self.events(info, [self.event(str(i), '/mycli guild market tm_carrots') for i in range(3)])
+        self.assertEqual(info.decision_revision, revision)
+        self.assertEqual(len(info.events), 3)
+
+    def test_private_chat_and_unsolicited_denial_still_wake_decisions(self):
+        info = self.info()
+        for event in (self.event('private', kind='whisper', text='NEKO 要帮忙吗'),
+                      self.event('denied', text='无法破坏受保护建筑')):
+            revision = info.decision_revision
+            self.events(info, [event])
+            self.assertGreater(info.decision_revision, revision)
+
+    def test_inspected_catalogue_is_not_an_active_goal_or_physical_progress(self):
+        info = self.info()
+        for seq, ident in ((2, 'tm_wheat'), (3, 'tm_carrots')):
+            data = copy.deepcopy(self.data)
+            data['seq'] = seq
+            data['state']['server']['channels']['mcagent:market'] = {
+                'observedAt': 1000000, 'value': {'type': 'MC_MARKET_DETAIL', 'id': ident,
+                'title': '未确认接取的任务', 'steps': [{'index': 1, 'goal': 'harvest', 'target': 10}]}}
+            revision = info.decision_revision
+            info.ingest_state(data)
+            self.assertEqual(info.decision_revision, revision)
+        play = info.focused_view()['serverPlay']
+        self.assertNotIn('focus', play)
+        self.assertEqual(play['inspectedReference']['id'], 'tm_carrots')
+
+    def test_actual_progress_report_survives_unrelated_queries_and_small_capsule(self):
+        info = self.info()
+        progress = '正在进行：青禾的麦田约定 · 1/3 收割成熟小麦 [4/8]'
+        self.events(info, [self.event('guild-status', '/mycli guild status', text=progress)])
+        self.clock[0] += 2
+        self.events(info, [self.event('catalogue', '/mycli guild market tm_carrots')])
+        for budget in (700, 400):
+            text = info.focused_context(max_tokens=budget)
+            play = json.loads(text.split('\n', 1)[1])['serverPlay']
+            self.assertIn(progress, str(play.get('activeReport')))
+            self.assertLessEqual(count_tokens(text), budget)
+        self.clock[0] += 130
+        self.events(info, [])  # Short-lived event list is not the progress-report cache.
+        self.assertIn(progress, str(info.server_progress()))
+
+    def test_progress_report_expires_and_never_crosses_game_sessions(self):
+        info = self.info()
+        self.events(info, [self.event('status', '/mycli guild status', text='正在进行：小麦 [4/8]')])
+        self.assertIsNotNone(info.server_progress())
+        self.clock[0] += 601
+        self.assertIsNone(info.server_progress())
+        self.clock[0] = 1001
+        self.data['sessionId'] = 'new-game-session'
+        info.ingest_state(self.data)
+        self.assertIsNone(info.server_progress())
+
+    def test_real_check_progress_is_still_a_decision_change(self):
+        info = self.info()
+        data = copy.deepcopy(self.data)
+        data['seq'] = 2
+        data['state']['server']['channels']['mcagent:market'] = {
+            'value': {'type': 'MC_MARKET_CHECK', 'task': 'tm_wheat', 'step': 1,
+                      'progress': 4, 'ready': False}}
+        revision = info.decision_revision
+        info.ingest_state(data)
+        self.assertGreater(info.decision_revision, revision)
+
+
+if __name__ == '__main__':
+    unittest.main()
