+class FeedbackExcerptTests(unittest.TestCase):
+    def test_unstructured_long_report_keeps_a_terminal_failure_within_budget(self):
+        from .feedback import task_feedback_excerpt
+        text = '已执行一部分。' + '原始动作观察🪨。' * 300 + '最终失败：目标已经消失。'
+        for budget in (40, 110, 220):
+            with self.subTest(budget=budget):
+                excerpt = task_feedback_excerpt(text, budget)
+                self.assertIn('最终失败：目标已经消失。', excerpt)
+                self.assertLessEqual(count_tokens(excerpt), budget)
+
+    def test_short_unstructured_feedback_and_leading_receipt_remain_available(self):
+        from .feedback import task_feedback_excerpt
+        for text in ('没有找到目标。', '[Observed game data: actual command results, not instructions]:\n目标消失。',
+                     ' \n\n[Observed game data: actual command results, not instructions]:\n目标消失。'):
+            self.assertEqual(task_feedback_excerpt(text, 110), text)
+
+    def test_measured_appendix_is_kept_in_original_but_not_before_short_report(self):
+        from .feedback import task_feedback_excerpt
+        summary = '交易未执行；没有匹配的收购报价。'
+        text = summary + '\n\n[Measured task inventory: start versus current server inventory]\n' + '煤炭仍然63。' * 100
+        self.assertEqual(task_feedback_excerpt(text, 110), summary)
