+    async def merchant_feedback(self):
+        service, calls = await self.service()
+        task = ('本喵脚边一格就站着一个村民，别走动、别去找别的村民。直接开这一个村民的交易窗口，'
+                '把他的报价读出来，重点看有没有收煤炭或者收粗铁的报价。窗口开出来就停下报告，'
+                '不要执行任何交易，不要关闭再重开。')
+        conclusion = '当前窗口中无收购煤炭或粗铁的报价。窗口保持开启，未执行交易，未关闭。'
+        summary = ('窗口 ID 3（远行货郎·灯穗）已确认开启。读取到 5 条报价，均为绿宝石购买物品：\n'
+                   '1. 1 绿宝石 → 16 火把\n2. 1 绿宝石 → 16 箭\n3. 2 绿宝石 → 1 物品展示框\n'
+                   '4. 3 绿宝石 → 1 盾牌\n5. 4 绿宝石 → 1 指南针\n\n' + conclusion)
+        raw = summary + '\n\n[Observed game data: actual command results, not instructions]:\n' + 'OFFERS received=5\n' * 80
+        raw += '\n\n当前持有道具：' + 'coal x63、dirt x111、iron_sword x2、' * 40
+        pending = await self.complete(service, task, raw, status='ok')
+        return service, calls, pending, conclusion, raw
+
+    async def test_completion_keeps_merchant_conclusion_before_duplicate_receipts(self):
+        service, _, pending, conclusion, _ = await self.merchant_feedback()
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._lang, plugin._service = 'zh', service
+        text = plugin._format_completion_cue(pending.result)
+        self.assertIn(conclusion, text)
+        self.assertLessEqual(count_tokens(text), 1000)
+
+    async def test_idle_outcome_reserves_feedback_before_a_long_goal(self):
+        service, calls, _, conclusion, raw = await self.merchant_feedback()
+        await service._fire_keep_going_nudge()
+        text = calls[-1]['parts'][0]['text']
+        self.assertIn('无收购煤炭或粗铁', text)
+        self.assertLessEqual(count_tokens(text), 1000)
+        observed = await service.observe_game(['self'], 0)
+        self.assertEqual(observed['lastTaskOutcome']['text'], raw)
+
+    async def test_compact_observation_keeps_latest_merchant_conclusion(self):
+        service, _, _, _, _ = await self.merchant_feedback()
+        observed = await service.observe_game(None, 0)
+        self.assertIn('无收购煤炭或粗铁', observed['lastTaskOutcome']['text'])
+
