         steps = detail.get('steps')
         for step in steps[:64] if isinstance(steps, list) else []:
             if (not isinstance(step, dict) or type(step.get('index')) is not int or
@@ -80,6 +82,20 @@ def received_play_routes(welcome, inventory, server=None, now=None):
                              for key in ('index', 'title', 'description', 'goal', 'target', 'site')
                              if isinstance((child := step.get(key)), str) or type(child) is int}
             break
+        if kind == 'MC_MARKET_CHECK':
+            evidence = detail.get('evidence')
+            evidence = evidence if isinstance(evidence, dict) else {}
+            focus['step'] = {key: child[:112] if isinstance(child, str) else child
+                             for key in ('goal', 'target')
+                             if isinstance((child := evidence.get(key)), str) or type(child) is int}
+            if type(detail.get('progress')) is int:
+                focus['step']['progress'] = detail['progress']
