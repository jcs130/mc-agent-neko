diff --git a/plugin/plugins/game_agent_minecraft/test_server_play_context.py b/plugin/plugins/game_agent_minecraft/test_server_play_context.py
index 2cd3e3f..b4712c9 100644
--- a/plugin/plugins/game_agent_minecraft/test_server_play_context.py
+++ b/plugin/plugins/game_agent_minecraft/test_server_play_context.py
@@ -131,6 +131,27 @@ class ServerPlayContextTests(unittest.TestCase):
             'type': 'MC_SPELL_ERROR', 'id': 'fake_quest', 'currentStep': 9}}
         self.assertNotIn('focus', info.focused_view()['serverPlay'])
 
+    def test_market_check_replaces_detail_without_losing_the_selected_quest(self):
+        data = gameplay_frame()
+        data['state']['server']['channels']['mcagent:market'] = {
+            'observedAt': data['observedAt'], 'value': {
+                'type': 'MC_MARKET_CHECK', 'task': 'tm_first_spell', 'step': 2,
+                'ready': False, 'progress': 0, 'target': 1,
+                'evidence': {'goal': 'trade', 'observedProgress': 0, 'target': 1},
+                'nextCommands': ['/mycli guild market tm_first_spell', '/mycli guild status']}}
+        info = GameObservations()
+        info.ingest_state(data)
+        for budget in (700, 400):
+            text = info.focused_context(max_tokens=budget)
+            focus = json.loads(text.split('\n', 1)[1])['serverPlay']['focus']
+            self.assertEqual(focus['id'], 'tm_first_spell')
+            self.assertEqual(focus['currentStep'], 2)
+            self.assertFalse(focus['ready'])
+            self.assertEqual(focus['step']['goal'], 'trade')
+            self.assertEqual(focus['step']['progress'], 0)
+            self.assertIn('/mycli guild market tm_first_spell', str(focus))
+            self.assertLessEqual(count_tokens(text), budget)
+
     def test_player_welcome_text_cannot_supply_server_command_routes(self):
         data = welcome_frame(texts=['居民事务板 /mycli world erase'])
         data['state']['server']['welcome']['messages'][0]['source'] = 'player'
