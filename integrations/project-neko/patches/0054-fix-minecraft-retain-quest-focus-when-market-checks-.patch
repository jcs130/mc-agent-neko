+            if isinstance(commands, list):
+                focus['nextCommands'] = [cmd for cmd in commands if isinstance(cmd, str) and
+                    cmd.startswith('/mycli ') and len(cmd) <= 200 and not any(ord(c) < 32 for c in cmd)][:2]
         stamp = packet.get('observedAt')
         if (type(stamp) in (int, float) and math.isfinite(stamp) and
                 type(now) in (int, float) and math.isfinite(now)):
@@ -104,6 +120,8 @@ def shorten_play_routes(play):
                 play['routes'][topic] = f'inventory:{page[1]}:{page[2]}'
     if play.get('focus'):
         focus = play['focus']
-        play['focus'] = {key: focus[key] for key in ('id', 'currentStep', 'ageSeconds') if key in focus}
