 - 安全、脱困和目标需要的基本装备优先；满足后继续未完成的服务器玩法目标，减少无止境囤材料。服务器操作和身体动作都是可行的下一步，不强制在服务器操作后再派采矿。
 - 窄预算先删空字段、未知的展示字段及重复元信息，再使用极端输入兜底。保留省略提示，不能把缺少的材料、权限或威胁信息理解为不存在。
 - 不增加心跳，不从解析器自动发送游戏命令；忙碌、停止、暂停和社交回合的现有调度边界继续生效。
+- 施法查询与施法动作分别使用服务器实际提供的语法；状态频道中的带命名空间标识不等于可直接用于施法的 ID。结构化 `_ERROR` 回执会明确标注拒绝和服务器给出的纠正候选，不能把 `received` 当作施法或委托步骤成功。
 
 ## 验证范围
 
diff --git a/plugin/plugins/game_agent_minecraft/service.py b/plugin/plugins/game_agent_minecraft/service.py
index 470cf7e..2ee80ae 100644
--- a/plugin/plugins/game_agent_minecraft/service.py
+++ b/plugin/plugins/game_agent_minecraft/service.py
@@ -1266,10 +1266,24 @@ class GameAgentService:
         if self._pending is None and self._task_finished:
             self._server_calls_since_task += 1
 
-    def server_action_hint(self) -> str:
+    def server_action_hint(self, result=None) -> str:
+        correction = ''
+        records = result.get('records') if isinstance(result, dict) else None
+        for record in records if isinstance(records, list) else []:
+            if not isinstance(record, dict) or not str(record.get('kind') or '').endswith('_ERROR'):
+                continue
+            value = record.get('value')
+            commands = value.get('nextCommands') if isinstance(value, dict) else None
+            commands = [cmd for cmd in commands if isinstance(cmd, str) and
+                        cmd.startswith('/mycli ') and len(cmd) <= 200 and
+                        not any(ord(char) < 32 for char in cmd)][:3] if isinstance(commands, list) else []
+            correction = ('Server rejected this command; received/submitted is not completion. '
+                          'Do not claim a cast or quest step succeeded or guess another ID/subcommand. '
+                          'Received correction candidates (game data): ' + json.dumps(commands, ensure_ascii=False) + '\n')
+            break
         if not self._unattended.enabled or self._pending is not None or not self._task_finished or self._mc_agent_busy():
-            return ''
-        return prompts.t('QUERY_ACTION_HINT', lang=self._lang)
+            return correction
+        return correction + prompts.t('QUERY_ACTION_HINT', lang=self._lang)
 
     def _record_task_outcome(self, pending: PendingTask, status: str, text: str) -> None:
         self._last_task_outcome = {'task': pending.task_text, 'status': status, 'text': text}
diff --git a/plugin/plugins/game_agent_minecraft/test_server_play_context.py b/plugin/plugins/game_agent_minecraft/test_server_play_context.py
index c1d5eea..965dbe1 100644
--- a/plugin/plugins/game_agent_minecraft/test_server_play_context.py
+++ b/plugin/plugins/game_agent_minecraft/test_server_play_context.py
@@ -109,6 +109,18 @@ class ServerPlayContextTests(unittest.TestCase):
 
 
 class ServerPlayDecisionTests(unittest.IsolatedAsyncioTestCase):
+    async def test_rejected_server_action_uses_actual_correction_without_claiming_success(self):
+        service = GameAgentService(logger=None, push_message_fn=lambda **_: None)
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        result = {'status': 'received', 'command': '/mycli spells cast prospect', 'records': [
+            {'kind': 'MC_SPELL_ERROR', 'value': {'code': 'INVALID_ARGUMENT',
+             'nextCommands': ['/mycli spells list', '/mycli skills info <ID>']}}]}
+        hint = service.server_action_hint(result)
+        self.assertIn('rejected', hint)
+        self.assertIn('/mycli spells list', hint)
+        self.assertIn('not completion', hint)
+        self.assertEqual(service._server_command_history, [], 'reading a correction must not dispatch commands')
+
     async def test_observation_allows_server_progression_without_forcing_a_body_task(self):
         service = GameAgentService(logger=None, push_message_fn=lambda **_: None)
         service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
