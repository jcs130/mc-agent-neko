+def _gameplay_excerpts(welcome, own, protection):
+    """Received guide excerpts, selected without another model invocation.
+
+    Passive read callbacks are not delivered in autonomous model turns, so
+    critical reference facts must also travel with the relevant decision.
+    """
+    messages = welcome.get('messages') or []
+    low_health = type(own.get('health')) in (int, float) and own['health'] <= 10
+    blocked = bool(protection.get('lastBlocked'))
+    candidates = []
+    for index, item in enumerate(messages):
+        if not isinstance(item, dict) or item.get('source') != 'server':
+            continue
+        text = str(item.get('text') or '')
+        if not re.search(r'/mycli|技能|职业|保护|领地|倒地|复活|传送|skill|protect|reviv|rescue', text, re.I):
+            continue
+        score = (3 if low_health and re.search(r'倒地|复活|救援|reviv|rescue', text, re.I) else 0)
+        score += 2 if blocked and re.search(r'保护|领地|protect', text, re.I) else 0
+        candidates.append((-score, index, text))
+    candidates.sort()
+    if not candidates:
+        return None
+    chosen = candidates[:3]
+    return {'source': 'received_server_welcome',
+            'receivedExcerpts': [text[:100] for _, _, text in chosen],
+            'partial': len(candidates) > len(chosen) or any(len(text) > 100 for _, _, text in chosen),
+            'details': 'minecraft_observe(sections=["server"],max_events=0)'}
+
+
