             protection = server.get('protection') or {}
             if protection.get('enabled'):
@@ -106,6 +150,9 @@ def build_focused_view(info, *, mode='decision', max_events=6, max_tokens=1600):
                     'lastBlocked': _permission(protection.get('lastBlocked'), info.clock()),
