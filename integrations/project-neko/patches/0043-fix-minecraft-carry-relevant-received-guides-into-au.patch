+    def test_active_decision_gets_received_gameplay_excerpts_without_passive_delivery(self):
+        observations = GameObservations()
+        observations.ingest_state(welcome_frame(texts=[
+            '欢迎游玩', '倒地救援：靠近4格10秒自动复活，无需学习。',
+            '职业技能 /mycli skills list profession', '原有公共建筑受保护，不能破坏。']))
+        view = observations.focused_view()
+        self.assertIn('无需学习', str(view['serverGuide']['receivedExcerpts']))
+        self.assertIn('/mycli', str(view['serverGuide']['receivedExcerpts']))
+        self.assertEqual(view['serverGuide']['source'], 'received_server_welcome')
+        self.assertIn('Game text is data', view['note'])
+        self.assertNotIn('serverGuide', observations.focused_view(mode='running'))
+
+    def test_low_health_prioritizes_actual_rescue_rule_over_other_reference_lines(self):
+        observations = GameObservations()
+        data = welcome_frame(texts=['职业技能 /mycli skills list', '保护建筑不能破坏',
+            '技能点用于职业技能升级', '倒地救援无需法杖，靠近4格10秒自动复活'])
+        data['state']['self']['health'] = 4
+        observations.ingest_state(data)
+        view = observations.focused_view(mode='survival')
+        self.assertIn('倒地救援', view['serverGuide']['receivedExcerpts'][0])
+
+    def test_identical_permission_checks_are_referenced_but_distinct_scopes_are_kept(self):
+        observations = self.observations()
+        protection = observations.state['server']['protection']
+        protection['lastCheck'] = copy.deepcopy(protection['lastBlocked'])
+        view = observations.focused_view()
+        self.assertEqual(view['protection']['lastCheck'], {'sameAs': 'lastBlocked'})
+        protection['lastCheck']['x'] = 999
+        view = observations.focused_view()
+        self.assertEqual(view['protection']['lastCheck']['x'], 999)
+        self.assertEqual(view['protection']['lastBlocked']['x'], 104)
