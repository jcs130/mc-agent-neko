@@ -0,0 +1,84 @@
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from .evidence import GameEvidence, decision_input
+from .observations import GameObservations
+
+
+class GameEvidenceTest(unittest.TestCase):
+    def observations(self):
+        info = GameObservations(clock=lambda: 20)
+        frame = {'schemaVersion': 1, 'sessionId': 'evidence-test', 'seq': 1,
+                 'observedAt': 20000, 'online': True, 'state': {
+            'self': {'health': 20, 'food': 18}, 'inventory': {'counts': {'iron_ingot': 2},
+                'slots': [{'slot': 10, 'name': 'written_book', 'customName': '完整玩法',
+                           'lore': ['全文' * 1000], 'book': {'pages': [{'text': '中间条件' * 2000}]},
+                           'components': [{'raw': '冗长协议' * 2000}]}]},
+            'server': {'advancements': {'entries': {'recipes': 'raw' * 10000}},
+                       'channels': {'mcagent:state': {'value': {'mana': {'current': 28},
+                           'abilities': [{'id': 'escape', 'name': '闪现', 'cost': 10}]}},
+                           'mcagent:ysm_asset': {'value': {'data': 'binary' * 10000}}}}},
+            'recentEvents': [
+                {'id': 'player', 'kind': 'whisper', 'observedAt': 20000,
+                 'player': 'RealPlayer', 'text': '来拿装备' * 1000},
+                {'id': 'protocol', 'kind': 'plugin_message', 'observedAt': 20000,
+                 'text': '', 'data': {'channel': 'mcagent:state', 'raw': 'repeat' * 10000}}]}
+        self.assertTrue(info.ingest_state(frame))
+        return info
+
+    def test_no_text_clip_and_exact_protocol_book_retrieval(self):
+        info = self.observations()
+        before = json.dumps(info.view(), sort_keys=True)
+        value = decision_input(info)
+        ident = value['rawEvidence']['id']
+        self.assertEqual(info.evidence.read(ident, '/recentEvents/0/text')['value'], '来拿装备' * 1000)
+        self.assertEqual(value['eventIndex'][0]['player'], 'RealPlayer')
+        self.assertEqual(value['state']['inventory']['slots'][0]['lore'], ['全文' * 1000])
+        self.assertEqual(value['serverSkills']['abilities'][0]['name'], '闪现')
+        result = info.evidence.read(ident, '/state/inventory/slots/0/book/pages/0/text')
+        self.assertEqual(result['value'], '中间条件' * 2000)
+        self.assertFalse(result['responseTruncated'])
+        self.assertEqual(info.evidence.read(ident, '/recentEvents/1/data')['value']['raw'], 'repeat' * 10000)
+        self.assertEqual(json.dumps(info.view(), sort_keys=True), before)
+
+    def test_immutable_disk_snapshot_survives_instance_and_connection_change(self):
+        with tempfile.TemporaryDirectory() as root:
+            original = {'text': '甲' * 10000, 'nested': {'a/b': {'~': [1, 2, 3]}}}
+            archive = GameEvidence(root)
+            ident = archive.save(original)['id']
+            original['text'] = 'changed'
+            reread = GameEvidence(root)
+            self.assertEqual(reread.read(ident, '/text')['value'], '甲' * 10000)
+            self.assertEqual(reread.read(ident, '/nested/a~1b/~0')['value'], [1, 2, 3])
+            self.assertEqual(len(list(Path(root).glob('*.json'))), 1)
+            self.assertEqual(reread.read('../../secrets')['status'], 'unavailable')
+            archive.append_events('session', [{'text': '完整玩家消息' * 2000}])
+            record = json.loads((Path(root) / 'received-events.jsonl').read_text(encoding='utf8'))
+            self.assertEqual(record['events'][0]['text'], '完整玩家消息' * 2000)
+
+    def test_explicit_pages_are_lossless_and_not_implicitly_limited(self):
+        archive = GameEvidence()
+        text = '完整原文' * 1000
+        ident = archive.save({'text': text})['id']
+        self.assertEqual(archive.read(ident, '/text')['value'], text)
+        parts = []
+        offset = 0
+        while offset is not None:
+            result = archive.read(ident, '/text', offset, 123)
+            parts.append(result['value'])
+            offset = result['nextOffset']
+        self.assertEqual(''.join(parts), text)
+        self.assertEqual(archive.read(ident, '/text', 0, 0)['status'], 'unavailable')
+
+    def test_passive_index_does_not_duplicate_all_raw_state(self):
+        info = self.observations()
+        index = decision_input(info, mode='running')
+        self.assertNotIn('state', index)
+        self.assertIn('server', index['sections'])
+        self.assertEqual(info.evidence.read(index['rawEvidence']['id'], '/state/self')['value']['health'], 20)
+
+
+if __name__ == '__main__':
+    unittest.main()
