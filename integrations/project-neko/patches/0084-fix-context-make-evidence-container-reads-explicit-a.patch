         name='minecraft_observe',
-        description='Read current Minecraft facts without changing the action. Summary returns current activity/resources/skills and exact section indexes, so full state already supplied to this decision is not duplicated. Use evidence_id plus reference_path to read the specific missing field or entity, or detail=full with explicit sections for raw state. All text and quotes remain complete in the immutable evidence; no automatic clipping. Missing/stale data is unknown. Act on reliable results and avoid repeating unchanged inspections.',
+        description='Read current Minecraft facts without changing the action. Summary returns current activity/resources/skills and exact section indexes. For evidence_id, summary describes a dict/list with exact child paths; scalar/text leaves return whole. Read a specific missing field, quote or nativeFeedbackSections/conclusion first. Whole server/state containers include large assets/history: use detail=full only for an intentional complete container, or explicit offset/limit for a long text/list. All original text and quotes remain complete; no automatic clipping. Missing/stale data is unknown. Act on reliable results and avoid repeating unchanged inspections.',
         parameters={
             'type': 'object',
             'properties': {
@@ -488,8 +488,13 @@ class GameAgentMinecraftPlugin(NekoPluginBase):
         timeout=6.0,
     )
     async def minecraft_observe(self, *, sections=None, max_events=None, detail='summary', reference_cursor=None, reference_path=None, evidence_id=None, offset=None, limit=None, **_):
+        if detail not in ('summary', 'full'):
+            return {'status': 'failed', 'reason': 'detail must be summary or full'}
