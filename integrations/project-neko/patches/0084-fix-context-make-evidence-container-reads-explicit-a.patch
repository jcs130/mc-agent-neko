diff --git a/plugin/plugins/game_agent_minecraft/service.py b/plugin/plugins/game_agent_minecraft/service.py
index 5a31d92..f1e0256 100644
--- a/plugin/plugins/game_agent_minecraft/service.py
+++ b/plugin/plugins/game_agent_minecraft/service.py
@@ -1052,7 +1052,10 @@ class GameAgentService:
                 event_map = self._attention_events()
                 events = [event_map[ident] for ident in self._game_attention_ids if ident in event_map] if attention else []
                 social = bool(events) and all(event.get('kind') in ('chat', 'whisper', 'item_pickup') for event in events)
-                mode = 'social' if social else 'running' if not attention or self._game_execution_busy() else 'decision'
+                # Feedback owns interpretation; the separately scheduled idle
+                # decision owns the complete planning view. Combining both
+                # views in one delivered batch duplicated every state section.
+                mode = 'social' if social else 'running'
                 context = self._game_observations.focused_context(mode=mode)
                 if not context:
                     return
diff --git a/plugin/plugins/game_agent_minecraft/test_game_evidence.py b/plugin/plugins/game_agent_minecraft/test_game_evidence.py
index a4089de..1b42788 100644
--- a/plugin/plugins/game_agent_minecraft/test_game_evidence.py
+++ b/plugin/plugins/game_agent_minecraft/test_game_evidence.py
@@ -186,6 +186,39 @@ class GameEvidenceTest(unittest.TestCase):
         self.assertEqual(archive.read(ident, '/commandResultsWithMarker')['value'], marker + appendix)
         self.assertNotIn(appendix, json.dumps(index, ensure_ascii=False))
 
+    def test_default_container_index_cannot_accidentally_return_the_entire_archive(self):
+        archive = GameEvidence()
+        full = {'state': {'server': {'assets': '完整协议' * 100000}},
+                'events': [{'text': '第' + str(index)} for index in range(3000)]}
+        ident = archive.save(full)['id']
+        root = archive.describe(ident)
+        self.assertTrue(root['valueIsIndex'])
+        self.assertNotIn('value', root)
+        self.assertEqual(root['fields']['state']['path'], '/state')
+        entries = archive.describe(ident, '/events')
+        self.assertEqual(entries['entries'], 3000)
+        self.assertEqual(entries['elementPath'], '/events/<index>')
+        self.assertEqual(archive.describe(ident, '/events/2999/text')['value'], '第2999')
+        self.assertEqual(archive.read(ident)['value'], full)
+
+
+class EvidenceToolQueryTest(unittest.IsolatedAsyncioTestCase):
+    async def test_default_root_is_an_index_and_explicit_full_field_is_exact(self):
+        from . import GameAgentMinecraftPlugin
+        from .service import GameAgentService
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._service = GameAgentService(logger=None, push_message_fn=lambda **_: None)
+        raw = {'server': {'assets': '完整协议' * 100000}, 'feedback': '实际失败原因' * 5000}
+        archive = plugin._service._game_observations.evidence
+        ident = archive.save(raw)['id']
+        result = await plugin.minecraft_observe(evidence_id=ident)
+        self.assertTrue(result['valueIsIndex'])
+        self.assertNotIn('value', result)
+        exact = await plugin.minecraft_observe(evidence_id=ident, reference_path='/feedback')
+        self.assertEqual(exact['value'], raw['feedback'])
+        whole = await plugin.minecraft_observe(evidence_id=ident, detail='full')
+        self.assertEqual(whole['value'], raw)
+
 
 if __name__ == '__main__':
     unittest.main()
