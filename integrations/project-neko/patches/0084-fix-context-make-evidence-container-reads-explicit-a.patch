diff --git a/plugin/plugins/game_agent_minecraft/evidence.py b/plugin/plugins/game_agent_minecraft/evidence.py
index 19fe950..9ca1f8d 100644
--- a/plugin/plugins/game_agent_minecraft/evidence.py
+++ b/plugin/plugins/game_agent_minecraft/evidence.py
@@ -73,6 +73,24 @@ class GameEvidence:
             return {'status': 'unavailable', 'reason': type(error).__name__,
                     'instruction': 'Evidence/path unavailable; do not infer missing facts.'}
 
+    def describe(self, ident, path='/'):
+        """Describe a requested container; exact leaves and explicit full reads stay whole."""
+        result = self.read(ident, path)
+        if result.get('status') != 'ok' or not isinstance(result.get('value'), (dict, list)):
+            return result
+        value = result.pop('value')
+        result.update(detail='index', valueIsIndex=True,
+            instruction='Container index, not its original body. Query an exact child path; scalar/text leaves return whole. Use detail="full" for an intentional complete container, or explicit offset/limit for list/text pages. The original is retained without clipping.')
+        base = '' if path == '/' else path
+        if isinstance(value, dict):
+            result['fields'] = {key: {'path': pointer(base, key), 'kind': type(child).__name__,
+                **({'entries': len(child)} if isinstance(child, (dict, list, str)) else {'value': child})}
+                for key, child in value.items()}
+        else:
+            result.update(kind='list', entries=len(value), elementPath=base + '/<index>',
+                          firstIndex=0 if value else None, lastIndex=len(value)-1 if value else None)
+        return result
+
 
 def pointer(path, key):
     return path + '/' + str(key).replace('~', '~0').replace('/', '~1')
