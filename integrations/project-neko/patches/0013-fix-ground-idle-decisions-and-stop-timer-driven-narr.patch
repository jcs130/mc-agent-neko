diff --git a/plugin/plugins/game_agent_minecraft/test_idle_decisions.py b/plugin/plugins/game_agent_minecraft/test_idle_decisions.py
new file mode 100644
index 0000000..06d76f0
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_idle_decisions.py
@@ -0,0 +1,87 @@
+import asyncio
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from plugin.plugins.game_agent_minecraft.service import GameAgentService
+
+
+class IdleDecisionTests(unittest.IsolatedAsyncioTestCase):
+    def service(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.set_lang('zh')
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI',
+                           'system_prompt_interval_seconds': 10.0})
+        return service, calls
+
+    async def test_each_idle_decision_has_inventory_and_last_failure(self):
+        service, calls = self.service()
+        pending = await service.try_claim_pending('制作熔炉', overwrite=False)
+        await service._on_task_finished({
+            'type': 'task_finished', 'task_id': pending.task_id, 'status': 'failed',
+            'text': 'Crafting furnace needs a reachable crafting table.',
+            'inventory': {'oak_planks': 21, 'cobblestone': 461},
+        })
+        await service._fire_keep_going_nudge()
+        await service._fire_keep_going_nudge()
+        for call in calls:
+            text = call['parts'][-1]['text']
+            self.assertIn('oak_planks×21', text)
+            self.assertIn('reachable crafting table', text)
+            self.assertIn('制作熔炉', text)
+
+    async def test_timer_alone_does_not_request_spoken_progress(self):
+        service, calls = self.service()
+        service._pending = SimpleNamespace(task_text='挖竖井找铁', start_time=1000.0)
+        await service._fire_in_progress_nudge()
+        self.assertFalse(any(c['ai_behavior'] == 'respond' for c in calls))
+
+    async def test_unchanged_idle_does_not_wake_dialogue_every_ten_seconds(self):
+        service, calls = self.service()
+        clock = [1000.0]
+        service._last_task_finished_at = clock[0]
+
+        async def step(_):
+            clock[0] += 0.5
+            if clock[0] > 1025:
+                raise asyncio.CancelledError
+
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.asyncio.sleep', step), patch(module + '.time.time', lambda: clock[0]):
+            await service._system_prompt_loop()
+        self.assertEqual(len([c for c in calls if c['ai_behavior'] == 'respond']), 1)
+
+    async def test_new_inventory_resets_retry_backoff(self):
+        service, calls = self.service()
+        clock = [1000.0]
+        service._last_task_finished_at = clock[0]
+
+        async def step(_):
+            clock[0] += 0.5
+            if clock[0] == 1012:
+                service._last_inventory = {'iron_ingot': 3}
+                service._last_inventory_at = clock[0]
+            if clock[0] > 1025:
+                raise asyncio.CancelledError
+
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.asyncio.sleep', step), patch(module + '.time.time', lambda: clock[0]):
+            await service._system_prompt_loop()
+        self.assertEqual(len([c for c in calls if c['ai_behavior'] == 'respond']), 2)
+        self.assertIn('iron_ingot×3', calls[-1]['parts'][-1]['text'])
+
+    async def test_foreign_completion_does_not_replace_the_last_accepted_outcome(self):
+        service, calls = self.service()
+        pending = await service.try_claim_pending('制作熔炉', overwrite=False)
+        await service._on_task_finished({'task_id': pending.task_id, 'status': 'failed',
+                                         'text': 'No reachable crafting table.'})
+        await service._on_task_finished({'task_id': 'old-foreign-task', 'status': 'ok',
+                                         'text': 'Iron pickaxe ready.'})
+        await service._fire_keep_going_nudge()
+        self.assertIn('No reachable crafting table', calls[-1]['parts'][-1]['text'])
+        self.assertNotIn('Iron pickaxe ready', calls[-1]['parts'][-1]['text'])
+
+
+if __name__ == '__main__':
+    unittest.main()
