+import copy
+import json
+import unittest
+
+from utils.tokenize import count_tokens
+
+from .observations import GameObservations
+from .test_observations import frame
+
+
+def crowded_frame(seq=1, session='resources-fixture'):
+    data = frame(seq=seq, session=session)
+    data['state']['inventory'] = {
+        'counts': {**{f'irrelevant_item_{n}': 64 for n in range(24)},
+                   'raw_iron': 6, 'coal': 95, 'stick': 4, 'blaze_rod': 1},
+        'slots': [{'slot': 34, 'name': 'blaze_rod', 'count': 1,
+                   'customName': '灵纹法杖', 'lore': ['手持使用：立即施放']}],
+    }
+    data['state']['server']['protection'] = {'enabled': True, 'installed': True}
+    data['state']['nearby'] = {'under': {'name': 'deepslate'}, 'feet': {'name': 'air'},
+                              'head': {'name': 'deepslate'}, 'onlinePlayers': ['RealFriend']}
+    return data
+
+
+class OperationalInventoryTests(unittest.TestCase):
+    def summary(self, data, budget=400):
+        observations = GameObservations()
+        observations.ingest_state(data)
+        result = observations.context(max_tokens=budget)
+        self.assertLessEqual(count_tokens(result), budget)
+        return json.loads(result.split('\n', 1)[1])
+
+    def test_crowded_compact_decision_preserves_absent_tools_and_named_items(self):
+        result = self.summary(crowded_frame())
+        resources = result.get('resources', {})
+        self.assertEqual(resources.get('pickaxes'), [])
+        self.assertEqual(resources.get('stations'), {'crafting_table': 0, 'furnace': 0})
+        self.assertEqual(resources.get('iron'), {'raw': 6, 'ingots': 0})
+        self.assertEqual(resources.get('sticks'), 4)
+        self.assertIn({'slot': 34, 'id': 'blaze_rod', 'name': '灵纹法杖'}, resources.get('named', []))
+        self.assertEqual(result['collision']['head'], 'deepslate')
+        self.assertTrue(result['protection']['automaticDigChecks'])
+
+    def test_late_tool_and_crafting_supplies_are_not_lost_to_inventory_order(self):
+        data = crowded_frame()
+        inventory = data['state']['inventory']
+        inventory['counts'].update({'stone_pickaxe': 1, 'spruce_log': 2, 'oak_planks': 4,
+                                    'crafting_table': 1, 'furnace': 1})
+        inventory['slots'].append({'slot': 44, 'name': 'stone_pickaxe', 'count': 1,
+                                   'durabilityUsed': 130, 'maxDurability': 131})
+        resources = self.summary(data, 500).get('resources', {})
+        self.assertIn({'id': 'stone_pickaxe', 'count': 1, 'remaining': 1}, resources.get('pickaxes', []))
+        self.assertEqual(resources.get('wood'), {'spruce_log': 2, 'oak_planks': 4})
+        self.assertEqual(resources.get('stations'), {'crafting_table': 1, 'furnace': 1})
+
+    def test_inconsistent_durability_is_not_reported_as_a_remaining_lifetime(self):
+        data = crowded_frame()
+        data['state']['inventory']['counts']['iron_pickaxe'] = 1
+        data['state']['inventory']['slots'].append({'slot': 44, 'name': 'iron_pickaxe', 'count': 1,
+            'durabilityUsed': 999, 'maxDurability': 250, 'durabilityInconsistent': True})
+        picks = self.summary(data, 500).get('resources', {}).get('pickaxes', [])
+        self.assertEqual(picks, [{'id': 'iron_pickaxe', 'count': 1, 'condition': 'inconsistent'}])
+
+    def test_missing_or_stale_inventory_does_not_assert_that_supplies_are_absent(self):
+        data = crowded_frame()
+        data['state']['inventory'] = {}
+        result = self.summary(data)
+        self.assertNotIn('resources', result)
+
+    def test_truncated_counts_do_not_turn_unreceived_supplies_into_zero(self):
+        data = crowded_frame()
+        data['truncated'] = ['$.inventory.counts']
+        resources = self.summary(data, 500)['resources']
+        self.assertTrue(resources['countsIncomplete'])
+        self.assertEqual(resources['stations'], {'crafting_table': None, 'furnace': None})
+        data = crowded_frame()
+        data['observedAt'] -= 60000
+        result = self.summary(data)
+        self.assertNotIn('resources', result)
+
+    def test_item_identity_change_is_meaningful_but_does_not_mutate_received_state(self):
+        observations = GameObservations()
+        data = crowded_frame()
+        observations.ingest_state(data)
+        revision = observations.decision_revision
+        data = copy.deepcopy(data)
+        data['seq'] += 1
+        data['state']['inventory']['slots'][0]['customName'] = '绑定新技能的法杖'
+        before = copy.deepcopy(data)
+        observations.ingest_state(data)
+        self.assertGreater(observations.decision_revision, revision)
+        observations.context(max_tokens=400)
+        self.assertEqual(data, before)
