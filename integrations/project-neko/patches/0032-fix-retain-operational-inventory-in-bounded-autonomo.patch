+    def operational_resources(self):
+        """Essential received supplies, independent of slot/count ordering."""
+        inventory = self.state.get('inventory') or {}
+        raw = inventory.get('counts')
+        if not self.fresh or not isinstance(raw, dict):
+            return None
+        counts = {key: value for key, value in raw.items()
+                  if isinstance(key, str) and type(value) is int and value > 0}
+        complete = not any(path in ('$.inventory', '$.inventory.counts') or
+                           path.startswith('$.inventory.counts.') for path in self.truncated)
+        slots = [item for item in inventory.get('slots') or [] if isinstance(item, dict)]
+        picks = []
+        for name, count in sorted(counts.items()):
+            if not name.endswith('_pickaxe'):
+                continue
+            pick = {'id': name[:64], 'count': count}
+            conditions = [item for item in slots if item.get('name') == name]
+            remaining, inconsistent = [], False
+            for item in conditions:
+                damage, maximum = item.get('durabilityUsed'), item.get('maxDurability')
+                if item.get('durabilityInconsistent'):
+                    inconsistent = True
+                elif type(damage) in (int, float) and type(maximum) in (int, float) and maximum > 0:
+                    if 0 <= damage <= maximum:
+                        remaining.append(maximum - damage)
+                    else:
+                        inconsistent = True
+            if inconsistent:
+                pick['condition'] = 'inconsistent'
+            elif remaining:
+                pick['remaining'] = min(remaining)
+            picks.append(pick)
+        named = [{'slot': item.get('slot'), 'id': str(item.get('name') or '')[:64],
+                  'name': str(item['customName'])[:48]}
+                 for item in slots if item.get('customName')]
+        absent = 0 if complete else None
+        wood = {name[:64]: count for name, count in counts.items()
+                if name.endswith(('_log', '_wood', '_stem', '_hyphae', '_planks'))
+                or name == 'bamboo_block'}
+        resources = {
+            'pickaxes': picks[:6],
+            'wood': dict(list(wood.items())[:6]),
+            'sticks': counts.get('stick', absent),
+            'stations': {name: counts.get(name, absent) for name in ('crafting_table', 'furnace')},
+            'iron': {'raw': counts.get('raw_iron', absent), 'ingots': counts.get('iron_ingot', absent)},
+            'named': named[:4],
+        }
+        if not complete:
+            resources['countsIncomplete'] = True
+        if len(named) > 4:
+            resources['namedOmitted'] = len(named) - 4
+        if len(wood) > 6:
+            resources['woodOmitted'] = len(wood) - 6
+        return resources
+
