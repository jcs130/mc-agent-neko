diff --git a/plugin/plugins/game_agent_minecraft/test_chat_policy.py b/plugin/plugins/game_agent_minecraft/test_chat_policy.py
new file mode 100644
index 0000000..d7f6ee0
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_chat_policy.py
@@ -0,0 +1,41 @@
+import unittest
+
+from . import prompts
+from .service import GameAgentService
+from .test_observations import event, frame
+
+
+class ChatPolicyTests(unittest.IsolatedAsyncioTestCase):
+    def service(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.set_lang('zh')
+        return service, calls
+
+    async def test_each_autonomous_decision_carries_player_communication_policy(self):
+        for fresh in (False, True):
+            service, calls = self.service()
+            service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+            if fresh:
+                service._game_observations.ingest_state(frame())
+            await service._fire_keep_going_nudge()
+            text = calls[-1]['parts'][0]['text']
+            self.assertIn(prompts.t('PLAYER_COMMUNICATION_POLICY', lang='zh'), text)
+            self.assertIn('私聊', text)
+            self.assertIn('本地', text)
+            from utils.tokenize import count_tokens
+            self.assertLessEqual(count_tokens(text), 1000)
+
+    async def test_private_message_judgment_keeps_the_sender_and_private_reply_policy(self):
+        service, calls = self.service()
+        await service._on_game_state(frame(recentEvents=[event('private:1', 'whisper', '想一起探索吗？', player='Friend_1')]))
+        reply = next(call for call in calls if call['ai_behavior'] == 'respond')
+        text = reply['parts'][0]['text']
+        self.assertIn('Friend_1', text)
+        self.assertIn(prompts.t('PLAYER_COMMUNICATION_POLICY', lang='zh'), text)
+
+    async def test_legacy_player_chat_also_receives_the_same_policy(self):
+        from .client import IngameChatMessage
+        service, calls = self.service()
+        await service._on_ingame_chat((IngameChatMessage(player='Friend_1', text='你好'),))
+        self.assertIn(prompts.t('PLAYER_COMMUNICATION_POLICY', lang='zh'), calls[-1]['parts'][0]['text'])
