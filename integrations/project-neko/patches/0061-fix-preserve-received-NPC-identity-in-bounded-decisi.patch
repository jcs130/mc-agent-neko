--- a/plugin/plugins/game_agent_minecraft/decision_context.py
+++ b/plugin/plugins/game_agent_minecraft/decision_context.py
@@ -28,6 +28,21 @@ def _select(value, keys):
     return {key: value[key] for key in keys if key in value} if isinstance(value, dict) else {}
 
 
+def _entity_summary(entity):
+    fact = {key: _short(entity[key], 48) if isinstance(entity[key], str) else entity[key]
+            for key in ('name', 'type', 'username', 'customName', 'distance') if key in entity}
+    # A profession or remembered coordinate is not this received NPC's identity.
+    if type(entity.get('id')) is int and entity['id'] >= 0:
+        fact['id'] = entity['id']
+    position = entity.get('position')
+    if isinstance(position, dict):
+        point = {key: round(position[key], 1) for key in ('x', 'y', 'z')
+                 if type(position.get(key)) in (int, float) and math.isfinite(position[key])}
+        if point:
+            fact['position'] = point
+    return fact
+
+
 def _merchant_summary(window, inventory=None, *, complete=False):
     if not isinstance(window, dict) or window.get('type') not in ('minecraft:merchant', 'minecraft:villager', 'merchant', 'villager'):
         return None
@@ -203,9 +218,11 @@ def build_focused_view(info, *, mode='decision', max_events=6, max_tokens=1600,
             entities = sorted((entity for entity in nearby.get('entities') or [] if isinstance(entity, dict)),
                 key=lambda item: item.get('distance') if type(item.get('distance')) in (int, float) else float('inf'))
             compact['nearby'] = {'players': players,
