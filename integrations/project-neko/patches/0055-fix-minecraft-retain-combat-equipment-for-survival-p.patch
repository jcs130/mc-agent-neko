index 0000000..cf84940
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_survival_equipment_context.py
@@ -0,0 +1,59 @@
+import unittest
+
+from utils.tokenize import count_tokens
+from .observations import GameObservations
+from .test_observations import frame
+
+
+class SurvivalEquipmentContextTests(unittest.TestCase):
+    def observations(self):
+        data = frame()
+        data['state']['self'].update(health=20, food=20,
+            equipment=[{'slot': 5, 'name': 'iron_helmet'}, {'slot': 6, 'name': 'chainmail_chestplate'}])
+        data['state']['inventory']['counts'] = {
+            **{f'decorative_item_{index}': 1 for index in range(40)},
+            'wooden_pickaxe': 1, 'iron_ingot': 14, 'stick': 22, 'crafting_table': 1, 'wheat': 2}
+        data['state']['nearby'] = {'entities': [{'name': 'zombie', 'distance': 4.7}]}
+        observations = GameObservations()
+        self.assertTrue(observations.ingest_state(data))
+        return observations
+
+    def test_crowded_unarmed_inventory_keeps_combat_gap_and_available_materials(self):
+        observations = self.observations()
+        view = observations.focused_view(mode='decision', max_tokens=700)
+        self.assertEqual(view['resources']['combat']['melee'], {})
+        self.assertEqual(view['resources']['combat']['shield'], 0)
+        self.assertEqual(view['resources']['combat']['wornArmor'], 2)
+        self.assertEqual(view['resources']['iron']['ingots'], 14)
+        self.assertEqual(view['resources']['sticks'], 22)
+        self.assertEqual(view['resources']['stations']['crafting_table'], 1)
+        self.assertNotIn('wheat', view['state']['inventory']['foodCounts'])
+        self.assertLessEqual(count_tokens(observations.focused_context(mode='decision', max_tokens=700)), 700)
+
+    def test_actual_weapons_and_offhand_shield_survive_emergency_projection(self):
+        observations = self.observations()
+        observations.state['inventory']['counts']['iron_sword'] = 1
+        observations.state['self']['offhand'] = {'name': 'shield', 'count': 1}
+        view = observations.focused_view(mode='survival', max_tokens=550, max_events=0)
+        self.assertEqual(view['resources']['combat']['melee'], {'iron_sword': 1})
+        self.assertEqual(view['resources']['combat']['shield'], 1)
+        self.assertLessEqual(count_tokens(observations.focused_context(mode='survival', max_tokens=550, max_events=0)), 550)
+
+    def test_partial_counts_do_not_assert_absent_weapons_or_shields(self):
+        observations = self.observations()
+        observations.truncated = ['$.inventory.counts']
+        resources = observations.operational_resources()
+        self.assertIsNone(resources['combat']['melee'])
+        self.assertIsNone(resources['combat']['shield'])
+        self.assertTrue(resources['countsIncomplete'])
+
+    def test_pickaxe_and_armor_are_not_reported_as_melee_weapons(self):
+        observations = self.observations()
+        counts = observations.state['inventory']['counts']
+        counts.update(diamond_pickaxe=1, iron_chestplate=1, stone_axe=1)
+        resources = observations.operational_resources()
+        self.assertEqual(resources['combat']['melee'], {'stone_axe': 1})
+
+    def test_running_projection_does_not_add_equipment_planning(self):
+        view = self.observations().focused_view(mode='running', max_tokens=350, max_events=0)
+        self.assertNotIn('resources', view)
