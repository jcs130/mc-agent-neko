index a696625..3dd4004 100644
--- a/plugin/plugins/game_agent_minecraft/observations.py
+++ b/plugin/plugins/game_agent_minecraft/observations.py
@@ -238,10 +238,26 @@ class GameObservations:
                   'name': str(item['customName'])[:48]}
                  for item in slots if item.get('customName')]
         absent = 0 if complete else None
+        melee = {name[:64]: count for name, count in sorted(counts.items())
+                 if name.endswith(('_sword', '_axe'))}
+        own = self.state.get('self') or {}
+        offhand = own.get('offhand') or {}
+        shield = counts.get('shield', absent)
+        if isinstance(offhand, dict) and offhand.get('name') == 'shield':
+            shield = max(shield or 0, 1)
+        combat = {'melee': dict(list(melee.items())[:4]) if melee or complete else None,
+                  'shield': shield}
+        if len(melee) > 4:
+            combat['meleeOmitted'] = len(melee) - 4
+        equipment = own.get('equipment')
+        if isinstance(equipment, list):
+            combat['wornArmor'] = sum(1 for item in equipment if isinstance(item, dict)
+                and str(item.get('name') or '').endswith(('_helmet', '_chestplate', '_leggings', '_boots')))
         wood = {name[:64]: count for name, count in counts.items()
                 if name.endswith(('_log', '_wood', '_stem', '_hyphae', '_planks'))
                 or name == 'bamboo_block'}
         resources = {
+            'combat': combat,
             'pickaxes': picks[:6],
             'wood': dict(list(wood.items())[:6]),
             'sticks': counts.get('stick', absent),
