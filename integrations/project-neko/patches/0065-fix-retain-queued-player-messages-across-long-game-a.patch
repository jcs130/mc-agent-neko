         self.assertLessEqual(count_tokens(text), 1000)
 
     async def test_public_chat_waits_for_idle_and_is_not_starved_by_a_long_action(self):
diff --git a/plugin/plugins/game_agent_minecraft/test_player_perception.py b/plugin/plugins/game_agent_minecraft/test_player_perception.py
index 637f33f..1bb676e 100644
--- a/plugin/plugins/game_agent_minecraft/test_player_perception.py
+++ b/plugin/plugins/game_agent_minecraft/test_player_perception.py
@@ -32,6 +32,8 @@ class PlayerPerceptionTests(unittest.IsolatedAsyncioTestCase):
         cues = [call for call in calls if call['ai_behavior'] == 'respond']
         self.assertEqual(len(cues), 2)
         self.assertNotEqual(cues[0]['coalesce_key'], cues[1]['coalesce_key'])
+        self.assertGreaterEqual(cues[0]['metadata']['expires_in_s'], 300,
+                                'a long native task must not expire a real player cue at 45 seconds')
         self.assertEqual(len({service._pending.task_id}), 1)
 
     async def test_unsolicited_error_waits_with_full_evidence_until_idle(self):
@@ -119,3 +121,21 @@ class PlayerPerceptionTests(unittest.IsolatedAsyncioTestCase):
         cue = next(call for call in calls if call['ai_behavior'] == 'respond')
         self.assertLessEqual(count_tokens(cue['parts'][0]['text']), 1000)
         self.assertIn('do not invent who gave an item', cue['parts'][0]['text'])
+
+    async def test_full_directed_message_survives_long_work_and_ambient_event_pressure(self):
+        service, _ = self.service(busy=True)
+        stamp = time.time()
+        message = event('directed', 'whisper', '送你的铁镐放在门口箱子，别误会是地上的矿石。', player='Friend_1')
+        with patch('plugin.plugins.game_agent_minecraft.service.time.time', return_value=stamp):
+            await service._on_game_state(frame(recentEvents=[message]))
+            await service._on_game_events({**frame(), 'events': [
+                event(f'noise-{n}', 'actionbar', f'mana {n}') for n in range(64)]})
+            await service._on_game_events({**frame(), 'events': [
+                event(f'noise2-{n}', 'actionbar', f'mana {n + 64}') for n in range(64)]})
+        with patch('plugin.plugins.game_agent_minecraft.service.time.time', return_value=stamp + 180):
+            await service._on_game_state(frame(seq=2))
+            received = service._game_observations.view(max_events=48, include_retained=True)['recentEvents']
+            self.assertIn(message['text'], [event['text'] for event in received])
+        with patch('plugin.plugins.game_agent_minecraft.service.time.time', return_value=stamp + 301):
+            await service._on_game_state(frame(seq=3))
+            self.assertNotIn('directed', service._game_observations.events)
