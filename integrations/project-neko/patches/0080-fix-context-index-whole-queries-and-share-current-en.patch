@@ -78,6 +78,21 @@ def pointer(path, key):
     return path + '/' + str(key).replace('~', '~0').replace('/', '~1')
 
 
+def entity_table(entities):
+    """Share repeated column names without losing rows, values or key absence."""
+    if not isinstance(entities, list) or not entities or not all(isinstance(row, dict) for row in entities):
+        return entities
+    groups = {}
+    for index, entity in enumerate(entities):
+        columns = tuple(sorted(entity))
+        group = groups.setdefault(columns, {'columns': list(columns), 'rows': []})
+        group['rows'].append([index, *[entity[key] for key in columns]])
+    return {'encoding': 'columns_with_snapshot_index', 'entries': len(entities),
+            'rowFormat': 'First cell is the original snapshot array index; remaining cells match columns exactly. Groups preserve distinct key sets: missing keys are not null.',
+            'groups': list(groups.values()),
+            'detailsPath': '/state/nearby/entities'}
+
+
