diff --git a/plugin/plugins/game_agent_minecraft/test_game_evidence.py b/plugin/plugins/game_agent_minecraft/test_game_evidence.py
index d960d39..d706e3e 100644
--- a/plugin/plugins/game_agent_minecraft/test_game_evidence.py
+++ b/plugin/plugins/game_agent_minecraft/test_game_evidence.py
@@ -5,7 +5,7 @@ import unittest
 from types import SimpleNamespace
 from unittest.mock import patch
 
-from .evidence import GameEvidence, decision_input
+from .evidence import GameEvidence, decision_input, entity_table
 from .observations import GameObservations
 
 
@@ -124,6 +124,35 @@ class GameEvidenceTest(unittest.TestCase):
                 self.assertEqual(info.evidence.read(ident, '/lastServerCommands/0/messages/0')['value'], old)
                 self.assertEqual(info.evidence.read(ident, '/recentTaskOutcomes')['value'], extras['recentTaskOutcomes'])
 
+    def test_selected_query_indexes_complete_sections_instead_of_duplicate_state(self):
+        info = self.observations()
+        old = info.view()
+        view = decision_input(info, mode='running', sections=['inventory', 'server'], extra=old)
+        self.assertEqual(set(view['sectionIndex']), {'inventory', 'server'})
+        self.assertNotIn('inventory', view['state'])
+        self.assertNotIn('server', view['state'])
+        ident = view['rawEvidence']['id']
+        for section in ('inventory', 'server'):
+            value = info.evidence.read(ident, view['sectionIndex'][section]['path'])
+            self.assertEqual(value['value'], old['state'][section])
+        self.assertEqual(view['serverSkills']['abilities'][0]['name'], '闪现')
+
+    def test_entity_table_roundtrip_retains_all_rows_values_and_missing_vs_null(self):
+        entities = [{'id': index, 'name': 'zombie', 'position': {'x': index, 'y': 70, 'z': -4},
+                     'customName': '完整名称' * 100, 'health': 20} for index in range(300)]
+        entities += [{'id': 300, 'health': None}, {'id': 301}]
+        before = json.dumps(entities, ensure_ascii=False, sort_keys=True)
+        table = entity_table(entities)
+        recovered = [None] * table['entries']
+        for group in table['groups']:
+            for row in group['rows']:
+                recovered[row[0]] = dict(zip(group['columns'], row[1:]))
+        self.assertEqual(recovered, entities)
+        self.assertEqual(json.dumps(entities, ensure_ascii=False, sort_keys=True), before)
+        self.assertIsNone(recovered[300]['health'])
+        self.assertNotIn('health', recovered[301])
+        self.assertEqual(entity_table([None, {'id': 1}]), [None, {'id': 1}])
+
 
 if __name__ == '__main__':
     unittest.main()
