+    async def test_host_callback_cap_preserves_valid_summary_and_detail_lookup(self):
+        from utils.tokenize import count_tokens, truncate_to_tokens
+        info = GameObservations()
+        initial = frame()
+        initial['state']['nearby'] = {'entities': [{'name': 'zombie', 'metadata': ['x' * 8000] * 128}]}
+        initial['state']['coverage'] = {'source': 'own connection'}
+        initial['state']['inventory']['slots'] = [{'name': 'written_book', 'book': {'pageCount': 23, 'pages': [{'text': '技能说明' * 1000}]}}]
+        info.ingest_state(initial)
+        context = info.context()
+        self.assertLessEqual(count_tokens(context), 700)
+        host_text = truncate_to_tokens(context[:8000], 1000)
+        self.assertEqual(host_text, context)
+        summary = json.loads(host_text.split('\n', 1)[1])
+        self.assertEqual(set(summary['state']), {'self', 'world', 'inventory', 'activity', 'server', 'window', 'nearby', 'coverage'})
+        self.assertEqual(summary['state']['self']['health'], 20)
+        self.assertIn('minecraft_observe', host_text)
+
+    async def test_attention_message_fits_real_host_limit_and_retains_full_messages_for_query(self):
+        from utils.tokenize import count_tokens
+        service, calls = self.service()
+        initial = frame(recentEvents=[event('fixture:1', 'whisper', '求助说明' * 200, player='Friend_1')])
+        await service._on_game_state(initial)
+        text = calls[-1]['parts'][0]['text']
+        self.assertLessEqual(count_tokens(text), 1000)
+        self.assertIn('textTruncated', text)
+        self.assertIn('minecraft_observe', text)
+        self.assertEqual(service._game_observations.view()['recentEvents'][0]['text'], '求助说明' * 200)
+
+    async def test_full_decision_with_failure_and_retry_fits_host_limit(self):
+        from utils.tokenize import count_tokens, truncate_to_tokens
+        service, calls = self.service()
+        service._unattended.enabled = True
+        await service._on_game_state(frame())
+        service._last_task_outcome = {'task': '合成工具', 'status': 'failed', 'text': '缺少材料，请先采集木头。' * 200}
+        service._idle_decision_attempts = 2
+        await service._fire_keep_going_nudge()
+        cue = calls[-1]['parts'][0]['text']
+        self.assertLessEqual(count_tokens(cue), 1000)
+        self.assertEqual(truncate_to_tokens(cue[:8000], 1000), cue)
+        self.assertIn('failed', cue)
+        self.assertIn('缺少材料', cue)
+        self.assertIn('minecraft_observe', cue)
+        self.assertIn('coverage', cue)
+        result = await service.observe_game(['self'], max_events=0)
+        self.assertEqual(result['lastTaskOutcome']['text'], service._last_task_outcome['text'])
+
 
