+        held = inv.get('held') or {}
+        summary = {
+            'self': {key: own.get(key) for key in ('health', 'food', 'oxygen', 'position', 'effects')},
+            'world': {key: world.get(key) for key in ('version', 'dimension', 'timeOfDay', 'weather')},
+            'activity': bounded_value(state.get('activity'), 300)[0],
+            'inventory': {'counts': dict(list(counts.items())[:32]),
+                          'held': {key: held.get(key) for key in ('name', 'durabilityUsed', 'maxDurability', 'durabilityInconsistent')},
