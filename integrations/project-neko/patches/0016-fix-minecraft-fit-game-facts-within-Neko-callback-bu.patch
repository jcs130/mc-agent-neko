+                ('nearby', {'players': (nearby.get('onlinePlayers') or [])[:3], 'more': 'minecraft_observe'}),
+                ('window', {'id': window.get('id'), 'title': short(window.get('title'), 60)} if window else None),
+                ('self', {key: summary['self'][key] for key in ('health', 'food', 'oxygen', 'position')}),
+            ]
+            for section, reduced in reductions:
+                if count_tokens(render()) <= max_tokens:
+                    break
+                summary[section] = reduced
+            # Huge user-supplied labels must not defeat the final budget. Full
+            # data remains in the cache/tool, with no claim that this is complete.
+            for section in ('server', 'nearby', 'inventory', 'activity', 'window', 'coverage', 'world'):
