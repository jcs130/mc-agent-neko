+                       'tablist': {key: short(value, 160) for key, value in (server.get('tablist') or {}).items()},
+                       'commandCount': catalog.get('count'), 'commandNames': names,
+                       'channels': {key: bounded_value(value.get('value'), 300)[0] if isinstance(value, dict) else None
+                                    for key, value in list((server.get('channels') or {}).items())[:4]}},
+            'window': {'id': window.get('id'), 'title': short(window.get('title')),
+                       'items': [{'slot': item.get('slot'), 'name': item.get('name'), 'lore': item.get('lore')}
+                                 for item in (window.get('slots') or [])[:4] if isinstance(item, dict)]} if window else None,
+            'nearby': {'players': (nearby.get('onlinePlayers') or [])[:6],
+                       'entities': [{key: entity.get(key) for key in ('name', 'username', 'customName', 'distance')}
+                                    for entity in (nearby.get('entities') or [])[:3] if isinstance(entity, dict)],
+                       'under': (nearby.get('under') or {}).get('name')},
+            'coverage': {'sourceTruncated': bool(view['truncated']), 'droppedEvents': view['droppedEvents'],
