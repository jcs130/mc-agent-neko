+        server, nearby, window = (state.get(key) or {} for key in ('server', 'nearby', 'window'))
+        catalog = server.get('commandCatalog') or {}
+        names = short(catalog.get('namesText'), 8192)
+        if len(names) > 500:
+            import re
+            interesting = [name for name in names.split(', ') if re.search(r'skill|spell|magic|quest|party|guild|help|whisper|friend|mcagent', name, re.I)]
+            names = ', '.join(interesting[:12])
+        counts = inv.get('counts') or {}
+        books, lore = [], []
