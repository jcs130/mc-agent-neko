diff --git a/plugin/plugins/game_agent_minecraft/test_adaptive_heartbeat.py b/plugin/plugins/game_agent_minecraft/test_adaptive_heartbeat.py
index b6daafb..8888c2e 100644
--- a/plugin/plugins/game_agent_minecraft/test_adaptive_heartbeat.py
