@@ -126,6 +126,102 @@ class AdaptiveHeartbeatTests(unittest.IsolatedAsyncioTestCase):
                 revisions.append(info.decision_revision)
         self.assertEqual(revisions, [1, 1, 2, 3])
 
+    async def test_slow_idle_decision_lease_survives_ordinary_fresh_fact_changes(self):
+        clock = [1000.0]
+        service, calls = self.service(clock)
+        seq, held_state = [0], []
+
+        async def step(_):
+            clock[0] += .5
+            if clock[0] > 1042:
+                raise asyncio.CancelledError
+            if clock[0] % 2 == 0:
+                seq[0] += 1
+                data = self.frame(clock, seq[0])
+                data['state']['inventory']['counts']['iron_ingot'] = seq[0]
+                data['state']['self']['health'] = 16 if clock[0] < 1012 else 20
+                await service._on_game_state(data)
+            if clock[0] == 1035:
+                held_state.append((service._idle_decision_attempts, service._last_keep_going_nudge_at))
+
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]), patch(module + '.asyncio.sleep', step):
+            await service._system_prompt_loop()
+        wakes = [stamp - 1000 for stamp, call in calls if call['coalesce_key'] == 'mc_keep_going']
+        self.assertEqual(wakes, [10.0, 40.0], 'fresh facts must not enqueue planning over a slow decision')
+        self.assertEqual(held_state, [(1, 1010.0)], 'lease skips must not count as attempts or deliveries')
+
+    async def test_accepted_task_claim_clears_lease_and_next_completion_starts_promptly(self):
+        clock = [1000.0]
+        service, calls = self.service(clock)
+        pending = [None]
+
+        async def step(_):
+            clock[0] += .5
+            if clock[0] > 1032:
+                raise asyncio.CancelledError
+            if clock[0] % 2 == 0:
+                await service._on_game_state(self.frame(clock, int(clock[0])))
+            if clock[0] == 1015:
+                self.assertGreater(service._idle_decision_lease_until, clock[0])
+                pending[0] = await service.try_claim_pending('制作木镐', overwrite=False)
+                self.assertIsNotNone(pending[0])
+                self.assertEqual(service._idle_decision_lease_until, 0)
+            if clock[0] == 1016:
+                await service._on_task_finished({'task_id': pending[0].task_id, 'status': 'ok', 'text': '制作完成'})
+
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]), patch(module + '.asyncio.sleep', step):
+            await service._system_prompt_loop()
+        wakes = [stamp - 1000 for stamp, call in calls if call['coalesce_key'] == 'mc_keep_going']
+        self.assertEqual(wakes, [10.0, 26.0], 'a new completion must not inherit the old planning lease')
+
+    async def test_private_chat_and_new_danger_bypass_idle_decision_lease(self):
+        clock = [1000.0]
+        service, calls = self.service(clock)
+        data = self.frame(clock, 2)
+        data['recentEvents'] = [{'id': 'urgent-private', 'kind': 'whisper', 'player': 'Friend_1',
+                                'text': '需要帮忙吗？', 'observedAt': clock[0] * 1000}]
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]):
+            await service._on_game_state(self.frame(clock, 1))
+            service._idle_decision_lease_until = 1030.0
+            await service._on_game_state(data)
+            await service._on_vitals({'hp': 6, 'food': 7, 'hostiles': 1})
+        self.assertEqual({call['coalesce_key'] for _, call in calls if call['ai_behavior'] == 'respond'},
+                         {'mc_game_attention', 'mc_survival'})
+        self.assertEqual(service._idle_decision_lease_until, 1030.0)
+
+    async def test_rejected_idle_callback_does_not_claim_a_lease_or_attempt(self):
+        clock = [1000.0]
+        service, calls = self.service(clock)
+        submissions = []
+
+        def submit(**kw):
+            if kw['coalesce_key'] == 'mc_keep_going':
+                submissions.append(clock[0])
+                if len(submissions) == 1:
+                    return {'submitted': False}
+            calls.append((clock[0], kw))
+            return {'submitted': True}
+
+        service._push_message = submit
+
+        async def step(_):
+            clock[0] += .5
+            if clock[0] > 1012:
+                raise asyncio.CancelledError
+            if clock[0] % 2 == 0:
+                await service._on_game_state(self.frame(clock, int(clock[0])))
+
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]), patch(module + '.asyncio.sleep', step):
+            await service._system_prompt_loop()
+        self.assertEqual(submissions, [1010.0, 1010.5])
+        self.assertEqual(service._idle_decision_attempts, 1)
+        self.assertEqual(service._last_keep_going_nudge_at, 1010.5)
+        self.assertEqual(service._idle_decision_lease_until, 1040.5)
+
 
 if __name__ == '__main__':
     unittest.main()
