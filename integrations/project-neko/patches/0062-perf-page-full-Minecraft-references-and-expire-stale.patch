+++ b/plugin/plugins/game_agent_minecraft/reference_pages.py
@@ -0,0 +1,110 @@
+"""Bounded, lossless pages of full observations; saved snapshots never mutate."""
+from collections import OrderedDict
+import copy
+import json
+import secrets
+import time
+
+from utils.tokenize import count_tokens
+
+
+def _pointer(key):
+    return str(key).replace('~', '~0').replace('/', '~1')
+
+
+def reference_entries(value, path=''):
+    encoded = json.dumps(value, ensure_ascii=False, separators=(',', ':'))
+    if count_tokens(encoded) <= 450:
+        yield {'path': path or '/', 'value': value}
+    elif isinstance(value, dict):
+        for key, item in value.items():
+            yield from reference_entries(item, path + '/' + _pointer(key))
+    elif isinstance(value, list):
+        for index, item in enumerate(value):
+            yield from reference_entries(item, path + '/' + str(index))
+    elif isinstance(value, str):
+        for offset in range(0, len(value), 400):
+            yield {'path': path or '/', 'text': value[offset:offset + 400],
+                   'offset': offset, 'totalChars': len(value)}
+    else:
+        yield {'path': path or '/', 'value': value}
+
+
+class ObservationReferences:
+    def __init__(self, *, budget=1800, ttl=180, capacity=3, clock=time.monotonic):
+        self.budget, self.ttl, self.capacity, self.clock = budget, ttl, capacity, clock
+        self.snapshots = OrderedDict()
+
+    def create(self, result):
+        now = self.clock()
+        self.snapshots = OrderedDict((key, item) for key, item in self.snapshots.items()
+                                     if now - item['created'] <= self.ttl)
+        pages, current = [], []
+        for entry in reference_entries(copy.deepcopy(result)):
+            candidate = current + [entry]
+            if current and count_tokens(json.dumps(candidate, ensure_ascii=False)) > self.budget:
+                pages.append(current)
+                current = []
+            current.append(entry)
+        pages.append(current)
+        key = secrets.token_hex(8)
+        self.snapshots[key] = {'created': now, 'pages': pages,
+                               'observedAt': result.get('observedAt'),
+                               'status': result.get('status'), 'fresh': result.get('fresh'),
+                               'sourceTruncated': result.get('responseTruncated') or result.get('truncated')}
+        while len(self.snapshots) > self.capacity:
+            self.snapshots.popitem(last=False)
+        return self.read(key + ':0')
+
+    def read(self, cursor, path=None):
+        try:
+            key, number = str(cursor).rsplit(':', 1)
+            index = int(number)
+            item = self.snapshots[key]
+            if index < 0 or self.clock() - item['created'] > self.ttl:
+                raise ValueError('expired')
+            pages = item['pages']
+            if path:
+                if not isinstance(path, str) or not path.startswith('/'):
+                    raise ValueError('path must be a JSON pointer')
+                entries = [entry for page in pages for entry in page
+                           if entry['path'] == path or entry['path'].startswith(path.rstrip('/') + '/')]
+                # A small object may have been kept whole at an ancestor path.
+                if not entries:
+                    for page in pages:
+                        for entry in page:
+                            prefix = '' if entry['path'] == '/' else entry['path']
+                            if 'value' in entry and path.startswith(prefix + '/'):
+                                value = entry['value']
+                                try:
+                                    for part in path[len(prefix) + 1:].split('/'):
+                                        part = part.replace('~1', '/').replace('~0', '~')
+                                        value = value[int(part)] if isinstance(value, list) else value[part]
+                                except (KeyError, TypeError, ValueError, IndexError):
+                                    continue
+                                entries = list(reference_entries(value, path))
+                                break
+                selected, current = [], []
+                for entry in entries:
+                    if current and count_tokens(json.dumps(current + [entry], ensure_ascii=False)) > self.budget:
+                        selected.append(current)
+                        current = []
+                    current.append(entry)
+                selected.append(current)
+                pages = selected
+            entries = copy.deepcopy(pages[index])
+        except (KeyError, ValueError, TypeError, IndexError):
+            return {'status': 'unavailable', 'reason': 'Reference cursor/path expired or invalid; request a fresh summary/full observation.'}
+        # Advertise field roots, not dozens of attribute UUIDs or event indices.
+        # Every root is readable by the same JSON-pointer selector.
+        all_paths = list(dict.fromkeys('/'.join(entry['path'].split('/')[:4])
+                                       for page in item['pages'] for entry in page))
+        age = self.clock() - item['created']
+        return {'status': item['status'], 'fresh': bool(item['fresh'] and index == 0 and age <= 5),
+                'observedAt': item['observedAt'], 'snapshotAgeSeconds': round(self.clock() - item['created'], 2),
+                'sourceTruncated': item['sourceTruncated'],
+                'reference': {'cursor': cursor, 'rootCursor': key + ':0', 'path': path, 'page': index, 'totalPages': len(pages),
+                              'nextCursor': key + ':' + str(index + 1) if index + 1 < len(pages) else None,
+                              'availablePaths': all_paths[:60], 'pathIndexPartial': len(all_paths) > 60, 'pathIndexDepth': 3,
+                              'partial': len(pages) > 1, 'instruction': 'Read-only historical snapshot. Omitted paths are unknown. Use minecraft_observe(reference_cursor=nextCursor, reference_path=path) for needed pages/JSON pointers. Text chunks carry exact character offsets; no text was discarded. Query a fresh summary for current vitals before acting.'},
+                'entries': entries}
