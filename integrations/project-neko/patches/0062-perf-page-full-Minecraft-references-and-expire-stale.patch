@@ -0,0 +1,66 @@
+import copy
+import json
+import unittest
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+
+from plugin.plugins.game_agent_minecraft.reference_pages import ObservationReferences
+from utils.tokenize import count_tokens
+
+
+class ReferencePagesTests(unittest.TestCase):
+    def test_pages_preserve_every_character_and_do_not_mutate_the_observation(self):
+        text = '服务器欢迎与保护信息。' * 2400
+        original = {'status': 'ok', 'fresh': True, 'observedAt': 123, 'state': {'server': {'welcome': text}, 'self': {'health': 20}}}
+        before = copy.deepcopy(original)
+        store = ObservationReferences()
+        page = store.create(original)
+        collected = []
+        while True:
+            self.assertLessEqual(count_tokens(json.dumps(page['entries'], ensure_ascii=False)), 1800)
+            collected.extend(page['entries'])
+            cursor = page['reference']['nextCursor']
+            if not cursor:
+                break
+            page = store.read(cursor)
+        chunks = sorted((item for item in collected if item['path'] == '/state/server/welcome'), key=lambda item: item['offset'])
+        self.assertEqual(''.join(item['text'] for item in chunks), text)
+        self.assertEqual(original, before)
+        self.assertTrue(any(item.get('value') == {'health': 20} for item in collected))
+
+    def test_targeted_path_and_cursor_expiry_are_explicit(self):
+        clock = [0]
+        store = ObservationReferences(clock=lambda: clock[0])
+        page = store.create({'status': 'ok', 'state': {'self': {'health': 20}, 'server': {'command': '/help'}}})
+        cursor = page['reference']['cursor']
+        focused = store.read(cursor, '/state/server')
+        self.assertEqual(focused['entries'], [{'path': '/state/server', 'value': {'command': '/help'}}])
+        clock[0] = 181
+        self.assertEqual(store.read(cursor)['status'], 'unavailable')
+
+    def test_missing_path_is_unknown_and_does_not_fall_back_to_unrelated_data(self):
+        store = ObservationReferences()
+        page = store.create({'status': 'ok', 'state': {'self': {'health': 20}}})
+        self.assertEqual(store.read(page['reference']['cursor'], '/state/server')['entries'], [])
+
+
+class FullToolPagingTests(unittest.IsolatedAsyncioTestCase):
+    async def test_full_reference_keeps_safety_and_does_not_refresh_on_continuation(self):
+        from . import GameAgentMinecraftPlugin
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._ensure_service_started = AsyncMock(return_value=True)
+        observation = {'status': 'ok', 'fresh': True, 'observedAt': 123,
+                       'state': {'server': {'welcome': '服务器玩法原文。' * 3000}},
+                       'responseTruncated': ['upstream-original-limit'],
+                       'decision': {'bodyBusy': True}, 'llm_instruction': 'Do not interrupt the current action'}
+        facts = SimpleNamespace(state={'self': {'health': 4}}, focused_context=Mock(return_value='HP4 nearby zombie; current task in progress'))
+        plugin._service = SimpleNamespace(_reference_paging_enabled=True, _game_observations=facts,
+                                           observe_game=AsyncMock(return_value=observation))
+        result = await plugin.minecraft_observe(detail='full', sections=['server'], max_events=0)
+        self.assertIn('HP4', result['currentContext'])
+        self.assertEqual(result['decision'], {'bodyBusy': True})
+        self.assertEqual(result['sourceTruncated'], ['upstream-original-limit'])
+        self.assertEqual(facts.focused_context.call_args.kwargs['mode'], 'survival')
+        next_page = await plugin.minecraft_observe(reference_cursor=result['reference']['nextCursor'])
+        self.assertEqual(plugin._service.observe_game.await_count, 1)
+        self.assertFalse(next_page['fresh'])
