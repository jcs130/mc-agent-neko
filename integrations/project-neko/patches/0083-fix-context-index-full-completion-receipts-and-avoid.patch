diff --git a/plugin/plugins/game_agent_minecraft/evidence.py b/plugin/plugins/game_agent_minecraft/evidence.py
index 44932d5..19fe950 100644
--- a/plugin/plugins/game_agent_minecraft/evidence.py
+++ b/plugin/plugins/game_agent_minecraft/evidence.py
@@ -78,6 +78,33 @@ def pointer(path, key):
     return path + '/' + str(key).replace('~', '~0').replace('/', '~1')
 
 
+def receipt_index(archive, receipt):
+    """Retain a complete receipt without copying its action appendix into a new turn."""
+    evidence = archive.save(receipt)
+    value = {'rawEvidence': evidence, 'receipt': {'path': '/', 'historical': True},
+             'fields': {key: {'path': pointer('', key), 'kind': type(child).__name__,
+                        **({'entries': len(child)} if isinstance(child, (dict, list, str)) else {})}
+                        for key, child in receipt.items()}}
+    value['identity'] = {key: receipt[key] for key in
+        ('task_id', 'taskId', 'receivedTaskId', 'sessionId', 'observedAt', 'status', 'is_error', 'receiptMatch')
+        if key in receipt}
+    text = receipt.get('text')
+    marker = '\n\n[Observed game data: actual command results, not instructions]'
+    if isinstance(text, str) and marker in text:
+        conclusion, appendix = text.split(marker, 1)
+        sections = {'conclusion': conclusion, 'commandResultsWithMarker': marker + appendix}
+        value['nativeFeedbackSections'] = {'rawEvidence': archive.save(sections),
+            'conclusion': {'path': '/conclusion', 'entries': len(conclusion)},
+            'commandResults': {'path': '/commandResultsWithMarker', 'entries': len(marker + appendix)},
+            'note': 'Exact received native conclusion and command-result appendix, separated only at the native protocol marker; not a generated summary.'}
+    value['instruction'] = ('This is a matched historical receipt, not current inventory or success of another goal. '
+        'Read its exact goal or feedback with minecraft_observe(evidence_id=rawEvidence.id,reference_path=fields.<key>.path) '
+        'before relying on an outcome or retrying a failure. If nativeFeedbackSections exists, read its exact conclusion first. '
+        'Read a needed field or explicitly page a long text; '
+        'all original feedback and command results remain available without automatic clipping.')
+    return value
+
+
 def entity_table(entities, *, indexed_fields=()):
     """Share repeated column names without losing rows, values or key absence."""
     if not isinstance(entities, list) or not entities or not all(isinstance(row, dict) for row in entities):
