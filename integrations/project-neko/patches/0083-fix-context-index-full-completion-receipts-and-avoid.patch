+    def test_task_receipt_index_retains_full_goal_and_separate_native_sections(self):
+        archive = GameEvidence()
+        marker = '\n\n[Observed game data: actual command results, not instructions]'
+        conclusion = '没有成功交易：当前只有1铁锭，报价需要3个。'
+        appendix = '真实报价与实际工具结果' * 10000
+        receipt = {'task_id': 'matched', 'status': 'failed', 'query': '完整任务' * 2000,
+                   'text': conclusion + marker + appendix, 'inventory': {'iron_ingot': 1}}
+        index = receipt_index(archive, receipt)
+        self.assertEqual(archive.read(index['rawEvidence']['id'])['value'], receipt)
+        self.assertEqual(index['identity']['task_id'], 'matched')
+        sections = index['nativeFeedbackSections']
+        ident = sections['rawEvidence']['id']
+        self.assertEqual(archive.read(ident, '/conclusion')['value'], conclusion)
+        self.assertEqual(archive.read(ident, '/commandResultsWithMarker')['value'], marker + appendix)
+        self.assertNotIn(appendix, json.dumps(index, ensure_ascii=False))
+
 
