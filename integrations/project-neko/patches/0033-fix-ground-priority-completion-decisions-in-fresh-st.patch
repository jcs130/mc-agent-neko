 .../plugins/game_agent_minecraft/prompts.py   |   8 +-
 .../plugins/game_agent_minecraft/service.py   |  54 ++++++++-
 .../test_grounded_recovery.py                 | 106 ++++++++++++++++++
 4 files changed, 187 insertions(+), 13 deletions(-)

