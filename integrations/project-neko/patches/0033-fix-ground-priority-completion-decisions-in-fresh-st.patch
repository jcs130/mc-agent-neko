+class RecoveryDecisionTests(unittest.IsolatedAsyncioTestCase):
+    async def service(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.set_lang('zh')
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        await service._on_game_state(crowded_frame())
+        return service, calls
+
+    async def complete(self, service, task, text, status='failed'):
+        pending = await service.try_claim_pending(task, overwrite=False)
+        pending.dispatched = True
+        service._remember_dispatched(pending.task_id, task)
+        await service._on_task_finished({'task_id': pending.task_id, 'status': status, 'text': text})
+        return pending
+
+    async def test_matched_failures_reach_the_next_decision_and_full_observation(self):
+        service, calls = await self.service()
+        await self.complete(service, '放置工作台合成石镐', '缺少木料，无法合成工作台。')
+        await self.complete(service, '向上挖出矿洞', '缺少镐，无法破坏深板岩。')
+        await service._fire_keep_going_nudge()
+        text = calls[-1]['parts'][0]['text']
+        self.assertIn('缺少木料', text)
+        self.assertIn('缺少镐', text)
+        self.assertIn('failureStreak', text)
+        self.assertLessEqual(count_tokens(text), 1000)
+        observed = await service.observe_game(['self'], 0)
+        self.assertEqual(observed.get('failureStreak'), 2)
+        self.assertEqual(len(observed.get('recentTaskOutcomes', [])), 2)
+
+    async def test_priority_completion_itself_contains_fresh_resources_and_prior_blocker(self):
+        service, _ = await self.service()
+        await self.complete(service, '放工作台', '缺少木料。')
+        pending = await self.complete(service, '向上挖', '缺少镐。' + '重复观察资料。' * 2000)
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._lang, plugin._service = 'zh', service
+        text = plugin._format_completion_cue(pending.result)
+        self.assertTrue('灵纹法杖' in text, 'fresh custom-item identity must reach the completion cue')
+        self.assertIn('pickaxes', text)
+        self.assertIn('缺少木料', text)
+        self.assertIn('缺少镐', text)
+        self.assertLessEqual(count_tokens(text), 1000)
+        self.assertLessEqual(len(text), 8000)
+
+    async def test_duplicate_foreign_and_retroactive_completions_do_not_poison_history(self):
+        service, _ = await self.service()
+        old = await self.complete(service, '旧任务', '缺少木料。')
+        pending = await service.try_claim_pending('当前任务', overwrite=False)
+        pending.dispatched = True
+        service._remember_dispatched(pending.task_id, pending.task_text)
+        for ident, status in [('foreign', 'failed'), (old.task_id, 'failed'), (pending.task_id, 'duplicate')]:
+            await service._on_task_finished({'task_id': ident, 'status': status, 'text': '不属于当前终态'})
+        observed = await service.observe_game(['self'], 0)
+        self.assertEqual(len(observed.get('recentTaskOutcomes', [])), 1)
+        self.assertEqual(observed.get('failureStreak'), 1)
+        self.assertIs(service._pending, pending)
+
+    async def test_new_game_session_forgets_old_outcomes(self):
+        service, _ = await self.service()
+        await self.complete(service, '旧世界挖矿', '缺少木料。')
+        await service._on_game_state(crowded_frame(session='another-server'))
+        observed = await service.observe_game(['self'], 0)
+        self.assertEqual(observed.get('recentTaskOutcomes'), [])
+        self.assertEqual(observed.get('failureStreak'), 0)
+        self.assertIsNone(observed.get('lastTaskOutcome'))
+
+    async def test_bounded_history_and_reported_success_reset_failure_streak(self):
+        service, _ = await self.service()
+        for n in range(12):
+            await self.complete(service, f'失败任务 {n}', '缺少木料。' * 1000)
+        await self.complete(service, '已读取菜单', '读取到真实菜单。', status='ok')
+        observed = await service.observe_game(['self'], 0)
+        self.assertEqual(observed.get('failureStreak'), 0)
+        self.assertEqual(len(observed.get('recentTaskOutcomes', [])), 8)
+        self.assertLess(len(json.dumps(observed['recentTaskOutcomes'])), 12000)
+
+    async def test_local_timeout_is_recorded_once_for_its_actual_pending_task(self):
+        service, _ = await self.service()
+        async def send_task(*args, **kwargs):
+            return True
+        service._client = SimpleNamespace(send_task=send_task)
+        service._task_timeout = 0.001
+        pending = await service.try_claim_pending('未完成的短目标', overwrite=False)
+        result = await service.run_claimed_task(pending)
+        self.assertEqual(result['status'], 'timeout')
+        self.assertEqual(service._task_failure_streak, 1)
+        self.assertEqual(len(service._recent_task_outcomes), 1)
+        self.assertIsNone(service._pending)
+
+    async def test_full_decision_with_failure_history_replies_and_retry_keeps_its_budget(self):
+        service, calls = await self.service()
+        await self.complete(service, '合成工作台', '缺少木料。')
+        await self.complete(service, '挖出深层矿洞', '缺少镐，无法向上开路。')
+        service._idle_decision_attempts = 2
+        service.record_server_command({'command': '/mycli spells list 1', 'status': 'received',
+                                       'messages': ['技能说明' * 2000]})
+        await service._fire_keep_going_nudge()
+        text = calls[-1]['parts'][0]['text']
+        self.assertIn('缺少木料', text)
+        self.assertIn('pickaxes', text)
+        self.assertLessEqual(count_tokens(text), 1000)
