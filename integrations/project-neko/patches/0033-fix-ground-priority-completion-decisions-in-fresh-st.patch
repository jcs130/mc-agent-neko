+    def _record_task_outcome(self, pending: PendingTask, status: str, text: str) -> None:
+        self._last_task_outcome = {'task': pending.task_text, 'status': status, 'text': text}
+        entry = {'taskId': pending.task_id, 'sessionId': self._game_observations.session_id,
+                 'observedAt': time.time(), 'task': pending.task_text[:180],
+                 'status': status[:40], 'text': text[:240]}
+        self._recent_task_outcomes = [entry, *self._recent_task_outcomes][:8]
+        normalized = status.strip().lower()
+        if normalized == 'ok' and not text_signals_blocked(text):
+            self._task_failure_streak = 0
+        elif normalized not in ('interrupted', 'superseded'):
+            self._task_failure_streak = min(99, self._task_failure_streak + 1)
+
+    def recovery_context(self, max_tokens=110) -> str:
+        """Prior matched outcomes, kept separate from current inventory facts."""
+        if not self._recent_task_outcomes:
+            return ''
+        from utils.tokenize import count_tokens
+        previous = self._recent_task_outcomes[1:3]
+        value = {'failureStreak': self._task_failure_streak, 'previousTaskOutcomes': [
+            {'task': item['task'][:32], 'status': item['status'], 'reason': item['text'].split('\n', 1)[0][:64]}
+            for item in previous]}
+        prefix = 'Previous reported outcomes (historical): '
+        render = lambda: prefix + json.dumps(value, ensure_ascii=False, separators=(',', ':'))
+        for limit in (40, 24, 12):
+            if count_tokens(render()) <= max_tokens:
+                break
+            for item in value['previousTaskOutcomes']:
+                item['reason'] = item['reason'][:limit]
+                item['task'] = item['task'][:min(limit, 24)]
+        while count_tokens(render()) > max_tokens and value['previousTaskOutcomes']:
+            value['previousTaskOutcomes'].pop()
+        return render()
+
