         if is_blocked:
@@ -693,8 +693,28 @@ class GameAgentMinecraftPlugin(NekoPluginBase):
             lines.append(prompts.t("COMPLETION_FOLLOWUP_SUCCESS", lang=self._lang))
         else:
             lines.append(prompts.t("COMPLETION_FOLLOWUP_FAILED", lang=self._lang))
+            lines.append(prompts.t('RECOVERY_POLICY', lang=self._lang))
         lines.append(prompts.t("INTERNAL_STATE_GAG", lang=self._lang))
-        return prompts.t("CUE_PREFIX_DONE", lang=self._lang) + "\n" + "\n".join(lines)
+        if recovery_context:
+            lines.append(recovery_context)
+        if fresh_context:
+            lines.append(fresh_context)
+        prefix = prompts.t("CUE_PREFIX_DONE", lang=self._lang) + '\n'
+        # This priority-7 callback can run before passive facts are consumed.
+        # Reserve its fresh resources/recovery facts before fitting feedback;
+        # otherwise the host's 1,000-token cap silently chops them off.
+        from utils.tokenize import count_tokens, truncate_to_tokens
+        reserved = count_tokens(prefix + '\n'.join(lines))
+        budget = max(0, min(600, 940 - reserved))
+        if detail and budget:
+            if count_tokens(detail) > budget:
+                tail = detail[-1200:]
+                while count_tokens(tail) > budget // 3 and tail:
+                    tail = tail[max(1, len(tail) // 4):]
+                head = truncate_to_tokens(detail, max(0, budget - count_tokens(tail) - 10))
+                detail = head + '\n[…]\n' + tail
+            lines.insert(1, prompts.t('COMPLETION_FEEDBACK_LINE', lang=self._lang, detail=detail))
+        return prefix + '\n'.join(lines)
 
