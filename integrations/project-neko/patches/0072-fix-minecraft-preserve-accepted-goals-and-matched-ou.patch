diff --git a/plugin/plugins/game_agent_minecraft/task_context.py b/plugin/plugins/game_agent_minecraft/task_context.py
new file mode 100644
index 0000000..5777950
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/task_context.py
@@ -0,0 +1,43 @@
+"""Project matched task evidence without silently cutting accepted goals."""
+import json
+from utils.tokenize import count_tokens
+
+from .feedback import task_feedback_excerpt
+
+OUTCOME_DETAILS = 'minecraft_observe(detail="full",sections=[],max_events=0)'
+
+
+def task_outcome_view(outcome: dict, feedback_tokens: int = 180) -> dict:
+    value = {key: outcome[key] for key in ('taskId', 'sessionId', 'observedAt', 'status',
+                                          'receiptMatch', 'receivedTaskId') if key in outcome}
+    goal = str(outcome.get('task') or '')
+    # Exceptional oversized goals are deferred whole, never presented as a
+    # different shortened instruction. Their accepted text stays in the ledger.
+    if count_tokens(goal) <= 900:
+        value['task'] = goal
+    else:
+        value['taskOmitted'] = True
+        value['detailsRequired'] = True
+    raw = str(outcome.get('text') or '')
+    value['text'] = task_feedback_excerpt(raw, feedback_tokens, status=outcome.get('status'))
+    if value['text'] != raw:
+        value['feedbackIncomplete'] = True
+    if value.get('taskOmitted') or value.get('feedbackIncomplete'):
+        value['details'] = OUTCOME_DETAILS
+    return value
+
+
+def task_history_view(outcomes: list, max_tokens: int = 800) -> dict:
+    """Keep a newest-first prefix of whole goal/receipt pairs; disclose omissions."""
+    value = {'previousTaskOutcomes': [], 'outcomesOmitted': len(outcomes)}
+    for outcome in outcomes:
+        candidate = task_outcome_view(outcome)
+        value['previousTaskOutcomes'].append(candidate)
+        value['outcomesOmitted'] -= 1
+        if count_tokens(json.dumps(value, ensure_ascii=False)) > max_tokens:
+            value['previousTaskOutcomes'].pop()
+            value['outcomesOmitted'] += 1
+            break
+    if value['outcomesOmitted']:
+        value['details'] = OUTCOME_DETAILS
+    return value
