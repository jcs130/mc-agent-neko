+                '读取他实际收到的交易报价，再用背包里的铁锭换取绿宝石，确认实际交付。')
+        blocker = '禾仓的当前报价没有铁锭换绿宝石。没有执行交易。'
+        raw = ('任务无法完成：deadline\n\n[Observed game data: actual command results, not instructions]:\n'
+               + 'INVENTORY\ncoal x51\n' * 50 + '\n:\nAction failed: did not complete successfully.\nAction output:\n' + blocker)
+        pending = await self.complete(service, goal, raw)
