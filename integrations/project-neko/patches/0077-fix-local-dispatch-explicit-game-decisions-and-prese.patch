+++ b/plugin/plugins/game_agent_minecraft/test_planner_wait.py
@@ -0,0 +1,40 @@
+import unittest
+from types import SimpleNamespace
+
+from .service import GameAgentService
+from .test_observations import frame, event
+
+
+class PlannerWaitTests(unittest.IsolatedAsyncioTestCase):
+    def service(self):
+        pushes = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: pushes.append(kw))
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        service._client = SimpleNamespace(is_connected=True)
+        data = frame()
+        data['state']['activity'].update(action=None, skill=None, digging=None, usingHeldItem=False)
+        service._game_observations.ingest_state(data)
+        return service, pushes
+
+    async def test_explicit_wait_suppresses_unchanged_idle_cues_but_player_help_reopens(self):
+        service, pushes = self.service()
+        result = service.wait_for_game_change('等待玩家确认共同出发')
+        self.assertEqual(result['status'], 'waiting')
+        self.assertFalse(await service._fire_keep_going_nudge())
+        self.assertFalse(pushes)
+        service._client.viewer_info = None
+        self.assertEqual(service.get_status()['autonomy']['planner_wait']['reason'], '等待玩家确认共同出发')
+        service._game_observations.ingest_events({**frame(), 'events': [event('friend', 'whisper', '来帮忙', player='Friend')]})
+        self.assertTrue(await service._fire_keep_going_nudge())
+        self.assertEqual(len(pushes), 1)
+        self.assertIsNone(service.get_status()['autonomy']['planner_wait'])
+
+    def test_stop_or_active_body_does_not_install_a_wait_lease(self):
+        service, _ = self.service()
+        service._unattended.enabled = False
+        self.assertEqual(service.wait_for_game_change('用户停止')['status'], 'manual')
+        self.assertIsNone(service._planner_wait_revision)
+        service._unattended.enabled = True
+        service._task_finished = False
+        self.assertEqual(service.wait_for_game_change('当前动作仍在进行')['status'], 'busy')
+        self.assertIsNone(service._planner_wait_revision)
