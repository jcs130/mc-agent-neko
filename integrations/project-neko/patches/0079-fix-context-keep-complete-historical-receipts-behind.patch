@@ -100,6 +100,30 @@ class GameEvidenceTest(unittest.TestCase):
         self.assertEqual(len(retained), 602)
         self.assertEqual(retained[-1]['text'], '第599条完整旧消息')
 
+    def test_tool_summary_never_reinlines_old_receipts_or_unbounded_failure_appendix(self):
+        info = self.observations()
+        old = '旧服务器原始返回' * 10000
+        goal = '完整的旧任务目标' * 1000
+        failure = '实际失败原因：当前报价不收铁锭。' + '完整工具回执' * 10000
+        extras = {'lastTaskOutcome': {'taskId': 'matched', 'status': 'failed',
+                                     'task': goal, 'text': failure},
+                  'lastServerCommands': [{'command': '/mycli guild', 'messages': [old]}],
+                  'recentTaskOutcomes': [{'task': goal, 'text': failure}]}
+        for mode in ('decision', 'running'):
+            with self.subTest(mode=mode):
+                view = decision_input(info, mode=mode, extra=extras)
+                encoded = json.dumps(view, ensure_ascii=False)
+                self.assertNotIn(old, encoded)
+                self.assertNotIn(failure, encoded)
+                self.assertNotIn(goal, encoded)
+                self.assertEqual(view['lastTaskOutcome']['taskId'], 'matched')
+                self.assertEqual(view['lastTaskOutcome']['status'], 'failed')
+                ident = view['rawEvidence']['id']
+                self.assertEqual(info.evidence.read(ident, '/lastTaskOutcome/text')['value'], failure)
+                self.assertEqual(info.evidence.read(ident, '/lastTaskOutcome/task')['value'], goal)
+                self.assertEqual(info.evidence.read(ident, '/lastServerCommands/0/messages/0')['value'], old)
+                self.assertEqual(info.evidence.read(ident, '/recentTaskOutcomes')['value'], extras['recentTaskOutcomes'])
+
 
 if __name__ == '__main__':
     unittest.main()
