diff --git a/plugin/plugins/game_agent_minecraft/evidence.py b/plugin/plugins/game_agent_minecraft/evidence.py
index 37a0485..0a7ae1a 100644
--- a/plugin/plugins/game_agent_minecraft/evidence.py
+++ b/plugin/plugins/game_agent_minecraft/evidence.py
@@ -185,9 +185,17 @@ def decision_input(info, *, mode='decision', sections=None, extra=None):
     value['eventIndexNote'] = 'Complete historical catalogue at /recentEvents; entries include identity, time and exact text. New pending player messages are delivered whole in social callbacks. Query history when it is relevant; it is not current state.'
     value['protocolEventHistory'] = ref(events, '/recentEvents')
     value['agentLog'] = ref(full.get('agentLog') or [], '/agentLog')
-    for key in ('recentTaskOutcomes', 'recentTaskOutcomeDetails'):
+    for key in ('recentTaskOutcomes', 'recentTaskOutcomeDetails', 'lastServerCommands',
+                'deferredEvents', 'deferredPlayerMessages'):
         if key in full:
             value[key] = ref(full[key], pointer('', key))
+    if isinstance(full.get('lastTaskOutcome'), dict):
+        # A receipt is a historical result, not current physical state. Keep
+        # its matching identity/status visible and the original goal and
+        # feedback queryable, including arbitrarily long action appendices.
+        value['lastTaskOutcome'] = {key: ref(child, pointer('/lastTaskOutcome', key))
+            if key in ('task', 'text') else deepcopy(child)
+            for key, child in full['lastTaskOutcome'].items()}
     if mode == 'running':
         # A passive update is a query index, not a second copy of an active
         # decision. The complete snapshot is already saved above.
@@ -195,9 +203,16 @@ def decision_input(info, *, mode='decision', sections=None, extra=None):
                  'ageSeconds', 'inputPolicy', 'rawEvidence', 'note', 'authentication') if key in value}
         value['sections'] = list((full.get('state') or {}).keys())
         if extra:
-            for key in ('status', 'source', 'decision', 'llm_instruction', 'lastTaskOutcome'):
+            for key in ('status', 'source', 'decision', 'llm_instruction'):
                 if key in full:
                     value[key] = deepcopy(full[key])
+            if isinstance(full.get('lastTaskOutcome'), dict):
+                value['lastTaskOutcome'] = {key: ref(child, pointer('/lastTaskOutcome', key))
+                    if key in ('task', 'text') else deepcopy(child)
+                    for key, child in full['lastTaskOutcome'].items()}
+            value['history'] = {key: ref(full[key], pointer('', key))
+                for key in ('recentTaskOutcomes', 'recentTaskOutcomeDetails', 'lastServerCommands',
+                            'deferredEvents', 'deferredPlayerMessages') if key in full}
             value['state'] = {key: deepcopy(child) for key, child in (full.get('state') or {}).items()
                               if key in ('self', 'world', 'activity')}
     elif mode == 'social' and isinstance(value.get('state'), dict):
diff --git a/plugin/plugins/game_agent_minecraft/service.py b/plugin/plugins/game_agent_minecraft/service.py
index 5ee7c97..f18d1ad 100644
--- a/plugin/plugins/game_agent_minecraft/service.py
+++ b/plugin/plugins/game_agent_minecraft/service.py
@@ -46,8 +46,6 @@ from typing import Any, Callable, Dict, Optional
 from . import prompts
 from .client import GameAgentClient, IngameChatMessage
 from .observations import GameObservations, bounded_value
-from .feedback import task_feedback_excerpt
-from .task_context import task_outcome_view, task_history_view
 
 # Strip ANSI colour escapes from agent log lines before relaying to the
 # LLM — we don't want VT100 noise in the model's context window.
@@ -1274,13 +1272,29 @@ class GameAgentService:
             self._task_failure_streak = min(99, self._task_failure_streak + 1)
 
     def recovery_context(self, max_tokens=800) -> str:
-        """Prior matched outcomes, kept separate from current inventory facts."""
-        if not self._recent_task_outcomes:
+        """Index historical receipts; keep originals outside each new decision."""
+        if not self._last_task_outcome and not self._recent_task_outcomes and not self._server_command_history:
             return ''
-        value = task_history_view(self._recent_task_outcomes[1:], max_tokens=max_tokens)
-        value['failureStreak'] = self._task_failure_streak
-        prefix = 'Previous reported outcomes (historical): '
-        return prefix + json.dumps(value, ensure_ascii=False, separators=(',', ':'))
+        full = {'lastTaskOutcome': self._last_task_outcome,
+                'recentTaskOutcomes': self._recent_task_outcomes,
+                'lastServerCommands': self._server_command_history}
+        evidence = self._game_observations.evidence.save(full)
+        value = {'rawEvidence': evidence, 'failureStreak': self._task_failure_streak,
+                 'recentTaskOutcomes': {'path': '/recentTaskOutcomes',
+                                        'entries': len(self._recent_task_outcomes)},
+                 'lastServerCommands': {'path': '/lastServerCommands',
+                                        'entries': len(self._server_command_history)}}
+        if self._last_task_outcome:
+            outcome = self._last_task_outcome
+            value['lastTaskOutcome'] = {key: outcome[key] for key in
+                ('taskId', 'sessionId', 'status', 'observedAt', 'receiptMatch', 'receivedTaskId')
+                if key in outcome}
+            value['lastTaskOutcome']['details'] = {'path': '/lastTaskOutcome'}
+        value['instruction'] = ('Receipts are historical, never proof of current inventory or completion. '
+            'Read the matching goal and exact feedback before retrying a failed task or relying on an old result: '
+            'minecraft_observe(evidence_id=rawEvidence.id,reference_path=path). '
+            'All goals, feedback and server replies are retained without clipping.')
+        return 'Received task/server history query index: ' + json.dumps(value, ensure_ascii=False, separators=(',', ':'))
 
     def _native_retreat_handoff(self):
         """Return only a fresh, explicitly idle, bounded native recovery window."""
@@ -2665,34 +2679,15 @@ class GameAgentService:
             else:
                 sections.append(prompts.t("AUTONOMOUS_DECISION_BODY", lang=self._lang))
         if self._game_observations.fresh:
-            # The host caps the entire callback, not just the game-state part.
-            # Avoid duplicate inventory/vitals and reserve space for the real
-            # last outcome before choosing the summary's token budget.
-            if self._last_task_outcome:
-                outcome = self._last_task_outcome
-                # Reserve feedback independently: a long repeated goal used
-                # to consume the whole 90-token envelope before any result.
-                sections.append(prompts.t(
-                    'LAST_TASK_OUTCOME', lang=self._lang,
-                    task=task_outcome_view(outcome).get('task', '[full accepted goal requires minecraft_observe]'),
-                    status=outcome['status'],
-                    result=task_feedback_excerpt(outcome['text'], 240, status=outcome.get('status')),
-                ) + '\nMatched taskId: ' + str(outcome.get('taskId') or 'not received')
-                    + '\nFull lastTaskOutcome is available through minecraft_observe.')
-            if self._server_command_history:
-                history = [{'command': item['command'], 'status': item['status'],
-                            'reply': ' '.join(str(text) for text in item['messages'])}
-                           for item in self._server_command_history]
-                sections.append('Received server replies (historical, not completion): ' + json.dumps(history, ensure_ascii=False, separators=(',', ':')) +
-                    '\nFull lastServerCommands: minecraft_observe.')
+            # Current facts and complete historical evidence have separate
+            # roles. Re-inlining old replies here bypassed the evidence index
+            # and eventually made every new decision exceed model capacity.
             if self._idle_decision_attempts:
                 sections.append(prompts.t('IDLE_DECISION_RETRY', lang=self._lang))
             if not self._unattended.enabled:
                 sections.append(prompts.t('KEEP_GOING_BODY', lang=self._lang))
             sections.append('If detailsRequired=true, query the needed section before deciding; omitted facts are unknown.')
 
-            # Fit whole historical pairs around the current goal/result, never
-            # let a long previous goal cut off current safety or failure facts.
             recovery = self.recovery_context()
             if recovery:
                 sections.append(recovery)
