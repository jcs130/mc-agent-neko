diff --git a/plugin/plugins/game_agent_minecraft/decision_context.py b/plugin/plugins/game_agent_minecraft/decision_context.py
index 8451627..d91b258 100644
--- a/plugin/plugins/game_agent_minecraft/decision_context.py
+++ b/plugin/plugins/game_agent_minecraft/decision_context.py
@@ -216,8 +216,10 @@ def build_focused_view(info, *, mode='decision', max_events=6, max_tokens=1600,
         active['usingHeldItem'] = activity.get('usingHeldItem')
         active['mobility'] = _select(activity.get('mobility'), ('state', 'enclosed'))
         recovery = activity.get('recovery')
-        if isinstance(recovery, dict) and recovery.get('type') == 'protected-surface-swim-stall':
-            active['recovery'] = _select(recovery, ('type', 'noProgressSeconds', 'next'))
+        if isinstance(recovery, dict) and recovery.get('type') in (
+                'protected-surface-swim-stall', 'protected-retreat-stall', 'tool-retreat-stall'):
+            active['recovery'] = _select(recovery, (
+                'type', 'constraint', 'observedAt', 'expiresAt', 'noProgressSeconds', 'next'))
         compact = {'self': own_brief, 'world': _select(world, ('dimension', 'timeOfDay', 'weather')),
                    'activity': active}
         if mode != 'running':
diff --git a/plugin/plugins/game_agent_minecraft/service.py b/plugin/plugins/game_agent_minecraft/service.py
index 751e091..5b0140a 100644
--- a/plugin/plugins/game_agent_minecraft/service.py
+++ b/plugin/plugins/game_agent_minecraft/service.py
@@ -1369,6 +1369,20 @@ class GameAgentService:
         activity = info.state.get('activity') if info.fresh else None
         if isinstance(activity, dict) and any(activity.get(key) for key in ('action', 'skill', 'digging', 'usingHeldItem')):
             return True
+        # The native reflex has explicitly yielded a measured futile retreat.
+        # Its older natural-language status may still say "autonomous/busy";
+        # do not spend the short handoff window waiting for that latch's TTL.
+        # Real activity above and pending tasks in _game_execution_busy still
+        # win. Missing, expired or unrecognized telemetry grants no exception.
+        if isinstance(activity, dict) and all(key in activity for key in (
+                'action', 'skill', 'digging', 'usingHeldItem')):
+            recovery = activity.get('recovery')
+            if isinstance(recovery, dict) and recovery.get('type') in (
+                    'protected-retreat-stall', 'tool-retreat-stall'):
+                start, end = recovery.get('observedAt'), recovery.get('expiresAt')
+                if (type(start) in (int, float) and type(end) in (int, float)
+                        and start <= time.time() * 1000 < end <= start + 60000):
+                    return False
         return bool(self._agent_busy) and (time.time() - self._agent_busy_at) < self._agent_busy_ttl
 
     def _mark_agent_idle(self) -> None:
diff --git a/plugin/plugins/game_agent_minecraft/test_focused_context.py b/plugin/plugins/game_agent_minecraft/test_focused_context.py
index 8a53b86..a5a6850 100644
