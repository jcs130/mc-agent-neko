         data['state']['activity']['recovery'] = {
diff --git a/plugin/plugins/game_agent_minecraft/test_query_loop.py b/plugin/plugins/game_agent_minecraft/test_query_loop.py
index d94f30b..dd31bd9 100644
--- a/plugin/plugins/game_agent_minecraft/test_query_loop.py
+++ b/plugin/plugins/game_agent_minecraft/test_query_loop.py
@@ -1,4 +1,5 @@
 import json
+import time
 import unittest
 
 from utils.tokenize import count_tokens
@@ -9,6 +10,46 @@ from .test_observations import frame, event
 
 
 class QueryLoopTests(unittest.IsolatedAsyncioTestCase):
+    async def test_measured_idle_retreat_handoff_overrides_only_old_busy_latch(self):
+        service, _ = self.service()
+        now = time.time()
+        data = frame()
+        data['state']['activity'] = {'action': None, 'skill': None, 'digging': None,
+            'usingHeldItem': False, 'recovery': {'type': 'tool-retreat-stall',
+            'observedAt': now * 1000 - 1000, 'expiresAt': now * 1000 + 59000}}
+        await service._on_game_state(data)
+        service._agent_busy, service._agent_busy_at = True, now
+        self.assertFalse(service._mc_agent_busy())
+        # A real action, pending task, expired or malformed handoff must retain
+        # ordinary ownership; this exception is not a general idle override.
+        data['seq'] += 1
+        data['state']['activity']['skill'] = 'goToPosition'
+        await service._on_game_state(data)
+        self.assertTrue(service._mc_agent_busy())
+        data['seq'] += 1
+        data['state']['activity']['skill'] = None
+        data['state']['activity']['recovery']['expiresAt'] = now * 1000 - 1
+        await service._on_game_state(data)
+        self.assertTrue(service._mc_agent_busy())
+        for expiry in ('invalid', True, float('inf'), now * 1000 + 300000):
+            data['seq'] += 1
+            data['state']['activity']['recovery']['expiresAt'] = expiry
+            await service._on_game_state(data)
+            self.assertTrue(service._mc_agent_busy())
+        data['seq'] += 1
+        data['state']['activity']['recovery'].update(type='unknown', expiresAt=now * 1000 + 59000)
+        await service._on_game_state(data)
+        self.assertTrue(service._mc_agent_busy())
+        data['seq'] += 1
+        data['state']['activity']['recovery']['type'] = 'protected-retreat-stall'
+        await service._on_game_state(data)
+        self.assertFalse(service._mc_agent_busy())
+        service._pending = object()
+        self.assertTrue(service._game_execution_busy())
+        service._pending = None
+        service._game_observations.observed_at -= 60
+        self.assertTrue(service._mc_agent_busy())
+
     def service(self):
         calls = []
         service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
