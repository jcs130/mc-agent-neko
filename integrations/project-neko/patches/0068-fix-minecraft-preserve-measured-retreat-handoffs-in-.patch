@@ -14,6 +14,27 @@ from .service import GameAgentService
 
 
 class FocusedContextTests(unittest.TestCase):
+    def test_measured_retreat_constraints_survive_every_focused_mode(self):
+        for kind, constraint in (('protected-retreat-stall', 'server_protection'),
+                                 ('tool-retreat-stall', 'missing_pickaxe')):
+            for mode in ('decision', 'running', 'social', 'survival'):
+                with self.subTest(kind=kind, mode=mode):
+                    data = crowded_frame()
+                    data['state']['activity']['recovery'] = {
+                        'type': kind, 'constraint': constraint, 'noProgressSeconds': 15,
+                        'observedAt': 1000, 'expiresAt': 61000,
+                        'next': 'Use an existing passage or an observed escape ability.',
+                    }
+                    observations = GameObservations()
+                    observations.ingest_state(data)
+                    view = observations.focused_view(mode=mode, max_tokens=950)
+                    recovery = view['state']['activity'].get('recovery')
+                    self.assertIsNotNone(recovery)
+                    self.assertEqual(recovery['constraint'], constraint)
+                    self.assertEqual(recovery['expiresAt'], 61000)
+                    self.assertIn('existing passage', recovery['next'])
+                    self.assertLessEqual(count_tokens(json.dumps(view, ensure_ascii=False)), 950)
+
     def test_native_protected_swim_recovery_survives_focused_context(self):
