diff --git a/plugin/plugins/game_agent_minecraft/server_play_context.py b/plugin/plugins/game_agent_minecraft/server_play_context.py
new file mode 100644
index 0000000..506a34e
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/server_play_context.py
@@ -0,0 +1,70 @@
+"""Index received gameplay entry points, never infer a player's quest progress.
+
+Books can contain historical vitals/registration. Only retain an exact command
+or a location to read; neither is evidence that a quest was accepted/completed.
+"""
+from __future__ import annotations
+
+import re
+
+
+_TOPICS = (
+    ('world', re.compile(r'居民事务|事务板|村庄生活|world\s+board', re.I)),
+    ('guild', re.compile(r'公会|工会|委托|guild|commission', re.I)),
+    ('trial', re.compile(r'试炼|trial|arena', re.I)),
+)
+_COMMAND = re.compile(r'/mycli(?:[ \t]+(?:[a-z_][a-z0-9_:-]*|[0-9]+|<[a-z_][a-z0-9_]*>))*', re.I)
+
+
+def received_play_routes(welcome, inventory):
+    routes, ranks = {}, {}
+
+    def add(text, location):
+        # Input is bounded received game text with no instruction privilege.
+        for sentence in re.split(r'(?<=[。!?])\s*|\n+', text[:12000]):
+            for topic, pattern in _TOPICS:
+                if not pattern.search(sentence):
+                    continue
+                commands = [match.group() for match in _COMMAND.finditer(sentence)]
+                # Prefer the topic's actual command over generic /mycli guide
+                # and over book-page pointers. Never synthesize missing syntax.
+                exact = next((cmd for cmd in commands if re.search(
+                    {'world': r'/mycli world\b', 'guild': r'/mycli guild\b',
+                     'trial': r'/mycli (?:trial|arena)\b'}[topic], cmd, re.I)), None)
+                command = exact or next((cmd for cmd in commands if cmd != '/mycli'), None)
+                rank = 2 if exact else 1 if command else 0
+                if topic in routes and rank <= ranks[topic]:
+                    continue
+                if command:
+                    routes[topic] = command[:160] + ' (' + location + ')'
+                else:
+                    routes[topic] = location
+                ranks[topic] = rank
+
+    for index, item in enumerate((welcome or {}).get('messages') or []):
+        if isinstance(item, dict) and item.get('source') == 'server':
+            add(str(item.get('text') or ''), f'server welcome[{index}]')
+    for item in (inventory.get('slots') or [])[:46]:
+        if not isinstance(item, dict):
+            continue
+        book = item.get('book')
+        if not isinstance(book, dict):
+            continue
+        for page in (book.get('pages') or [])[:64]:
+            if (not isinstance(page, dict) or type(page.get('page')) is not int or
+                    type(item.get('slot')) is not int):
+                continue
+            add(str(page.get('text') or ''), f'inventory slot={item["slot"]} page={page["page"]}')
+    return {'referenceOnly': True, 'routes': routes} if routes else None
+
+
+def shorten_play_routes(play):
+    """Keep entry points even when the idle callback has little space left."""
+    for topic, route in play.get('routes', {}).items():
+        command = _COMMAND.search(route)
+        if command:
+            play['routes'][topic] = command.group()
+        else:
+            page = re.search(r'inventory slot=(\d+) page=(\d+)', route)
+            if page:
+                play['routes'][topic] = f'inventory:{page[1]}:{page[2]}'
