+"""Regression for gameplay routes lost behind earlier skill catalogue lines."""
+import copy
+import json
+import unittest
+from types import SimpleNamespace
+
+from utils.tokenize import count_tokens
+
+from .observations import GameObservations
+from .service import GameAgentService
+from .test_server_welcome import welcome_frame
+from .test_grounded_recovery import crowded_frame
+
+
+def gameplay_frame():
+    data = welcome_frame(texts=[
+        '欢迎游玩',
+        '[系统·技能目录] /mycli skills list profession 查看职业技艺。技能有多页，请读 pages/MC_SPELL_NEXT。',
+        '用 /mycli skills info <ID> 查点数和解锁条件。看到技能不等于已经学会。',
+        '组队倒地救援靠近4格10秒或清场自动复活，无需学习/施法。',
+        '已领取灵纹法杖，使用键立即探矿。',
+        '[村庄生活季] 农耕、集市供给、遗迹调查：/mycli world board；旅途指南→居民事务板。',
+    ])
+    data['state']['self'].update(health=20, food=20)
+    data['state']['activity'] = {'action': None, 'skill': None, 'digging': None, 'usingHeldItem': False}
+    data['state']['inventory']['slots'].append({'slot': 19, 'name': 'written_book', 'book': {
+        'title': '命格书', 'pageCount': 23, 'pages': [
+            {'page': 1, 'text': '历史生命16，饥饿10，剩余技能点6。'},
+            {'page': 3, 'text': '冒险者公会：尚未注册，技能罗盘公会看板或 /mycli guild join 加入。'},
+            {'page': 14, 'text': '试炼塔与奖励\n从村庄沿路到塔，入口石按钮选难度，再点开始。奖励在入口个人箱。'},
+        ]}})
+    return data
+
+
+class ServerPlayContextTests(unittest.TestCase):
+    def info(self):
+        info = GameObservations()
+        info.ingest_state(gameplay_frame())
+        return info
+
+    def test_later_board_is_not_displaced_by_three_earlier_skill_sentences(self):
+        view = self.info().focused_view()
+        self.assertIn('/mycli world board', str(view['serverGuide']))
+
+    def test_idle_capsule_retains_routes_and_book_locations_without_stale_progress(self):
+        info = self.info()
+        before = copy.deepcopy(info.state)
+        text = info.focused_context(max_tokens=700)
+        view = json.loads(text.split('\n', 1)[1])
+        routes = view['serverPlay']['routes']
+        self.assertIn('/mycli world board', str(routes))
+        self.assertIn('/mycli guild join', str(routes))
+        self.assertIn('14', str(routes['trial']))
+        self.assertTrue(view['serverPlay']['referenceOnly'])
+        self.assertEqual(view['state']['self']['health'], 20)
+        self.assertNotIn('尚未注册', text)
+        self.assertNotIn('历史生命', text)
+        self.assertNotIn('/mycli trial', text, 'unknown trial syntax must not be invented')
+        self.assertLessEqual(count_tokens(text), 700)
+        self.assertEqual(info.state, before)
+
+    def test_small_capsule_keeps_a_progression_entry_or_explicit_reference(self):
+        text = self.info().focused_context(max_tokens=400)
+        view = json.loads(text.split('\n', 1)[1])
+        self.assertIn('serverPlay', view)
+        self.assertIn('/mycli world board', str(view['serverPlay']))
+        self.assertLessEqual(count_tokens(text), 400)
+
+    def test_crowded_inventory_does_not_make_small_capsule_collapse_to_vitals_only(self):
+        data = crowded_frame()
+        reference = gameplay_frame()['state']
+        data['state']['server']['welcome'] = reference['server']['welcome']
+        data['state']['server']['welcome']['sessionId'] = data['sessionId']
+        data['state']['inventory']['slots'] += reference['inventory']['slots']
+        data['state']['inventory']['counts'].update(iron_pickaxe=1, stone_pickaxe=1,
+                                                   oak_planks=1, birch_planks=8, birch_log=4)
+        data['state']['inventory']['slots'].append({'name': 'iron_pickaxe', 'slot': 30,
+                                                   'durabilityUsed': 0, 'maxDurability': 250})
+        data['state']['self'].update(food=20, oxygen=None)
+        data['state']['inventory']['held'] = {'name': 'cobblestone', 'durabilityUsed': None, 'maxDurability': None}
+        data['state']['inventory']['emptySlots'] = 0
+        data['state']['activity'] = reference['activity']
+        data['state']['activity']['mobility'] = {'state': 'FREE', 'enclosed': False}
+        data['state']['nearby']['entities'] = [{'name': name, 'username': None, 'customName': '', 'distance': 3.8}
+                                              for name in ('spider', 'villager', 'pig', 'enderman')]
+        data['state']['server']['protection']['lastCheck'] = {
+            'action': 'break', 'world': 'minecraft:overworld', 'x': -492, 'y': 65, 'z': -457,
+            'status': 'allow_likely', 'allowed': True, 'reason': 'no_known_protection', 'observedAt': 1000}
+        info = GameObservations()
+        info.ingest_state(data)
+        text = info.focused_context(max_tokens=400)
+        view = json.loads(text.split('\n', 1)[1])
+        self.assertIn('/mycli world board', str(view.get('serverPlay')))
+        self.assertIn('iron_pickaxe', str(view.get('resources')))
+        self.assertLessEqual(count_tokens(text), 400)
+
+    def test_offline_and_running_turns_do_not_offer_new_progression_goals(self):
+        info = self.info()
+        self.assertNotIn('serverPlay', info.focused_view(mode='running'))
+        info.online = False
+        self.assertNotIn('serverPlay', info.focused_view())
+
+    def test_player_welcome_text_cannot_supply_server_command_routes(self):
+        data = welcome_frame(texts=['居民事务板 /mycli world erase'])
+        data['state']['server']['welcome']['messages'][0]['source'] = 'player'
+        info = GameObservations()
+        info.ingest_state(data)
+        self.assertNotIn('serverPlay', info.focused_view())
+
+
+class ServerPlayDecisionTests(unittest.IsolatedAsyncioTestCase):
+    async def test_observation_allows_server_progression_without_forcing_a_body_task(self):
+        service = GameAgentService(logger=None, push_message_fn=lambda **_: None)
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        service._client = SimpleNamespace(is_connected=True)
+        service._unattended._status['state'] = 'existing_session'
+        service._game_observations.ingest_state(gameplay_frame())
+        decision, instruction = service.observation_decision()
+        self.assertIn('minecraft_server', decision.get('nextToolsIfAuthorized', []))
+        self.assertIn('serverPlay', instruction)
+
+    async def test_real_idle_cue_keeps_progression_and_does_not_force_an_extra_body_action(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.set_lang('zh')
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        service._game_observations.ingest_state(gameplay_frame())
+        service._last_task_outcome = {'task': '制作铁镐', 'status': 'ok', 'text': '获得 iron_pickaxe'}
+        service.record_server_command({'command': '/mycli cast home', 'status': 'received',
+                                       'messages': ['已生效，传送到村庄']})
+        self.assertTrue(await service._fire_keep_going_nudge())
+        text = calls[-1]['parts'][0]['text']
+        self.assertIn('/mycli world board', text)
+        self.assertIn('/mycli guild join', text)
+        self.assertIn('试炼', text)
+        self.assertIn('真实回执', text)
+        self.assertLessEqual(count_tokens(text), 1000)
