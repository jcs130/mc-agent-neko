diff --git a/plugin/plugins/game_agent_minecraft/test_task_authority.py b/plugin/plugins/game_agent_minecraft/test_task_authority.py
new file mode 100644
index 0000000..1bc026f
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_task_authority.py
@@ -0,0 +1,57 @@
+import unittest
+
+from utils.tokenize import count_tokens
+from plugin.plugins.game_agent_minecraft import MINECRAFT_TASK_DESCRIPTION, MINECRAFT_TASK_SCHEMA
+
+
+class TaskAuthorityTests(unittest.TestCase):
+    def test_action_contract_is_bounded_for_local_tool_selection(self):
+        self.assertLessEqual(count_tokens(MINECRAFT_TASK_DESCRIPTION), 750)
+        self.assertLessEqual(len(MINECRAFT_TASK_DESCRIPTION), 3000)
+
+    def authority_section(self, name):
+        marker = name + ' — '
+        self.assertIn(marker, MINECRAFT_TASK_DESCRIPTION)
+        return MINECRAFT_TASK_DESCRIPTION.split(marker, 1)[1].split('\n\n', 1)[0]
+
+    def test_explicit_user_requests_preserve_wording_and_coordinate_fidelity(self):
+        explicit = self.authority_section('EXPLICIT USER REQUEST')
+        self.assertIn('exact original wording', explicit)
+        self.assertIn('most recent', explicit)
+        self.assertIn('relative wording', explicit)
+        self.assertIn('coordinates only when the user explicitly requested', explicit)
+        self.assertIn('older request', explicit)
+
+    def test_autonomous_authority_allows_fresh_recovery_without_replaying_tasks(self):
+        autonomous = self.authority_section('ONGOING AUTONOMOUS PLAY')
+        self.assertRegex(autonomous, r'until the user stops\s+or pauses')
+        self.assertIn('fresh game facts and actual outcomes', autonomous)
+        self.assertIn('resolve a missing prerequisite or recover', autonomous)
+        self.assertIn('received coordinates', autonomous)
+        self.assertIn('do not blindly repeat', autonomous)
+        self.assertIn('CALL this tool', autonomous)
+        self.assertNotIn('unless master explicitly', autonomous)
+        self.assertNotIn('NEVER call back, recover, retry', MINECRAFT_TASK_DESCRIPTION)
+
+    def test_parameter_description_gives_both_authority_modes(self):
+        task = MINECRAFT_TASK_SCHEMA['properties']['task']['description']
+        self.assertIn('explicit user', task)
+        self.assertIn('autonomous', task)
+        self.assertIn('fresh facts', task)
+        self.assertNotIn('Never add in-game coordinates unless master', task)
+
+    def test_busy_protection_and_actual_outcomes_remain_part_of_the_contract(self):
+        description = MINECRAFT_TASK_DESCRIPTION
+        self.assertIn('Do not copy raw commands or log lines', description)
+        self.assertIn('acceptance is not completion', description)
+        self.assertIn('deny/unknown', description)
+        self.assertIn('overwrite=true', description)
+        self.assertIn('imminent danger', description)
+        self.assertIn('Stationary crafting and model latency do not justify interruption', description)
+        self.assertIn('not for a better autonomous plan', description)
+        self.assertIn('minecraft_observe', description)
+        self.assertIn('minecraft_chat', description)
+
+
+if __name__ == '__main__':
+    unittest.main()
