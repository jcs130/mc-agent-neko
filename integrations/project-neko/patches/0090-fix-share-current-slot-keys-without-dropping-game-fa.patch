@@ -10,6 +10,37 @@ from .observations import GameObservations
 
 
 class GameEvidenceTest(unittest.TestCase):
+    def test_current_slot_tables_keep_all_values_positions_and_exact_original_paths(self):
+        info = self.observations()
+        inventory = [{'slot': n + 9, 'name': 'cobblestone', 'count': n + 1,
+                      'customName': f'完整物品{n}', 'lore': ['完整说明' * 200]} for n in range(37)]
+        inventory += [{'slot': 46, 'count': None}, {'slot': 47}]
+        window = [{'slot': n, 'name': 'iron_pickaxe', 'count': 1,
+                   'displayName': '铁镐', 'lore': ['完整耐久说明' * 100]} for n in range(87)]
+        info.state['inventory']['slots'] = inventory
+        info.state['window'] = {'id': 5, 'type': 'generic_9x6', 'title': '大背包',
+                                'cursor': None, 'slots': window}
+        before = json.dumps(info.view(), ensure_ascii=False, sort_keys=True)
+        view = decision_input(info)
+        for name, original in (('inventory', inventory), ('window', window)):
+            with self.subTest(section=name):
+                encoded = view['state'][name]['slots']
+                self.assertTrue(isinstance(encoded, dict), 'repeated slot field names should be shared')
+                self.assertEqual(encoded['encoding'], 'columns_with_snapshot_index')
+                self.assertEqual(encoded['detailsPath'], f'/state/{name}/slots')
+                restored = [None] * encoded['entries']
+                for group in encoded['groups']:
+                    for row in group['rows']:
+                        restored[row[0]] = dict(zip(group['columns'], row[1:]))
+                self.assertEqual(restored, original, 'all slots, original order and missing/null keys survive')
+                for index, row in enumerate(original):
+                    raw = info.evidence.read(view['rawEvidence']['id'], f'{encoded["detailsPath"]}/{index}')
+                    self.assertEqual(raw['value'], row)
+                self.assertLess(len(json.dumps(encoded, ensure_ascii=False)), len(json.dumps(original, ensure_ascii=False)))
+        self.assertEqual(view['state']['window']['id'], 5)
+        self.assertEqual(view['state']['window']['title'], '大背包')
+        self.assertEqual(json.dumps(info.view(), ensure_ascii=False, sort_keys=True), before)
+
