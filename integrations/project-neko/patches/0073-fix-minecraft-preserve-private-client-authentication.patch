                 return False
@@ -345,6 +349,18 @@ class GameObservations:
             resources['woodOmitted'] = len(wood) - 6
         return resources
 
+    def authentication(self):
+        """Connection-scoped client receipt; never derive login from a chat line."""
+        server = self.state.get('server')
+        auth = server.get('authentication') if isinstance(server, dict) else None
+        if not self.fresh or not isinstance(auth, dict) or auth.get('status') not in {
+                'waiting_for_challenge', 'not_ready', 'configuration_missing_or_invalid', 'disabled',
+                'submitted', 'send_failed', 'authenticated', 'spawned_after_submission', 'rejected',
+                'credential_blocked', 'retry_limited', 'disconnected'}:
+            return None
+        return {'owner': 'client', 'status': auth['status'],
+                **{key: auth.get(key) is True for key in ('submitted', 'serverConfirmed', 'worldSpawned')}}
+
     def server_welcome(self):
         server = self.state.get('server')
         welcome = server.get('welcome') if isinstance(server, dict) else None
@@ -361,9 +377,12 @@ class GameObservations:
         welcome = self.server_welcome()
         if not welcome or max_tokens < 256:
             return []
-        header = ('[Server login/gameplay reference received on this connection. '
