diff --git a/plugin/plugins/game_agent_minecraft/test_authentication_context.py b/plugin/plugins/game_agent_minecraft/test_authentication_context.py
new file mode 100644
index 0000000..7fd5678
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_authentication_context.py
@@ -0,0 +1,118 @@
+import unittest
+
+from .observations import GameObservations
+from .service import GameAgentService
+from .test_observations import frame, event
+
+
+def authenticated_frame(seq=1):
+    data = frame(seq=seq)
+    data['state']['server']['authentication'] = {
+        'status': 'authenticated', 'submitted': True,
+        'serverConfirmed': True, 'worldSpawned': True,
+    }
+    return data
+
+
+class AuthenticationContextTests(unittest.IsolatedAsyncioTestCase):
+    def test_live_authentication_survives_all_modes_and_tight_budgets(self):
+        observations = GameObservations()
+        observations.ingest_state(authenticated_frame())
+        for mode in ('decision', 'running', 'social', 'survival'):
+            for budget in (256, 350, 700):
+                with self.subTest(mode=mode, budget=budget):
+                    value = observations.focused_view(mode=mode, max_tokens=budget)
+                    self.assertEqual(value['authentication']['status'], 'authenticated')
+                    self.assertTrue(value['authentication']['serverConfirmed'])
+                    self.assertTrue(value['authentication']['worldSpawned'])
+                    self.assertEqual(value['authentication']['owner'], 'client')
+
+    def test_unconfirmed_submission_or_unknown_auth_cannot_become_logged_in(self):
+        observations = GameObservations()
+        data = authenticated_frame()
+        data['state']['server']['authentication'].update(status='submitted', serverConfirmed=False, worldSpawned=False)
+        observations.ingest_state(data)
+        self.assertFalse(observations.focused_view()['authentication']['serverConfirmed'])
+        unknown = frame(seq=2)
+        observations.ingest_state(unknown)
+        self.assertNotIn('authentication', observations.focused_view())
+        self.assertNotIn('authentication', observations.focused_view(max_tokens=256))
+
+    def test_stale_or_cross_session_auth_is_not_retained_as_current(self):
+        clock = [1000.0]
+        observations = GameObservations(clock=lambda: clock[0])
+        data = authenticated_frame()
+        data['observedAt'] = 1000000
+        observations.ingest_state(data)
+        clock[0] += 46
+        self.assertNotIn('authentication', observations.focused_view())
+        next_session = frame(session='next', observedAt=clock[0] * 1000)
+        observations.ingest_state(next_session)
+        self.assertNotIn('authentication', observations.focused_view())
+
+    def test_auth_control_steps_do_not_reset_an_idle_retry_lease(self):
+        observations = GameObservations()
+        data = authenticated_frame()
+        observations.ingest_state(data)
+        revision = observations.decision_revision
+        for seq, marker in enumerate(('LOGIN', 'PASSWORD_OK', 'SUCCESS'), 2):
+            data = authenticated_frame(seq=seq)
+            data['recentEvents'] = [event(f'fixture:auth:{seq}', 'system', f'[MC_AUTH_{marker}] 登录提示',
+                source='server', data={'authenticationControl': True, 'position': 'system', 'sender': None})]
+            observations.ingest_state(data)
+            self.assertEqual(observations.decision_revision, revision)
+
+    async def test_auth_controls_do_not_wake_narration_but_players_and_game_errors_do(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        data = authenticated_frame()
+        data['recentEvents'] = [event('fixture:auth', 'system', '[MC_AUTH_LOGIN] 请先登录：/login 密码',
+            source='server', data={'authenticationControl': True, 'position': 'system', 'sender': None})]
+        await service._on_game_state(data)
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+        # An auth-looking player message must never be silenced by the adapter.
+        player = authenticated_frame(seq=2)
+        player['recentEvents'] = [event('fixture:player', 'chat', 'YUI 你好，需要帮忙吗？',
+            source='player', player='MC_AUTH_SUCCESS', data={'onlinePlayer': True})]
+        await service._on_game_state(player)
+        self.assertTrue(any(call['ai_behavior'] == 'respond' for call in calls))
+        if service._game_attention_flush_task:
+            service._game_attention_flush_task.cancel()
+        calls.clear()
+        other = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        data = authenticated_frame()
+        data['recentEvents'] = [event('fixture:denial', 'system', '此处是保护建筑，无法挖掘。',
+            source='server', data={'position': 'system'})]
+        await other._on_game_state(data)
+        self.assertTrue(any(call['ai_behavior'] == 'respond' for call in calls))
+
+    async def test_auth_transition_updates_passive_context_once_without_another_model_wakeup(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        data = authenticated_frame()
+        data['state']['server']['authentication'].update(status='submitted', serverConfirmed=False, worldSpawned=False)
+        await service._on_game_state(data)
+        calls.clear()
+        await service._on_game_state(authenticated_frame(seq=2))
+        reads = [call for call in calls if call['ai_behavior'] == 'read']
+        self.assertTrue(any('authenticated' in call['parts'][0]['text'] for call in reads))
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+        calls.clear()
+        await service._on_game_state(authenticated_frame(seq=3))
+        self.assertEqual(calls, [])
+
+    def test_welcome_reference_is_explicitly_historical_and_uses_current_auth_facts(self):
+        observations = GameObservations()
+        data = authenticated_frame()
+        data['state']['server']['welcome'] = {'sessionId': 'fixture', 'messages': [
+            {'id': 'fixture:guide', 'source': 'server', 'kind': 'system',
+             'text': '离线账号先登录；输入 /mycli quests 查看委托。', 'observedAt': data['observedAt']} ]}
+        observations.ingest_state(data)
+        text = '\n'.join(part['text'] for part in observations.welcome_context_parts())
+        self.assertIn('historical', text)
+        self.assertIn('authenticated', text)
+        self.assertIn('/mycli quests', text)
+
+
+if __name__ == '__main__':
+    unittest.main()
