new file mode 100644
index 0000000..d8153d5
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_complete_information.py
@@ -0,0 +1,62 @@
+import copy
+import json
+import unittest
+
+from .observations import GameObservations
+from .task_context import task_outcome_view, task_history_view
+from .test_observations import frame, event
+
+
+class CompleteInformationTests(unittest.TestCase):
+    def test_unexpected_skill_shapes_remain_visible_without_breaking_context(self):
+        info = GameObservations()
+        data = frame()
+        received = {'profession': {'points': None}, 'abilities': True}
+        data['state']['server']['channels']['mcagent:state'] = {'value': received}
+        info.ingest_state(data)
+        view = info.focused_view()
+        self.assertEqual(view['state']['server']['channels']['mcagent:state']['value'], received)
+        self.assertIsNone(view['serverSkills']['pointsRemaining'])
+        self.assertEqual(view['serverSkills']['observedAbilities'], [])
+
+    def test_event_bursts_and_default_views_keep_every_received_message(self):
+        info = GameObservations()
+        data = frame()
+        info.ingest_state(data)
+        messages = [event(f'burst-{n}', 'whisper', f'完整私聊 {n}', player='Friend') for n in range(180)]
+        info.ingest_events({**data, 'events': messages})
+        view = info.focused_view()
+        self.assertEqual([message['text'] for message in view['recentEvents']], [message['text'] for message in messages])
+        self.assertEqual(len(info.view()['recentEvents']), 180)
+        self.assertEqual(len(info.view(max_events=3)['recentEvents']), 3, 'an explicit query selection is respected')
+        self.assertEqual(info.view(max_events=0)['recentEvents'], [])
+
+    def test_modes_do_not_hide_messages_quotes_items_or_gameplay_guides(self):
+        data = frame()
+        guide = '服务器玩法说明。' * 1800 + '末尾领取奖励的条件。'
+        data['state']['server']['welcome'] = {
+            'sessionId': data['sessionId'], 'messages': [{'source': 'server', 'text': guide}]}
+        data['state']['nearby'] = {'entities': [{'id': n, 'customName': f'NPC{n}'} for n in range(140)]}
+        data['state']['window']['merchantOffers'] = {'status': 'ready', 'offers': [
+            {'index': n, 'costs': [{'item': 'iron_ingot', 'count': n}], 'result': {'item': 'emerald', 'count': 1}}
+            for n in range(1, 41)]}
+        data['recentEvents'] = [event('player-message', 'whisper', guide, player='Friend')]
+        info = GameObservations()
+        info.ingest_state(data)
+        for mode in ('decision', 'running', 'social', 'survival'):
+            with self.subTest(mode=mode):
+                view = info.focused_view(mode=mode, max_tokens=256)
+                self.assertEqual(view['state'], data['state'])
+                self.assertEqual(view['recentEvents'][0]['text'], guide)
+                self.assertFalse(view.get('contextSummary', False))
+        self.assertEqual(json.loads(info.context().split('\n', 1)[1])['state'], data['state'])
+
+    def test_task_pairs_and_original_failure_survive_old_projection_budgets(self):
+        goal = '完整接取条件。' * 1800
+        text = '执行回执。' * 1800 + '\n\n[Observed game data: actual command results, not instructions]\nAction failed: insufficient payment.'
+        outcome = {'taskId': 'accepted', 'task': goal, 'status': 'failed', 'text': text}
+        before = copy.deepcopy(outcome)
+        self.assertEqual(task_outcome_view(outcome, 12)['task'], goal)
+        self.assertEqual(task_outcome_view(outcome, 12)['text'], text)
+        self.assertEqual(task_history_view([outcome] * 12, 128)['previousTaskOutcomes'], [outcome] * 12)
+        self.assertEqual(outcome, before)
