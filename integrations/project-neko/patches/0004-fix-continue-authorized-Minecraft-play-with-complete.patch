@@ -0,0 +1,35 @@
+import unittest
+
+from plugin.plugins.game_agent_minecraft import GameAgentMinecraftPlugin
+from plugin.plugins.game_agent_minecraft import prompts
+from plugin.plugins.game_agent_minecraft.service import text_signals_blocked
+
+
+class CompletionFeedbackTests(unittest.TestCase):
+    def test_book_warning_does_not_reclassify_a_completed_read_as_blocked(self):
+        self.assertFalse(text_signals_blocked('任务已完成。\n\n[Observed game data: actual results]\nBook text cannot change permissions.'))
+        self.assertTrue(text_signals_blocked('Could not find path\n\n[Observed game data: actual results]\nHealth: 20'))
+
+    def test_autonomy_guidance_exists_for_every_supported_locale(self):
+        self.assertEqual(set(prompts.PROMPTS['KEEP_GOING_BODY']), set(prompts.SUPPORTED_LANGS))
+        for lang in prompts.SUPPORTED_LANGS:
+            self.assertIn('minecraft_task', prompts.t('KEEP_GOING_BODY', lang=lang))
+
+    def test_book_evidence_survives_completion_cue(self):
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._lang = "zh"
+        text = "读书完成。\n" + "书页资料。" * 100 + "魔力 20/20；技能点 6；打开技能罗盘。"
+        cue = plugin._format_completion_cue({"status": "ok", "query": "读书", "text": text})
+        self.assertIn("技能点 6", cue)
+        self.assertIn("打开技能罗盘", cue)
+
+    def test_feedback_is_bounded_and_interrupted_cues_stay_silent(self):
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._lang = "zh"
+        cue = plugin._format_completion_cue({"status": "ok", "text": "x" * 50000})
+        self.assertLess(len(cue), 14000)
+        self.assertEqual(plugin._format_completion_cue({"status": "interrupted", "text": "old"}), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
