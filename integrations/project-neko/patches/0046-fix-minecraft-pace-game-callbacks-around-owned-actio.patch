+import json
+import unittest
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+from utils.tokenize import count_tokens
+from .service import GameAgentService
+from .test_observations import frame, event
+
+
+class ExecutionPacingTests(unittest.IsolatedAsyncioTestCase):
+    def service(self, *, busy=False):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        service._client = SimpleNamespace(is_connected=True)
+        if busy:
+            service._pending = SimpleNamespace(task_text='采集木材', start_time=1000, task_id='task-A')
+            service._task_finished = False
+        return service, calls
+
+    async def test_running_progress_only_updates_cache_after_initial_reference(self):
+        service, calls = self.service(busy=True)
+        for seq in range(1, 10):
+            data = frame(seq=seq)
+            data['state']['inventory']['counts']['oak_log'] = seq
+            await service._on_game_state(data)
+            await service._fire_in_progress_nudge()
+            await service._fire_system_prompt()
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(calls[0]['ai_behavior'], 'read')
+        self.assertEqual(calls[0]['metadata']['expires_in_s'], 45)
+        self.assertEqual(service._game_observations.state['inventory']['counts']['oak_log'], 9)
+        await service._fire_keep_going_nudge()
+        self.assertEqual(len(calls), 1, 'busy execution must not invite a new physical goal')
+
+    async def test_private_chat_is_social_only_and_does_not_claim_or_replace_body(self):
+        service, calls = self.service(busy=True)
+        pending = service._pending
+        await service._on_game_state(frame(recentEvents=[event('private', 'whisper', '你在忙什么？', player='Friend_1')]))
+        responses = [call for call in calls if call['ai_behavior'] == 'respond']
+        self.assertEqual(len(responses), 1)
+        text = responses[0]['parts'][0]['text']
+        self.assertIn('Friend_1', text)
+        self.assertIn('Social-only turn', text)
+        self.assertIn('do not call minecraft_task', text)
+        self.assertIs(service._pending, pending)
+        self.assertEqual(responses[0]['metadata']['expires_in_s'], 45)
+        self.assertLessEqual(count_tokens(text), 1000)
+
+    async def test_public_chat_waits_for_idle_and_is_not_starved_by_a_long_action(self):
+        service, calls = self.service(busy=True)
+        clock = [1000.0]
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]):
+            await service._on_game_state(frame(recentEvents=[event('public', 'chat', '矿洞入口在东边', player='Friend_1')]))
+            self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+            clock[0] += 180
+            service._pending = None
+            service._task_finished = True
+            await service._on_game_state(frame(seq=2))
+            service._queue_deferred_chat_when_idle()
+            await service._push_game_context(attention=True)
+        responses = [call for call in calls if call['ai_behavior'] == 'respond']
+        self.assertEqual(len(responses), 1)
+        self.assertIn('矿洞入口在东边', responses[0]['parts'][0]['text'])
+        self.assertEqual(service._deferred_game_chat, {})
+
+    async def test_busy_routine_feedback_is_cached_but_independent_denial_still_wakes(self):
+        service, calls = self.service(busy=True)
+        data = frame(recentEvents=[event('progress', 'system', '委托完成，奖励已领取')])
+        await service._on_game_state(data)
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+        denied = event('deny', 'protection', '原有建筑受保护', data={'status': 'deny', 'action': 'break'})
+        await service._on_game_events({**data, 'events': [denied]})
+        self.assertEqual(len([call for call in calls if call['ai_behavior'] == 'respond']), 1)
+
+    async def test_solicited_protection_never_creates_a_second_busy_decision(self):
+        service, calls = self.service(busy=True)
+        await service._on_game_state(frame(recentEvents=[event('reply', 'protection', '原有建筑受保护',
+            data={'status': 'deny', 'solicitedCommand': '/mycli protect break 1 2 3'})]))
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+
+    async def test_running_survival_recovery_is_not_reissued_for_same_threshold(self):
+        service, calls = self.service(busy=True)
+        clock = [1000.0]
+        module = 'plugin.plugins.game_agent_minecraft.service'
+        with patch(module + '.time.time', lambda: clock[0]):
+            await service._on_vitals({'hp': 16, 'food': 8, 'hostiles': 0})
+            clock[0] += 35
+            await service._on_vitals({'hp': 16, 'food': 8, 'hostiles': 0})
+            self.assertEqual(len(calls), 1)
+            await service._on_vitals({'hp': 6, 'food': 8, 'hostiles': 1})
+            self.assertEqual(len(calls), 2, 'new critical danger must remain immediate')
+
+    async def test_default_observe_is_bounded_and_explicit_section_preserves_full_pages(self):
+        service, _ = self.service()
+        service._client = None
+        data = frame()
+        pages = '服务器完整玩法说明' * 400
+        data['state']['window']['slots'][0]['components']['pages'] = [pages]
+        await service._on_game_state(data)
+        service._last_task_outcome = {'task': '此前动作' * 100, 'status': 'failed', 'text': 'long failure ' * 200}
+        service._recent_task_outcomes = [{'task': 'old' * 100, 'status': 'failed', 'text': 'result' * 1000}] * 8
+        service.record_server_command({'command': '/mycli skills list', 'status': 'received', 'messages': [pages]})
+        compact = await service.observe_game()
+        self.assertLessEqual(count_tokens(json.dumps(compact, ensure_ascii=False)), 1600)
+        self.assertIn('decision', compact)
+        self.assertEqual(compact['lastTaskOutcome']['status'], 'failed')
+        self.assertLessEqual(len(compact['recentTaskOutcomes']), 1)
+        explicit = await service.observe_game(['window'], 0)
+        self.assertEqual(explicit['state']['window']['slots'][0]['components']['pages'][0], pages)
+
+    async def test_using_held_item_also_prevents_idle_decisions(self):
+        service, calls = self.service()
+        data = frame()
+        data['state']['activity'] = {'action': None, 'skill': None, 'digging': None, 'usingHeldItem': True}
+        await service._on_game_state(data)
+        await service._fire_keep_going_nudge()
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+
+    async def test_large_attention_preserves_senders_and_stays_inside_callback_budget(self):
+        service, calls = self.service(busy=True)
+        await service._on_game_state(frame(recentEvents=[
+            event('private-1', 'whisper', '这是一条很长的真实玩家私聊' * 80, player='Friend_1'),
+            event('private-2', 'whisper', '这是另一个玩家发来的求助消息' * 80, player='Friend_2')]))
+        cue = [call for call in calls if call['ai_behavior'] == 'respond'][0]['parts'][0]['text']
+        self.assertIn('Friend_1', cue)
+        self.assertIn('Friend_2', cue)
+        self.assertIn('这是一条很长的真实玩家私聊', cue)
+        self.assertIn('这是另一个玩家发来的求助消息', cue)
+        self.assertLessEqual(count_tokens(cue), 1000)
+
+    async def test_busy_default_observe_keeps_supplies_and_survival_cue_has_focused_context(self):
+        service, calls = self.service(busy=True)
+        service._client = None
+        data = frame()
+        data['state']['self']['food'] = 7
+        data['state']['inventory']['counts']['bread'] = 2
+        await service._on_game_state(data)
+        observed = await service.observe_game()
+        self.assertIn('bread', json.dumps(observed, ensure_ascii=False))
+        await service._on_vitals({'hp': 10, 'food': 7, 'hostiles': 1})
+        cue = [call for call in calls if call['coalesce_key'] == 'mc_survival'][0]['parts'][0]['text']
+        self.assertIn('bread', cue)
+        self.assertLessEqual(count_tokens(cue), 1000)
+
+    async def test_unicode_history_and_deferred_chat_share_default_observe_budget(self):
+        service, _ = self.service(busy=True)
+        service._client = None
+        await service._on_game_state(frame(recentEvents=[
+            event('public-1', 'chat', '铁矿🪨' * 300, player='Friend_1'),
+            event('public-2', 'chat', '村庄🏠' * 300, player='Friend_2')]))
+        service._last_task_outcome = {'task': '采矿🪨' * 300, 'status': 'failed', 'text': '阻挡🧱' * 1000}
+        service._recent_task_outcomes = [service._last_task_outcome] * 8
+        service.record_server_command({'command': '/mycli ' + '帮助📚' * 300,
+                                       'status': 'received', 'messages': ['服务器📚' * 1000]})
+        observed = await service.observe_game()
+        self.assertLessEqual(count_tokens(json.dumps(observed, ensure_ascii=False)), 1600)
+        self.assertEqual(observed['lastTaskOutcome']['status'], 'failed')
+        self.assertIn('阻挡', observed['lastTaskOutcome']['text'])
+        self.assertEqual({item['player'] for item in observed['deferredPlayerMessages']}, {'Friend_1', 'Friend_2'})
+        self.assertIn('decision', observed)
+        service._pending, service._task_finished = None, True
+        service._client = SimpleNamespace(is_connected=True, request_game_state=AsyncMock(return_value=False))
+        service._game_observations.state['activity'] = {'action': None, 'skill': None, 'digging': None}
+        idle_observed = await service.observe_game()
+        self.assertEqual(idle_observed['decision']['status'], 'ready_if_authorized')
+        self.assertLessEqual(count_tokens(json.dumps(idle_observed, ensure_ascii=False)), 1600)
+
+    async def test_attention_budget_does_not_spend_tokens_on_opaque_event_ids(self):
+        service, calls = self.service(busy=True)
+        service.set_lang('zh')
+        await service._on_game_state(frame(recentEvents=[
+            event('🔒' * 160, 'whisper', '怎么绕开保护🧱' * 100, player='LongPlayerName_01'),
+            event('🪨' * 160, 'whisper', '矿洞入口求助🪨' * 100, player='LongPlayerName_02')]))
+        cue = [call for call in calls if call['ai_behavior'] == 'respond'][0]['parts'][0]['text']
