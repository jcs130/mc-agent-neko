@@ -314,9 +314,26 @@ class GameObservations:
             for index, chunk in enumerate(chunks, 1):
                 key = hashlib.sha256(json.dumps([self.session_id, ident, kind, original, index],
                                                 ensure_ascii=False).encode()).hexdigest()[:32]
-                output.append({'key': key, 'text': render(chunk, index, len(chunks))})
