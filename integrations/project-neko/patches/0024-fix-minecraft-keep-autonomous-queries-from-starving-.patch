diff --git a/plugin/plugins/game_agent_minecraft/test_query_loop.py b/plugin/plugins/game_agent_minecraft/test_query_loop.py
new file mode 100644
index 0000000..970fbdc
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_query_loop.py
@@ -0,0 +1,83 @@
+import json
+import unittest
+
+from utils.tokenize import count_tokens
+
+from .observations import GameObservations
+from .service import GameAgentService
+from .test_observations import frame, event
+
+
+class QueryLoopTests(unittest.IsolatedAsyncioTestCase):
+    def service(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.set_lang('zh')
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        return service, calls
+
+    def test_telemetry_does_not_hide_actionable_server_text(self):
+        info = GameObservations()
+        info.ingest_state(frame(recentEvents=[
+            event('fixture:ore', 'system', '探矿术找到青金石矿 X=-595 Y=60 Z=-474'),
+            event('fixture:tick1', 'plugin_message', '', data={'channel': 'mcagent:state'}),
+            event('fixture:tick2', 'plugin_message', '', data={'channel': 'mcagent:state'}),
+        ]))
+        self.assertIn('X=-595 Y=60 Z=-474', info.context())
+
+    async def test_server_replies_survive_next_idle_turn_and_are_available_for_full_read(self):
+        service, calls = self.service()
+        await service._on_game_state(frame())
+        service.record_server_command({'command': '/mycli cast prospect', 'status': 'received',
+                                       'messages': ['探矿术找到青金石矿 X=-595 Y=60 Z=-474']})
+        await service._fire_keep_going_nudge()
+        await service._fire_keep_going_nudge()
+        for call in calls[-2:]:
+            text = call['parts'][0]['text']
+            self.assertIn('X=-595 Y=60 Z=-474', text)
+            self.assertIn('minecraft_task', text)
+            self.assertLessEqual(count_tokens(text), 950)
+        observed = await service.observe_game(['server'], 0)
+        self.assertEqual(observed['lastServerCommands'][0]['messages'][0], '探矿术找到青金石矿 X=-595 Y=60 Z=-474')
+        self.assertEqual(service.get_status()['server_calls_since_task'], 1)
+        self.assertIn('minecraft_task', service.server_action_hint())
+
+    async def test_task_claim_resets_query_streak_and_new_connection_forgets_old_replies(self):
+        service, calls = self.service()
+        await service._on_game_state(frame())
+        for n in range(5):
+            service.record_server_command({'command': f'/mycli skills info skill{n}', 'status': 'received', 'messages': [f'guide {n}']})
+        self.assertEqual(len(service._server_command_history), 3)
+        self.assertEqual(service.get_status()['server_calls_since_task'], 5)
+        pending = await service.try_claim_pending('走到安全地点', overwrite=False)
+        self.assertIsNotNone(pending)
+        self.assertEqual(service.get_status()['server_calls_since_task'], 0)
+        self.assertEqual(service.server_action_hint(), '')
+        await service._on_game_state(frame(session='new-connection'))
+        self.assertEqual(service._server_command_history, [])
+
+    async def test_action_cue_keeps_budget_and_last_outcome_with_large_received_data(self):
+        service, calls = self.service()
+        data = frame()
+        data['state']['server']['protection'] = {'enabled': True, 'installed': True}
+        await service._on_game_state(data)
+        service._last_task_outcome = {'task': '此前动作' * 80, 'status': 'failed', 'text': 'failure ' * 200}
+        service.record_server_command({'command': '/mycli spells list 1', 'status': 'received', 'messages': ['技能说明' * 2000]})
+        await service._fire_keep_going_nudge()
+        text = calls[-1]['parts'][0]['text']
+        self.assertLessEqual(count_tokens(text), 950)
+        self.assertIn('minecraft_task', text)
+        self.assertIn('failed', text)
+
+    def test_installed_guard_is_visible_without_requiring_duplicate_manual_break_check(self):
+        info = GameObservations()
+        data = frame()
+        data['state']['server']['protection'] = {'enabled': True, 'installed': True}
+        info.ingest_state(data)
+        summary = json.loads(info.context().split('\n', 1)[1])
