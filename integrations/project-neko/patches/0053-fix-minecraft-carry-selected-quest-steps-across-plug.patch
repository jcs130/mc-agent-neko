                     value['serverPlay'] = play
             if welcome and welcome.get('messages'):
@@ -309,11 +309,32 @@ def build_focused_view(info, *, mode='decision', max_events=6, max_tokens=1600,
                 if key.endswith('Omitted'):
                     resources.pop(key)
         value['detailsRequired'] = True
+    if (count_tokens(render()) > max_tokens and
+            value.get('protection', {}).get('automaticDigChecks') is True):
+        # The executor rechecks every dig. Keep an actual scoped denial ahead
+        # of a historical tentative allowance for a different coordinate.
+        value['protection'].pop('lastCheck', None)
+        value['detailsRequired'] = True
+    if count_tokens(render()) > max_tokens and value.get('serverPlay', {}).get('focus'):
+        # An ongoing server goal outranks entrances to unrelated activities.
+        for key in ('trial', 'guild'):
+            if count_tokens(render()) > max_tokens:
+                value['serverPlay']['routes'].pop(key, None)
+                value['detailsRequired'] = True
     if count_tokens(render()) > max_tokens:
         for key in ('named', 'wood', 'pickaxes'):
             if key in resources and count_tokens(render()) > max_tokens:
                 resources[key] = {'details': 'minecraft_observe(detail="full",sections=["inventory"])'}
         value['detailsRequired'] = True
+    if count_tokens(render()) > max_tokens:
+        # Three identical inventory pointers cost more than useful facts.
+        # Name the omitted groups once; the callback header supplies the tool.
+        missing = [key for key in ('named', 'wood', 'pickaxes')
+                   if isinstance(resources.get(key), dict) and 'details' in resources[key]]
+        if missing:
+            for key in missing:
+                resources.pop(key)
+            resources['omitted'] = missing
     if count_tokens(render()) > max_tokens:
         # Only adversarial/extreme source labels reach this branch. Preserve
         # freshness and vitals and make the lack of detail unambiguous.
