@@ -199,7 +199,7 @@ def build_focused_view(info, *, mode='decision', max_events=6, max_tokens=1600,
                 compact['server'] = {'scoreboards': titles}
             welcome = info.server_welcome()
             if mode == 'decision':
-                play = received_play_routes(welcome, inv)
+                play = received_play_routes(welcome, inv, server, info.clock())
