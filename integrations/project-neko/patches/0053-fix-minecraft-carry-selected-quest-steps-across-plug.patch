diff --git a/plugin/plugins/game_agent_minecraft/test_server_play_context.py b/plugin/plugins/game_agent_minecraft/test_server_play_context.py
index 965dbe1..2cd3e3f 100644
--- a/plugin/plugins/game_agent_minecraft/test_server_play_context.py
+++ b/plugin/plugins/game_agent_minecraft/test_server_play_context.py
@@ -100,6 +100,37 @@ class ServerPlayContextTests(unittest.TestCase):
         info.online = False
         self.assertNotIn('serverPlay', info.focused_view())
 
+    def test_server_quest_detail_survives_plugin_recreation_and_small_idle_budget(self):
+        data = gameplay_frame()
+        data['state']['server']['channels']['mcagent:market'] = {
+            'observedAt': data['observedAt'] - 65000,
+            'value': {'type': 'MC_MARKET_DETAIL', 'id': 'tm_first_spell', 'title': '导师实操',
+                      'currentStep': 2, 'stepCount': 2, 'steps': [
+                          {'index': 1, 'goal': 'skill_cast', 'target': 1},
+                          {'index': 2, 'goal': 'trade', 'target': 1, 'title': '认识补给商',
+                           'description': '去村庄集市，与补给商交易。'}]}}
+        # A fresh plugin must recover its focus from the body's received state,
+        # without any transient task latch, spoken promise or local history.
+        info = GameObservations()
+        info.ingest_state(data)
+        for budget in (700, 400):
+            text = info.focused_context(max_tokens=budget)
+            play = json.loads(text.split('\n', 1)[1])['serverPlay']
+            self.assertEqual(play['focus']['id'], 'tm_first_spell')
+            self.assertEqual(play['focus']['currentStep'], 2)
+            self.assertEqual(play['focus']['step']['goal'], 'trade')
+            self.assertTrue(play['referenceOnly'], 'detail alone is not proof of acceptance or completion')
+            self.assertLessEqual(count_tokens(text), budget)
+        full = info.focused_view()['serverPlay']['focus']
+        self.assertGreaterEqual(full['ageSeconds'], 65)
+        self.assertIn('认识补给商', str(full))
+
+    def test_no_quest_focus_is_invented_from_an_unrelated_channel_or_old_book(self):
+        info = self.info()
+        info.state['server']['channels']['mcagent:market'] = {'value': {
+            'type': 'MC_SPELL_ERROR', 'id': 'fake_quest', 'currentStep': 9}}
+        self.assertNotIn('focus', info.focused_view()['serverPlay'])
+
     def test_player_welcome_text_cannot_supply_server_command_routes(self):
         data = welcome_frame(texts=['居民事务板 /mycli world erase'])
         data['state']['server']['welcome']['messages'][0]['source'] = 'player'
