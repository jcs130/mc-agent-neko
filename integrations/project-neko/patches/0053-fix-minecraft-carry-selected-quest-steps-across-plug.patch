 _TOPICS = (
@@ -16,7 +17,7 @@ _TOPICS = (
 _COMMAND = re.compile(r'/mycli(?:[ \t]+(?:[a-z_][a-z0-9_:-]*|[0-9]+|<[a-z_][a-z0-9_]*>))*', re.I)
 
 
-def received_play_routes(welcome, inventory):
+def received_play_routes(welcome, inventory, server=None, now=None):
     routes, ranks = {}, {}
 
     def add(text, location):
@@ -55,7 +56,40 @@ def received_play_routes(welcome, inventory):
                     type(item.get('slot')) is not int):
                 continue
             add(str(page.get('text') or ''), f'inventory slot={item["slot"]} page={page["page"]}')
-    return {'referenceOnly': True, 'routes': routes} if routes else None
+    # The body keeps the last server detail packet even if this plugin is
+    # recreated. Carry the selected quest, not just the general entry points.
+    # A detail response alone does NOT establish acceptance/current completion.
+    packet = ((server or {}).get('channels') or {}).get('mcagent:market') or {}
+    detail = packet.get('value') if isinstance(packet, dict) else None
+    focus = None
+    if (isinstance(detail, dict) and detail.get('type') == 'MC_MARKET_DETAIL' and
+            isinstance(detail.get('id'), str) and 0 < len(detail['id']) <= 64 and
+            not any(ord(char) < 32 for char in detail['id'])):
+        focus = {'id': detail['id'][:64], 'source': 'mcagent:market'}
+        if isinstance(detail.get('title'), str):
+            focus['title'] = detail['title'][:64]
+        for key in ('currentStep', 'stepCount'):
+            if type(detail.get(key)) is int and 1 <= detail[key] <= 1000:
+                focus[key] = detail[key]
+        steps = detail.get('steps')
+        for step in steps[:64] if isinstance(steps, list) else []:
+            if (not isinstance(step, dict) or type(step.get('index')) is not int or
+                    step['index'] != focus.get('currentStep')):
+                continue
+            focus['step'] = {key: child[:112] if isinstance(child, str) else child
+                             for key in ('index', 'title', 'description', 'goal', 'target', 'site')
+                             if isinstance((child := step.get(key)), str) or type(child) is int}
+            break
+        stamp = packet.get('observedAt')
+        if (type(stamp) in (int, float) and math.isfinite(stamp) and
+                type(now) in (int, float) and math.isfinite(now)):
+            focus['ageSeconds'] = max(0, round(now - stamp / 1000))
+    if not routes and not focus:
+        return None
+    play = {'referenceOnly': True, 'routes': routes}
+    if focus:
+        play['focus'] = focus
+    return play
 
 
