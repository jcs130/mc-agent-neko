diff --git a/plugin/plugins/game_agent_minecraft/test_player_action_coupling.py b/plugin/plugins/game_agent_minecraft/test_player_action_coupling.py
new file mode 100644
index 0000000..27ca265
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_player_action_coupling.py
@@ -0,0 +1,230 @@
+import asyncio
+import json
+import unittest
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock, patch
+
+import websockets
+
+from . import GameAgentMinecraftPlugin
+from .client import GameAgentClient
+from .service import GameAgentService
+from .test_observations import event, frame
+
+
+class PlayerActionCouplingTests(unittest.IsolatedAsyncioTestCase):
+    def fixture(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        data = frame()
+        data['state']['activity'] = {'action': None, 'skill': None, 'digging': None}
+        service._game_observations.ingest_state(data)
+        service._client = SimpleNamespace(is_connected=True, send_task=AsyncMock(return_value=True),
+                                         send_chat=AsyncMock(return_value={'status': 'echoed'}))
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._lang, plugin._service = 'zh', service
+        plugin._ensure_service_started = AsyncMock(return_value=True)
+        plugin._completion_for_test = asyncio.Event()
+        plugin._on_detached_task_done = Mock(side_effect=lambda _: plugin._completion_for_test.set())
+        plugin.logger = SimpleNamespace(warning=Mock())
+        self.addAsyncCleanup(self.cleanup, service)
+        return plugin, service, calls
+
+    async def cleanup(self, service):
+        if service._pending:
+            service._pending.result = {'status': 'interrupted'}
+            service._pending.event.set()
+        if service._game_attention_flush_task:
+            service._game_attention_flush_task.cancel()
+        await asyncio.sleep(0)
+
+    async def pending(self, service):
+        async with asyncio.timeout(2):
+            while service._pending is None or not service._pending.dispatched:
+                await asyncio.sleep(0.001)
+        return service._pending
+
+    async def test_idle_player_invitation_can_plan_and_act_in_the_same_callback(self):
+        _, service, calls = self.fixture()
+        data = frame(seq=2, recentEvents=[event('invitation', 'whisper', '一起去矿洞吗？', player='Friend_1')])
+        data['state']['activity'] = {'action': None, 'skill': None, 'digging': None}
+        await service._on_game_state(data)
+        response = next(call for call in calls if call['ai_behavior'] == 'respond')
+        self.assertTrue(response['coalesce_key'].startswith('mc_game_interaction:'))
+        self.assertNotIn('Social-only turn', response['parts'][0]['text'])
+        self.assertIn('reply', response['parts'][0]['text'])
+
+    async def test_busy_player_invitation_keeps_existing_owner_and_has_no_immediate_promise(self):
+        _, service, calls = self.fixture()
+        current = await service.try_claim_pending('正在采集', overwrite=False)
+        await service._on_game_state(frame(seq=2, recentEvents=[
+            event('busy-invitation', 'whisper', '过来帮忙', player='Friend_1')]))
+        response = next(call for call in calls if call['ai_behavior'] == 'respond')
+        self.assertTrue(response['coalesce_key'].startswith('mc_game_attention:'))
+        self.assertIn('Social-only turn', response['parts'][0]['text'])
+        self.assertIn('promise', response['parts'][0]['text'])
+        self.assertIs(service._pending, current)
+
+    async def test_player_reply_waits_for_native_acceptance_not_transport_send(self):
+        plugin, service, _ = self.fixture()
+        pending_reply = asyncio.create_task(plugin.minecraft_task(
+            task='沿现有通道到矿洞入口', reply='我来试试，入口见。', player='Friend_1'))
+        await asyncio.sleep(0.02)
+        self.assertFalse(pending_reply.done(), 'claim/send alone cannot publish the promise')
+        service._client.send_chat.assert_not_called()
+        pending = service._pending
+        await service._on_task_accepted({'task_id': 'foreign', 'phase': 'planning'})
+        service._client.send_chat.assert_not_called()
+        await service._on_task_accepted({'task_id': pending.task_id, 'phase': 'planning'})
+        result = await asyncio.wait_for(pending_reply, 1)
+        self.assertEqual(result['status'], 'accepted')
+        self.assertTrue(result['nativeAccepted'])
+        self.assertEqual(result['communication']['status'], 'echoed')
+        self.assertEqual(result['task_id'], pending.task_id)
+        service._client.send_chat.assert_awaited_once_with('我来试试，入口见。', 'Friend_1')
+
+    async def test_failed_task_cannot_publish_its_intended_reply(self):
+        plugin, service, _ = self.fixture()
+        service._client.send_task = AsyncMock(return_value=False)
+        result = await plugin.minecraft_task(task='前往入口', reply='我马上去', player='Friend_1')
+        self.assertEqual(result['communication']['status'], 'not_sent')
+        self.assertFalse(result['nativeAccepted'])
+        self.assertEqual(result['status'], 'failed')
+        self.assertFalse(result['pending'])
+        service._client.send_chat.assert_not_called()
+
+    async def test_busy_coupled_task_never_overwrites_or_sends_a_promise(self):
+        plugin, service, _ = self.fixture()
+        current = await service.try_claim_pending('正常长动作', overwrite=False)
+        for overwrite in (False, True):
+            result = await plugin.minecraft_task(task='前往入口', reply='我马上去',
+                                                 player='Friend_1', overwrite=overwrite)
+            self.assertEqual(result['communication']['status'], 'not_sent')
+            self.assertIs(service._pending, current)
+        service._client.send_task.assert_not_called()
+        service._client.send_chat.assert_not_called()
+
+    async def test_invalid_reply_is_rejected_before_claiming_a_body(self):
+        plugin, service, _ = self.fixture()
+        for reply, player in [('x' * 181, 'Friend_1'), ('马上去', 'bad/name'), (None, 'Friend_1')]:
+            result = await plugin.minecraft_task(task='前往入口', reply=reply, player=player)
+            self.assertEqual(result['communication']['status'], 'not_sent')
+            self.assertIsNone(service._pending)
+        service._client.send_task.assert_not_called()
+
+    async def test_no_native_acceptance_returns_explicit_unsent_receipt(self):
+        plugin, service, _ = self.fixture()
+        with patch('plugin.plugins.game_agent_minecraft.interaction.ACCEPTANCE_TIMEOUT', 0.01):
+            result = await plugin.minecraft_task(task='前往入口', reply='我来试试', player='Friend_1')
+        self.assertEqual(result['communication']['status'], 'not_sent')
+        self.assertEqual(result['communication']['reason'], 'native_acceptance_unconfirmed')
+        self.assertIsNotNone(service._pending, 'unknown acknowledgement does not cancel the action')
+        service._client.send_chat.assert_not_called()
+
+    async def test_completion_and_exact_history_keep_the_peer_and_ack_receipt(self):
+        plugin, service, _ = self.fixture()
+        pending_reply = asyncio.create_task(plugin.minecraft_task(task='前往入口', reply='我来试试', player='Friend_1'))
+        await asyncio.sleep(0.02)
+        pending = service._pending
+        await service._on_task_accepted({'task_id': pending.task_id, 'phase': 'planning'})
+        await pending_reply
+        await service._on_task_finished({'task_id': pending.task_id, 'status': 'failed', 'text': 'No path'})
+        await asyncio.wait_for(plugin._completion_for_test.wait(), 2)
+        original = service._last_task_outcome
+        self.assertEqual(original['gameInteraction']['player'], 'Friend_1')
+        self.assertEqual(original['gameInteraction']['communication']['status'], 'echoed')
+        done_task = plugin._on_detached_task_done.call_args.args[0]
+        cue = plugin._format_completion_cue(done_task.result())
+        self.assertIn('Friend_1', cue)
+        self.assertIn('接手不等于完成', cue)
+        self.assertIn('minecraft_chat', cue)
+        service._client.send_chat.assert_awaited_once()
+
+    async def test_failed_private_ack_does_not_retry_publicly_or_cancel_the_action(self):
+        plugin, service, _ = self.fixture()
+        service._client.send_chat = AsyncMock(return_value={'status': 'failed', 'reason': 'unavailable'})
+        pending_reply = asyncio.create_task(plugin.minecraft_task(task='前往入口', reply='我来试试', player='Friend_1'))
+        await asyncio.sleep(0.02)
+        pending = service._pending
+        await service._on_task_accepted({'task_id': pending.task_id, 'phase': 'planning'})
+        result = await pending_reply
+        self.assertEqual(result['communication']['status'], 'failed')
+        self.assertIs(service._pending, pending)
+        service._client.send_chat.assert_awaited_once_with('我来试试', 'Friend_1')
+
+    async def test_ordinary_chat_is_still_possible_while_body_busy(self):
+        plugin, service, _ = self.fixture()
+        pending = await service.try_claim_pending('采集木材', overwrite=False)
+        result = await plugin.minecraft_chat(text='你好，我正在忙一会儿。', player='Friend_1')
+        self.assertEqual(result['status'], 'echoed')
+        self.assertIs(service._pending, pending)
+
+    async def test_stop_or_session_change_before_acceptance_sends_no_agreement(self):
+        for race in ('stop', 'session', 'completed'):
+            with self.subTest(race=race):
+                plugin, service, _ = self.fixture()
+                turn = asyncio.create_task(plugin.minecraft_task(task='前往入口', reply='我来试试', player='Friend_1'))
+                pending = await self.pending(service)
+                if race == 'stop':
+                    service._unattended.enabled = False
+                elif race == 'session':
+                    data = frame(seq=2)
+                    data['sessionId'] = 'new-connection'
+                    service._game_observations.ingest_state(data)
+                else:
+                    await service._on_task_finished({'task_id': pending.task_id, 'status': 'failed', 'text': 'No path'})
+                # Release the waiter even if this connection's ACK is now invalid.
+                await service._on_task_accepted({'task_id': pending.task_id, 'phase': 'planning'})
+                pending.acceptance_event.set()
+                result = await asyncio.wait_for(turn, 2)
+                self.assertEqual(result['communication']['status'], 'not_sent')
+                service._client.send_chat.assert_not_called()
+
+    async def test_cancelling_reply_wait_does_not_cancel_owned_action_or_leave_waiters(self):
+        plugin, service, _ = self.fixture()
+        turn = asyncio.create_task(plugin.minecraft_task(task='前往入口', reply='我来试试', player='Friend_1'))
+        pending = await self.pending(service)
+        turn.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await turn
+        self.assertIs(service._pending, pending)
+        self.assertFalse(pending.event.is_set())
+        service._client.send_chat.assert_not_called()
+        pending.result = {'status': 'interrupted'}
+        pending.event.set()
+        await asyncio.wait_for(plugin._completion_for_test.wait(), 2)
+
+    async def test_real_loopback_transport_correlates_acceptance_before_private_chat(self):
+        plugin, service, _ = self.fixture()
+        received = []
+
+        async def controller(ws):
+            async for raw in ws:
+                message = json.loads(raw)
+                received.append(message)
+                if message['type'] == 'task':
+                    await ws.send(json.dumps({'type': 'task_accepted', 'task_id': 'foreign', 'phase': 'planning'}))
+                    await ws.send(json.dumps({'type': 'task_accepted', 'task_id': message['task_id'], 'phase': 'planning'}))
+                elif message['type'] == 'chat':
+                    await ws.send(json.dumps({'type': 'chat_result', 'request_id': message['request_id'], 'status': 'echoed'}))
+
+        async with websockets.serve(controller, '127.0.0.1', 0) as server:
+            port = server.sockets[0].getsockname()[1]
+            client = GameAgentClient(f'ws://127.0.0.1:{port}', on_task_accepted=service._on_task_accepted)
+            service._client = client
+            runner = asyncio.create_task(client.start())
+            try:
+                async with asyncio.timeout(3):
+                    while not client.is_connected:
+                        await asyncio.sleep(0.001)
+                result = await plugin.minecraft_task(task='前往入口', reply='我来试试', player='Friend_1')
+                self.assertTrue(result['nativeAccepted'])
+                self.assertEqual(result['communication']['status'], 'echoed')
+                self.assertEqual([m['type'] for m in received], ['task', 'chat'])
+                self.assertEqual(received[1]['player'], 'Friend_1')
+                self.assertEqual(received[0]['task_id'], result['task_id'])
+                self.assertFalse(service._pending.event.is_set(), 'chat echo is not task completion')
+            finally:
+                await client.stop()
+                await asyncio.wait_for(runner, 2)
