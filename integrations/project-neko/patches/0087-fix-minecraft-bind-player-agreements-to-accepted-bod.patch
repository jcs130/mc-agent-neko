diff --git a/plugin/plugins/game_agent_minecraft/interaction.py b/plugin/plugins/game_agent_minecraft/interaction.py
new file mode 100644
index 0000000..6ac5045
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/interaction.py
@@ -0,0 +1,49 @@
+"""Tie a player-facing agreement to one controller-owned game task."""
+import asyncio
+import re
+
+ACCEPTANCE_TIMEOUT = 3.0
+
+
+def validate_reply(text, player):
+    if not isinstance(text, str) or not text.strip() or len(text) > 180:
+        return 'reply must contain 1-180 characters'
+    if player is not None and (not isinstance(player, str) or not re.fullmatch(r'[A-Za-z0-9_]{1,16}', player)):
+        return 'player must be an exact Minecraft username'
+    return None
+
+
+def unsent(reason):
+    return {'status': 'not_sent', 'reason': reason}
+
+
+async def acknowledge_task(service, pending, runner, text, player):
+    """Acceptance is mission ownership/planning, never movement/completion.
+
+    A legacy executor without acceptance support leaves the acknowledgement
+    unconfirmed; it must not turn a successful socket send into a promise.
+    """
+    accepted = asyncio.create_task(pending.acceptance_event.wait())
+    ended = asyncio.create_task(pending.event.wait())
+    try:
+        await asyncio.wait({accepted, ended, runner}, timeout=ACCEPTANCE_TIMEOUT,
+                           return_when=asyncio.FIRST_COMPLETED)
+    finally:
+        for waiter in (accepted, ended):
+            if not waiter.done():
+                waiter.cancel()
+        await asyncio.gather(accepted, ended, return_exceptions=True)
+    if runner.done() or pending.event.is_set() or service._pending is not pending:
+        return unsent('task_ended_before_reply')
+    if not pending.native_accepted or not pending.dispatched:
+        return unsent('native_acceptance_unconfirmed')
+    if service._game_observations.session_id != pending.session_id:
+        return unsent('game_session_changed')
+    if (not service._unattended.enabled or service._unattended.status.get('state') == 'stopped'):
+        return unsent('autonomy_stopped')
+    if not service._client or not service._client.is_connected:
+        return unsent('disconnected')
+    try:
+        return await service._client.send_chat(text, player)
+    except Exception as exc:
+        return {'status': 'unknown', 'reason': type(exc).__name__}
