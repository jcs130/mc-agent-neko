 SUPPORTED_LANGS: tuple[str, ...] = ("zh", "zh-TW", "en", "ja", "ko", "ru", "es", "pt")
 
 
+def spoken_language_policy(lang: str) -> str:
+    """Separate spoken wording from exact execution IDs and received evidence."""
+    if not str(lang).startswith('zh'):
+        return ''
+    return ('播報全用中文，英文物品、技能、狀態和報錯先翻譯，優先用遊戲或伺服器給的中文名，不念欄位、代碼或命令；'
+            'raw_iron=粗鐵，hay_block=乾草捆。工具參數與玩家名保留原文，別復述規則。') if lang == 'zh-TW' else (
+        '播报全用中文，英文物品、技能、状态和报错先翻译，优先用游戏或服务器给的中文名，不念字段、代码或命令；'
+        'raw_iron=粗铁，hay_block=干草捆。工具参数与玩家名保留原文，别复述规则。')
+
+
 def t(key: str, *, lang: str | None = None, **fmt: Any) -> str:
     """Resolve a prompt by key + locale, with optional ``str.format`` substitutions.
 
