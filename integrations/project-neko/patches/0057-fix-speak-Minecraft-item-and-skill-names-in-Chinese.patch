+    def _push_message(self, **kwargs):
+        # Responding turns feed speech generation. Keep passive evidence and
+        # exact IDs untouched, and never add a translation inference call.
+        policy = prompts.spoken_language_policy(self._lang)
+        if kwargs.get('ai_behavior') == 'respond' and policy:
+            parts = list(kwargs.get('parts') or [])
+            for index, part in enumerate(parts):
+                if isinstance(part, dict) and part.get('type') == 'text' and part.get('text'):
+                    if policy not in part['text']:
+                        parts[index] = {**part, 'text': policy + '\n' + part['text']}
+                        kwargs = {**kwargs, 'parts': parts}
+                    break
+        return self._push_message_fn(**kwargs)
+
