diff --git a/plugin/plugins/game_agent_minecraft/test_spoken_language.py b/plugin/plugins/game_agent_minecraft/test_spoken_language.py
new file mode 100644
index 0000000..272ec53
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_spoken_language.py
@@ -0,0 +1,93 @@
+import copy
+import unittest
+
+from utils.tokenize import count_tokens
+from . import GameAgentMinecraftPlugin, prompts
+from .service import GameAgentService
+from .test_observations import frame
+from .test_grounded_recovery import crowded_frame
+
+
+class SpokenLanguageTests(unittest.IsolatedAsyncioTestCase):
+    def service(self, lang='zh'):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.set_lang(lang)
+        return service, calls
+
+    async def test_active_cue_requests_chinese_before_raw_evidence_without_mutating_ids(self):
+        service, calls = self.service()
+        data = {'ai_behavior': 'respond', 'priority': 7, 'parts': [
+            {'type': 'text', 'text': 'raw_iron=14; FREE; balance=0; !equip("iron_pickaxe"); Player_1'}]}
+        before = copy.deepcopy(data)
+        service._push_message(**data)
+        text = calls[-1]['parts'][0]['text']
+        self.assertTrue(text.startswith(prompts.spoken_language_policy('zh')))
+        self.assertIn('先翻译', text)
+        self.assertIn('技能', text)
+        self.assertIn('服务器给的中文名', text)
+        self.assertIn('工具参数与玩家名保留原文', text)
+        self.assertTrue(text.endswith(data['parts'][0]['text']))
+        self.assertEqual(data, before)
+        self.assertEqual(calls[-1]['priority'], 7)
+
+    async def test_passive_facts_and_non_chinese_locales_are_unmodified(self):
+        for lang, behavior in [('zh', 'read'), ('en', 'respond'), ('ja', 'respond')]:
+            service, calls = self.service(lang)
+            data = {'ai_behavior': behavior, 'parts': [{'type': 'text', 'text': 'coal=64; status=FREE'}]}
+            service._push_message(**data)
+            self.assertEqual(calls[-1], data)
+
+    async def test_active_message_policy_is_added_once_and_language_switch_is_current(self):
+        service, calls = self.service()
+        policy = prompts.spoken_language_policy('zh')
+        service._push_message(ai_behavior='respond', parts=[{'type': 'text', 'text': policy + '\nraw_iron'}])
+        self.assertEqual(calls[-1]['parts'][0]['text'].count(policy), 1)
+        service.set_lang('zh-TW')
+        service._push_message(ai_behavior='respond', parts=[{'type': 'text', 'text': 'hay_block'}])
+        self.assertTrue(calls[-1]['parts'][0]['text'].startswith(prompts.spoken_language_policy('zh-TW')))
+
+    async def test_idle_decision_includes_policy_and_reserves_callback_budget(self):
+        service, calls = self.service()
+        service.configure({'unattended_enabled': True, 'unattended_character': 'YUI'})
+        service._game_observations.ingest_state(crowded_frame())
+        await service._fire_keep_going_nudge()
+        text = calls[-1]['parts'][0]['text']
+        self.assertIn(prompts.spoken_language_policy('zh'), text)
+        self.assertLessEqual(count_tokens(text), 1000)
+
+    async def test_completion_policy_precedes_english_results_and_stays_within_host_cap(self):
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._lang = 'zh'
+        cue = plugin._format_completion_cue({'status': 'ok', 'query': '核对物品',
+            'text': 'Inventory: raw_iron 14; hay_block; balance 0. ' * 120,
+            'inventory': {'raw_iron': 14, 'coal': 64}})
+        self.assertIn(prompts.spoken_language_policy('zh'), cue)
+        self.assertLess(cue.index('先翻译'), cue.index('Inventory:'))
+        self.assertLessEqual(count_tokens(cue), 1000)
+        self.assertEqual(plugin._format_completion_cue({'status': 'interrupted'}), '')
+
+    async def test_player_reply_trigger_uses_chinese_policy_without_renaming_sender(self):
+        from .test_observations import event
+        service, calls = self.service()
+        await service._on_game_state(frame(recentEvents=[event('english-name', 'whisper', 'Hello', player='Player_1')]))
+        text = next(call for call in calls if call['ai_behavior'] == 'respond')['parts'][0]['text']
+        self.assertIn(prompts.spoken_language_policy('zh'), text)
+        self.assertIn('Player_1', text)
+        self.assertIn('Hello', text)
+
+    async def test_crowded_player_reply_reserves_policy_budget_and_keeps_full_evidence(self):
+        from .test_observations import event
+        service, calls = self.service()
+        data = crowded_frame()
+        message = 'Need an iron_pickaxe to use flame_burst near the village. ' * 60
+        data['recentEvents'] = [event('long-whisper-1', 'whisper', message, player='Friend_1'),
+                                event('long-whisper-2', 'whisper', message, player='Friend_2')]
+        await service._on_game_state(data)
+        text = next(call for call in calls if call['ai_behavior'] == 'respond')['parts'][0]['text']
+        self.assertIn(prompts.spoken_language_policy('zh'), text)
+        self.assertIn('Friend_1', text)
+        self.assertIn('Friend_2', text)
+        self.assertLessEqual(count_tokens(text), 1000)
+        cached = service._game_observations.view()['recentEvents']
+        self.assertEqual([item['text'] for item in cached], [message, message])
