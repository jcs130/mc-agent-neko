 import copy
 import json
 import unittest
+from unittest.mock import AsyncMock
 
 from utils.tokenize import count_tokens
 
@@ -195,3 +196,35 @@ class FocusedContextTests(unittest.TestCase):
         self.assertIn('Body execution is still busy', cue)
         self.assertIn('Do not call minecraft_task', cue)
         self.assertLessEqual(count_tokens(cue), 1000)
+
+
+class ObservationToolDetailTests(unittest.IsolatedAsyncioTestCase):
+    async def test_section_list_does_not_accidentally_request_large_raw_components(self):
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._ensure_service_started = AsyncMock(return_value=True)
+        service = GameAgentService(logger=None, push_message_fn=lambda **_: None)
+        service.observe_game = AsyncMock(return_value={'contextSummary': True})
+        plugin._service = service
+        await plugin.minecraft_observe(sections=['inventory', 'server', 'nearby'])
+        service.observe_game.assert_awaited_once_with(None, 20)
+
+    async def test_explicit_full_detail_retains_targeted_reference_access(self):
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._ensure_service_started = AsyncMock(return_value=True)
+        service = GameAgentService(logger=None, push_message_fn=lambda **_: None)
+        service.observe_game = AsyncMock(return_value={'state': {'inventory': {'pages': ['完整书页']}}})
+        plugin._service = service
+        result = await plugin.minecraft_observe(sections=['inventory'], detail='full', max_events=0)
+        service.observe_game.assert_awaited_once_with(['inventory'], 0)
+        self.assertIn('完整书页', str(result))
+
+    async def test_full_detail_requires_an_explicit_reference_or_message_selection(self):
+        plugin = object.__new__(GameAgentMinecraftPlugin)
+        plugin._ensure_service_started = AsyncMock(return_value=True)
+        service = GameAgentService(logger=None, push_message_fn=lambda **_: None)
+        service.observe_game = AsyncMock(return_value={})
+        plugin._service = service
+        self.assertEqual((await plugin.minecraft_observe(detail='full'))['status'], 'failed')
+        service.observe_game.assert_not_awaited()
+        await plugin.minecraft_observe(detail='full', sections=[], max_events=48)
+        service.observe_game.assert_awaited_once_with([], 48)
