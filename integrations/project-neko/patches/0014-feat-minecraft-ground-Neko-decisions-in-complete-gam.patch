+import asyncio
+import json
+import time
+import unittest
+from unittest.mock import patch
+
+import websockets
+
+from .client import GameAgentClient
+from .observations import GameObservations
+from .service import GameAgentService
+
+
+def frame(seq=1, session='fixture', **kwargs):
+    return {'type': 'game_state', 'schemaVersion': 1, 'sessionId': session, 'seq': seq,
+            'observedAt': time.time() * 1000, 'online': True,
+            'state': {'self': {'position': {'x': 101, 'y': 17, 'z': 203}, 'health': 20, 'oxygen': 12},
+                      'world': {'dimension': 'overworld', 'timeOfDay': 14000},
+                      'inventory': {'counts': {'raw_iron': 12}, 'slots': []},
+                      'activity': {'mobility': {'state': 'POCKET'}},
+                      'server': {'scoreboards': [{'title': '任务进度', 'items': [{'name': '委托', 'value': 3}]}],
+                                 'channels': {'mcagent:state': {'value': {'mana': 20}}}},
+                      'window': {'title': '公会菜单', 'slots': [{'name': 'written_book', 'components': {'pages': ['完整任务说明']}}]}},
+            'recentEvents': [], **kwargs}
+
+
+def event(ident, kind, text, **kwargs):
+    return {'id': ident, 'kind': kind, 'text': text, 'observedAt': time.time() * 1000, **kwargs}
+
+
+class ObservationTests(unittest.IsolatedAsyncioTestCase):
+    def service(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.set_lang('zh')
+        return service, calls
+
+    async def test_legacy_vitals_preserve_position_equipment_mobility_and_inventory_for_decisions(self):
+        service, calls = self.service()
+        await service._on_vitals({'hp': 20, 'food': 20, 'hostiles': 0, 'x': 101, 'y': 17, 'z': 203,
+                                  'dim': 'overworld', 'held': 'stone_pickaxe', 'armor': 'iron_helmet',
+                                  'mob': 'POCKET', 'pickFx': 1, 'tod': 14000, 'inv': {'raw_iron': 12}})
+        self.assertEqual(service._last_vitals['x'], 101)
+        self.assertEqual(service._last_vitals['inv']['raw_iron'], 12)
+        await service._fire_keep_going_nudge()
+        text = calls[-1]['parts'][0]['text']
+        for evidence in ('101', 'POCKET', 'stone_pickaxe', 'raw_iron×12'):
+            self.assertIn(evidence, text)
+
+    async def test_all_state_sections_reach_passive_context_and_each_autonomous_decision(self):
+        service, calls = self.service()
+        await service._on_game_state(frame())
+        self.assertEqual(calls[-1]['ai_behavior'], 'read')
+        await service._fire_keep_going_nudge()
+        text = calls[-1]['parts'][0]['text']
+        for evidence in ('101', 'oxygen', 'overworld', 'raw_iron', 'POCKET', '任务进度', '公会菜单', 'mana'):
+            self.assertIn(evidence, text)
+
+    async def test_snapshot_and_event_batch_do_not_double_reply_and_long_private_text_survives(self):
+        service, calls = self.service()
+        message = '矿洞的求助说明' * 70 + '请从东边入口过来'
+        private = event('fixture:1', 'whisper', message, player='Friend_1')
+        initial = frame(recentEvents=[private])
+        await service._on_game_state(initial)
+        await service._on_game_events({**initial, 'type': 'game_events', 'events': [private]})
+        responses = [call for call in calls if call['ai_behavior'] == 'respond']
+        self.assertEqual(len(responses), 1)
+        self.assertIn(message, responses[0]['parts'][0]['text'])
+        self.assertIn('minecraft_chat', responses[0]['parts'][0]['text'])
+        self.assertIn('Friend_1', responses[0]['parts'][0]['text'])
+
+    async def test_server_feedback_and_plugin_events_reach_judgment_but_actionbar_is_passive(self):
+        service, calls = self.service()
+        initial = frame()
+        await service._on_game_state(initial)
+        events = [event('fixture:1', 'system', '技能失败，需要先装备法杖'),
+                  event('fixture:2', 'plugin_message', '', data={'channel': 'mcagent:event', 'value': {'phase': 'failed'}}),
+                  event('fixture:3', 'actionbar', '魔力 20/100')]
+        await service._on_game_events({**initial, 'events': events})
+        self.assertEqual(calls[-1]['ai_behavior'], 'respond')
+        self.assertIn('技能失败', calls[-1]['parts'][0]['text'])
+        self.assertIn('mcagent:event', calls[-1]['parts'][0]['text'])
+        before = len([call for call in calls if call['ai_behavior'] == 'respond'])
+        await service._on_game_events({**initial, 'events': [event('fixture:4', 'actionbar', '魔力 21/100')]})
+        self.assertEqual(len([call for call in calls if call['ai_behavior'] == 'respond']), before)
+
+    async def test_admin_command_is_observed_without_becoming_another_active_decision(self):
+        service, calls = self.service()
+        initial = frame()
+        await service._on_game_state(initial)
+        await service._on_game_events({**initial, 'events': [event('fixture:1', 'chat', '@neko follow',
+                                                                player='Friend_1', data={'reservedCommand': True})]})
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+
+    async def test_concurrent_attention_flushes_emit_each_pending_message_once(self):
+        service, calls = self.service()
+        await service._on_game_state(frame())
+        service._game_observations.ingest_events({**frame(), 'events': [event('fixture:1', 'whisper', '请帮忙', player='Friend_1')]})
+        service._game_attention_ids.add('fixture:1')
+        service._game_attention_pending = True
+        await asyncio.gather(service._push_game_context(attention=True), service._push_game_context(attention=True))
+        self.assertEqual(len([call for call in calls if call['ai_behavior'] == 'respond']), 1)
+
+    async def test_observe_queries_fresh_state_over_real_websocket_without_game_actions(self):
+        service, calls = self.service()
+        requests = []
+
+        async def handler(ws):
+            async for raw in ws:
+                request = json.loads(raw)
+                requests.append(request)
+                await ws.send(json.dumps(frame(seq=len(requests)), ensure_ascii=False))
+
+        async with websockets.serve(handler, '127.0.0.1', 0) as server:
+            port = server.sockets[0].getsockname()[1]
+            client = GameAgentClient(f'ws://127.0.0.1:{port}', on_game_state=service._on_game_state,
+                                     on_game_events=service._on_game_events)
+            service._client = client
+            task = asyncio.create_task(client.start())
+            try:
+                async with asyncio.timeout(3):
+                    while not service._game_observations.available:
+                        await asyncio.sleep(0.01)
+                result = await service.observe_game(['server', 'window'], max_events=0)
+                self.assertEqual(result['source'], 'live')
+                self.assertEqual(result['status'], 'ok')
+                self.assertEqual(set(result['state']), {'server', 'window'})
+                self.assertEqual(result['state']['window']['slots'][0]['components']['pages'][0], '完整任务说明')
+                self.assertTrue(all(request['type'] == 'query_game_state' for request in requests))
+            finally:
+                await client.stop()
+                await asyncio.wait_for(task, 2)
+                service._client = None
+
+    async def test_stale_or_offline_state_is_never_presented_as_current(self):
+        service, calls = self.service()
+        initial = frame()
+        await service._on_game_state(initial)
+        with patch('plugin.plugins.game_agent_minecraft.service.time.time', return_value=time.time() + 50):
+            view = service._game_observations.view()
+            self.assertFalse(view['fresh'])
+            self.assertIsNone(view['state'])
+        await service._on_game_state(frame(seq=2, online=False))
+        self.assertFalse(service._game_observations.view()['fresh'])
+        self.assertEqual(service._last_inventory_at, 0)
+
+    async def test_monotonic_snapshot_and_session_reset_prevent_old_world_context(self):
+        info = GameObservations()
+        self.assertTrue(info.ingest_state(frame(seq=2)))
+        old = frame(seq=1)
+        old['state']['self']['health'] = 1
+        self.assertFalse(info.ingest_state(old))
+        self.assertEqual(info.state['self']['health'], 20)
+        info.ingest_events({**frame(), 'events': [event('fixture:1', 'title', '旧世界任务')]})
+        self.assertTrue(info.ingest_state(frame(session='new-world')))
+        self.assertNotIn('旧世界任务', info.context())
+
+    async def test_recent_message_survives_large_state_and_truncation_is_reported(self):
+        info = GameObservations()
+        initial = frame()
+        initial['state']['server']['large'] = ['x' * 8000] * 100
+        latest = '紧急求助' * 200 + '在矿洞东边'
+        initial['recentEvents'] = [event('fixture:1', 'whisper', latest, player='Friend_1')]
+        info.ingest_state(initial)
+        self.assertIn(latest, info.context())
+        self.assertTrue(info.view()['truncated'])
+        self.assertLess(len(info.context().encode('utf-8')), 150000)
+
+    async def test_malformed_frames_do_not_overwrite_valid_observations(self):
+        info = GameObservations()
+        info.ingest_state(frame(seq=2))
+        for malformed in (frame(seq='bad'), frame(seq=1), frame(schemaVersion=999), frame(observedAt=float('nan')),
+                          frame(session='bad-new-session', seq='bad')):
+            self.assertFalse(info.ingest_state(malformed))
+        self.assertEqual(info.state['self']['health'], 20)
+
