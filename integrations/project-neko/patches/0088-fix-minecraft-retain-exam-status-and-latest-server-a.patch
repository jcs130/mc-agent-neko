diff --git a/plugin/plugins/game_agent_minecraft/test_query_progress.py b/plugin/plugins/game_agent_minecraft/test_query_progress.py
index b64a556..65698fd 100644
--- a/plugin/plugins/game_agent_minecraft/test_query_progress.py
+++ b/plugin/plugins/game_agent_minecraft/test_query_progress.py
@@ -91,6 +91,64 @@ class QueryProgressTests(unittest.TestCase):
         info.ingest_state(data)
         self.assertGreater(info.decision_revision, revision)
 
+    def test_exam_status_survives_an_empty_commission_report_and_catalogue(self):
+        info = self.info()
+        active = 'MC_GUILD_EXAM {"state":"active","examId":"inventory_basic","nextAction":"普通大背包存入并取回；通过木门和梯井"}'
+        info.record_server_reply('/mycli guild exam status', [active], 1000)
+        self.clock[0] += 3
+        info.record_server_reply('/mycli guild status', ['当前没有在办的委托。'], 1003)
+        info.record_server_reply('/mycli guild exam promotion', ['可开考目录，不是新任务。'], 1003)
+        progress = info.server_progress()
+        self.assertEqual(progress['messages'], ['当前没有在办的委托。'])
+        exam = progress['relatedStatusReplies'][0]
+        self.assertEqual(exam['command'], '/mycli guild exam status')
+        self.assertEqual(exam['messages'], [active])
+        self.assertEqual(exam['ageSeconds'], 3)
+        self.assertTrue(exam['historicalReply'])
+        current = json.loads(info.focused_context().split('\n', 1)[1])
+        self.assertIn(active, str(current['serverProgress']))
+        self.assertIn(active, str(current['serverPlay']['activeReport']))
+        self.data['sessionId'] = 'next-login'
+        info.ingest_state(self.data)
+        self.assertIsNone(info.server_progress())
+
+    def test_complete_status_reply_replaces_old_fragments_without_changing_other_scope(self):
+        info = self.info()
+        info.record_server_reply('/mycli guild status', ['委托进行中'], 1000)
+        info.record_server_reply('/mycli guild exam status', ['考试进行中'], 1000)
+        info.record_server_reply('/mycli guild exam status', ['考试完成'], 1001, complete=True)
+        info.record_server_reply('/mycli guild exam status', ['迟到的旧状态'], 999)
+        self.clock[0] = 1002
+        progress = info.server_progress()
+        self.assertEqual(progress['messages'], ['委托进行中'])
+        self.assertEqual(progress['relatedStatusReplies'][0]['messages'], ['考试完成'])
+
+    def test_last_server_action_receipt_survives_queries_without_clipping_or_success_inference(self):
+        from .service import GameAgentService
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: None)
+        service._game_observations = self.info()
+        refused = '未开始/未交付：task_slot_busy。先查看当前任务。' + '完整回执' * 3000
+        action = {'command': '/mycli guild exam start promotion inventory_basic',
+                  'status': 'received', 'readOnly': False, 'messages': [refused], 'records': []}
+        service.record_server_command(action)
+        service.record_server_command({'command': '/mycli guild exam status', 'status': 'received',
+            'readOnly': True, 'messages': ['考试仍进行中'], 'records': []})
+        context = json.loads(service.recovery_context().split(': ', 1)[1])
+        receipt = context['lastServerAction']
+        self.assertEqual(receipt['command'], action['command'])
+        self.assertEqual(receipt['status'], 'received')
+        exact = service._game_observations.evidence.read(
+            context['rawEvidence']['id'], receipt['messages']['path'])
+        self.assertEqual(exact['value'], [refused])
+        self.assertTrue(receipt['historicalReply'])
+        self.assertNotIn('success', receipt)
+        original = service._game_observations.evidence.read(
+            context['rawEvidence']['id'], '/lastServerCommands/1')
+        self.assertEqual(original['value']['messages'], [refused])
+        service._game_observations.session_id = 'different-login'
+        next_context = json.loads(service.recovery_context().split(': ', 1)[1])
+        self.assertNotIn('lastServerAction', next_context)
+
 
 if __name__ == '__main__':
     unittest.main()
