@@ -47,13 +47,13 @@ class GameObservations:
         self.dropped = 0
         self.decision_revision = 0
         self._fingerprint = None
-        self._progress_report = None
+        self._progress_reports = {}
         from .evidence import GameEvidence
         self.evidence = GameEvidence()
 
-    def record_server_reply(self, command, messages, observed_at=None):
+    def record_server_reply(self, command, messages, observed_at=None, *, complete=False):
         """Keep an actual status reply separately from browsed catalogues."""
-        if command != '/mycli guild status' or not isinstance(messages, list):
+        if command not in ('/mycli guild status', '/mycli guild exam status') or not isinstance(messages, list):
             return
         stamp = self.clock() if observed_at is None else observed_at
         if type(stamp) not in (int, float) or not math.isfinite(stamp):
@@ -61,21 +61,24 @@ class GameObservations:
         lines = [line for line in messages if isinstance(line, str) and line.strip()]
         if not lines:
             return
-        previous = self._progress_report
+        previous = self._progress_reports.get(command)
         if previous and stamp < previous['observedAt']:
             return
-        if previous and stamp - previous['observedAt'] <= 2:
+        if previous and not complete and stamp - previous['observedAt'] <= 2:
             lines = list(dict.fromkeys([*previous['messages'], *lines]))
-        self._progress_report = {'command': command, 'observedAt': stamp,
-                                 'messages': lines,
-                                 'truncated': False}
+        self._progress_reports[command] = {'command': command, 'observedAt': stamp,
+                                          'messages': lines, 'truncated': False}
 
     def server_progress(self):
-        report = self._progress_report
-        if not report or self.clock() < report['observedAt']:
+        reports = [{**report, 'ageSeconds': round(self.clock() - report['observedAt']),
+                    'historicalReply': True}
+                   for command in ('/mycli guild status', '/mycli guild exam status')
+                   if (report := self._progress_reports.get(command))
+                   and self.clock() >= report['observedAt']]
+        if not reports:
             return None
-        return {**report, 'ageSeconds': round(self.clock() - report['observedAt']),
-                'historicalReply': True}
+        return {**reports[0], **({'relatedStatusReplies': reports[1:]} if len(reports) > 1 else {}),
+                'scopeNote': 'Commission status and exam status cover different task scopes. An empty commission report does not establish an empty exam. These are exact historical replies; verify current state before relying on them.'}
 
     @property
     def fresh(self):
@@ -105,7 +108,7 @@ class GameObservations:
             self.online = False
             self.events.clear()
             self._fingerprint = None
-            self._progress_report = None
+            self._progress_reports.clear()
         self.available = True
         return True
 
