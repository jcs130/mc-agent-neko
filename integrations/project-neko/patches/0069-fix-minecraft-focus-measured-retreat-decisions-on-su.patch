+    def _native_retreat_handoff(self):
+        """Return only a fresh, explicitly idle, bounded native recovery window."""
+        info = self._game_observations
+        activity = info.state.get('activity') if info.fresh else None
+        keys = ('action', 'skill', 'digging', 'usingHeldItem')
+        if not isinstance(activity, dict) or not all(key in activity for key in keys) or any(activity.get(key) for key in keys):
+            return None
+        recovery = activity.get('recovery')
+        if isinstance(recovery, dict) and recovery.get('type') in (
+                'protected-retreat-stall', 'tool-retreat-stall'):
+            start, end = recovery.get('observedAt'), recovery.get('expiresAt')
+            if (type(start) in (int, float) and type(end) in (int, float)
+                    and start <= time.time() * 1000 < end <= start + 60000):
+                return recovery
+        return None
+
     def _mc_agent_busy(self) -> bool:
