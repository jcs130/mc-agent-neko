diff --git a/plugin/plugins/game_agent_minecraft/test_query_loop.py b/plugin/plugins/game_agent_minecraft/test_query_loop.py
index dd31bd9..370115c 100644
--- a/plugin/plugins/game_agent_minecraft/test_query_loop.py
+++ b/plugin/plugins/game_agent_minecraft/test_query_loop.py
@@ -1,6 +1,7 @@
 import json
 import time
 import unittest
+from types import SimpleNamespace
 
 from utils.tokenize import count_tokens
 
@@ -10,6 +11,31 @@ from .test_observations import frame, event
 
 
 class QueryLoopTests(unittest.IsolatedAsyncioTestCase):
+    async def test_idle_measured_retreat_selects_survival_context_and_goal_before_catalogues(self):
+        service, calls = self.service()
+        data = frame()
+        now = time.time() * 1000
+        data['state']['activity'] = {'action': None, 'skill': None, 'digging': None,
+            'usingHeldItem': False, 'recovery': {'type': 'protected-retreat-stall',
+            'observedAt': now - 1000, 'expiresAt': now + 59000}}
+        await service._on_game_state(data)
+        self.assertTrue(await service._fire_keep_going_nudge())
+        text = calls[-1]['parts'][0]['text']
+        self.assertIn('current physical priority', text)
+        self.assertIn('server_protection', text)
+        self.assertIn('"contextMode": "survival"', text)
+        self.assertNotIn('"contextMode": "decision"', text)
+        self.assertLessEqual(count_tokens(text), 950)
+        # Unknown/disconnected execution must not acquire a recovery goal.
+        self.assertNotIn('nativeRecovery', service.observation_decision()[0])
+        service._client = SimpleNamespace(is_connected=True)
+        decision, instruction = service.observation_decision()
+        self.assertEqual(decision['nativeRecovery']['constraint'], 'server_protection')
+        self.assertIn('before unrelated quest/catalogue', instruction)
+        service._unattended.enabled = False
+        decision, _ = service.observation_decision()
+        self.assertNotIn('nativeRecovery', decision)
+
     async def test_measured_idle_retreat_handoff_overrides_only_old_busy_latch(self):
