     # LLM via the standard push_message v2 channel.
     # ------------------------------------------------------------------
 
+    @llm_tool(
+        name="minecraft_chat",
+        description="Send plain chat to Minecraft players, independently of movement tasks. Use this to reply to in-game chat; a normal web reply is not sent to the game. Optional player selects a private whisper. Only status=echoed confirms a server echo; submitted means sent without confirmation. Never claim delivery for unknown/failed results. No slash commands.",
+        parameters={
+            "type": "object",
+            "properties": {
+                "text": {"type": "string", "maxLength": 180},
+                "player": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,16}$"},
+            },
+            "required": ["text"],
+        },
+        timeout=8.0,
+    )
+    async def minecraft_chat(self, *, text: Any = None, player: Any = None, **_):
+        if not isinstance(text, str) or not text.strip() or len(text) > 180:
+            return {"status": "failed", "reason": "text must contain 1-180 characters"}
+        if not await self._ensure_service_started():
+            return {"status": "failed", "reason": "disconnected"}
+        return await self._service._client.send_chat(text, player)
+
