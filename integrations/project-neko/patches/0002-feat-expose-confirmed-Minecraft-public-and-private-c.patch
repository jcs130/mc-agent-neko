+    async def send_chat(self, text: str, player: str | None = None) -> dict[str, Any]:
+        if self._ws is None or not self.is_connected:
+            return {"status": "failed", "reason": "disconnected"}
+        request_id = uuid.uuid4().hex
+        future = asyncio.get_running_loop().create_future()
+        self._chat_waiters[request_id] = future
+        try:
+            await self._ws.send(json.dumps({
+                "type": "chat", "text": text,
+                "player": player, "request_id": request_id,
+            }))
+            return await asyncio.wait_for(future, timeout=4.0)
+        except Exception as exc:
+            return {"status": "unknown", "reason": type(exc).__name__}
+        finally:
+            self._chat_waiters.pop(request_id, None)
+
