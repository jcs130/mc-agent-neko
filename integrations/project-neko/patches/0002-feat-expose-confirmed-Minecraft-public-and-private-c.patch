diff --git a/plugin/plugins/game_agent_minecraft/test_chat_bridge.py b/plugin/plugins/game_agent_minecraft/test_chat_bridge.py
new file mode 100644
index 0000000..31e5b4a
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_chat_bridge.py
@@ -0,0 +1,44 @@
+import asyncio
+import json
+import unittest
+
+import websockets
+
+from plugin.plugins.game_agent_minecraft.client import GameAgentClient
+
+
+class ChatBridgeTests(unittest.IsolatedAsyncioTestCase):
+    async def test_disconnected_is_not_reported_as_sent(self):
+        client = GameAgentClient('ws://127.0.0.1:1')
+        self.assertEqual((await client.send_chat('hello'))['status'], 'failed')
+
+    async def test_correlates_out_of_order_replies_without_gameplay_tasks(self):
+        seen = []
+
+        async def handler(ws):
+            for _ in range(2):
+                seen.append(json.loads(await ws.recv()))
+            for request in reversed(seen):
+                await ws.send(json.dumps({'type': 'chat_result', 'request_id': request['request_id'], 'status': 'echoed', 'tag': request['text']}))
+            await ws.wait_closed()
+
+        async with websockets.serve(handler, '127.0.0.1', 0) as server:
+            port = server.sockets[0].getsockname()[1]
+            client = GameAgentClient(f'ws://127.0.0.1:{port}')
+            runner = asyncio.create_task(client.start())
+            try:
+                async with asyncio.timeout(3):
+                    while not client.is_connected:
+                        await asyncio.sleep(0.01)
+                results = await asyncio.gather(client.send_chat('one'), client.send_chat('two', 'Friend_1'))
+                self.assertEqual([r['tag'] for r in results], ['one', 'two'])
+                self.assertEqual([r['type'] for r in seen], ['chat', 'chat'])
+                self.assertEqual(seen[1]['player'], 'Friend_1')
+                self.assertEqual(client._chat_waiters, {})
+            finally:
+                await client.stop()
+                await asyncio.wait_for(runner, timeout=2)
+
+
+if __name__ == '__main__':
+    unittest.main()
