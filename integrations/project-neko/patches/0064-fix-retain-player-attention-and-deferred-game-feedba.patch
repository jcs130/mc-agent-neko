diff --git a/plugin/plugins/game_agent_minecraft/test_player_perception.py b/plugin/plugins/game_agent_minecraft/test_player_perception.py
new file mode 100644
index 0000000..637f33f
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_player_perception.py
@@ -0,0 +1,121 @@
+import time
+import unittest
+from unittest.mock import AsyncMock
+from unittest.mock import patch
+
+from utils.tokenize import count_tokens
+from .decision_context import build_focused_view
+from . import test_execution_pacing
+from .test_observations import event, frame
+
+
+class PlayerPerceptionTests(unittest.IsolatedAsyncioTestCase):
+    def service(self, busy=False):
+        return test_execution_pacing.ExecutionPacingTests().service(busy=busy)
+
+    async def test_greeting_mention_and_whisper_reach_social_judgment_during_work(self):
+        for kind, text in (('chat', 'ag_NEKO 你好！'), ('chat', '[世界] YUI 在吗？'), ('whisper', '给你东西')):
+            service, calls = self.service(busy=True)
+            pending = service._pending
+            await service._on_game_state(frame(recentEvents=[event('greeting', kind, text, player='Friend_1')]))
+            cue = next(call for call in calls if call['ai_behavior'] == 'respond')
+            self.assertIn(text, cue['parts'][0]['text'])
+            self.assertIn('Friend_1', cue['parts'][0]['text'])
+            self.assertIn('Social-only turn', cue['parts'][0]['text'])
+            self.assertIs(service._pending, pending)
+
+    async def test_distinct_attention_batches_cannot_replace_each_other_in_the_host_queue(self):
+        service, calls = self.service(busy=True)
+        await service._on_game_state(frame(recentEvents=[event('one', 'whisper', '你好', player='Friend_1')]))
+        service._game_attention_at = 0
+        await service._on_game_events({**frame(), 'events': [event('two', 'whisper', '送你铁镐', player='Friend_2')]})
+        cues = [call for call in calls if call['ai_behavior'] == 'respond']
+        self.assertEqual(len(cues), 2)
+        self.assertNotEqual(cues[0]['coalesce_key'], cues[1]['coalesce_key'])
+        self.assertEqual(len({service._pending.task_id}), 1)
+
+    async def test_unsolicited_error_waits_with_full_evidence_until_idle(self):
+        service, calls = self.service(busy=True)
+        stamp = time.time()
+        feedback = event('error', 'system', '服务器报错：背包已满，物品未发放。', data={'operation': 'reward'})
+        with patch('plugin.plugins.game_agent_minecraft.service.time.time', return_value=stamp):
+            await service._on_game_state(frame(recentEvents=[feedback]))
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+        with patch('plugin.plugins.game_agent_minecraft.service.time.time', return_value=stamp + 180):
+            service._pending = None
+            service._task_finished = True
+            await service._on_game_state(frame(seq=2))
+            service._queue_deferred_chat_when_idle()
+            await service._push_game_context(attention=True)
+        cue = next(call for call in calls if call['ai_behavior'] == 'respond')
+        self.assertIn(feedback['text'], cue['parts'][0]['text'])
+        self.assertIn('reward', cue['parts'][0]['text'])
+
+    async def test_pickup_near_player_is_deferred_social_information_with_unknown_donor(self):
+        service, calls = self.service(busy=True)
+        pickup = event('pickup', 'item_pickup', 'ag_NEKO collected 1 iron_pickaxe. Donor unknown; verify inventory.',
+            player='ag_NEKO', data={'selfCollected': True, 'collectedCount': 1, 'donor': None,
+                'nearbyPlayers': ['Friend_1'], 'item': {'name': 'iron_pickaxe', 'count': 3}})
+        await service._on_game_state(frame(recentEvents=[pickup]))
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+        service._pending = None
+        service._task_finished = True
+        service._queue_deferred_chat_when_idle()
+        await service._push_game_context(attention=True)
+        cue = next(call for call in calls if call['ai_behavior'] == 'respond')
+        text = cue['parts'][0]['text']
+        for fact in ('iron_pickaxe', 'Friend_1', 'Donor unknown', 'Social-only turn'):
+            self.assertIn(fact, text)
+        self.assertLessEqual(count_tokens(text), 1000)
+
+    async def test_mining_pickups_and_ambient_drops_do_not_create_model_call_spam(self):
+        service, calls = self.service()
+        await service._on_game_state(frame(recentEvents=[
+            event('drop', 'item_drop', 'Nearby dropped item: cobblestone', data={'donor': None}),
+            event('pickup', 'item_pickup', 'collected cobblestone', data={'selfCollected': True, 'nearbyPlayers': []}),
+            event('other', 'item_pickup', 'Friend_1 collected iron_pickaxe', player='Friend_1',
+                data={'selfCollected': False, 'nearbyPlayers': ['Friend_1']})]))
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+        self.assertEqual(len(service._game_observations.view()['recentEvents']), 3)
+
+    async def test_social_view_keeps_player_equipment_and_identified_drop_ahead_of_ambient_mobs(self):
+        service, _ = self.service()
+        data = frame()
+        data['state']['nearby'] = {'entities': [
+            *[{'id': n, 'name': 'salmon', 'type': 'water_creature', 'distance': n} for n in range(1, 6)],
+            {'id': 20, 'name': 'player', 'type': 'player', 'username': 'Friend_1', 'distance': 6,
+             'equipment': [{'name': 'iron_helmet', 'count': 1}]},
+            {'id': 21, 'name': 'item', 'distance': 6, 'droppedItem': {'name': 'iron_pickaxe', 'count': 1}}]}
+        await service._on_game_state(data)
+        view = build_focused_view(service._game_observations, mode='social', max_tokens=700)
+        entities = view['state']['nearby']['entities']
+        self.assertEqual(entities[0]['username'], 'Friend_1')
+        self.assertEqual(entities[0]['equipment'][0]['name'], 'iron_helmet')
+        self.assertEqual(entities[1]['droppedItem']['name'], 'iron_pickaxe')
+
+    async def test_deferred_full_text_remains_observable_after_the_recent_event_window(self):
+        service, _ = self.service(busy=True)
+        service._client.request_game_state = AsyncMock(return_value=False)
+        stamp = time.time()
+        text = '玩家说明' * 200 + '重要尾句：这些物品放在公共箱里。'
+        with patch('plugin.plugins.game_agent_minecraft.service.time.time', return_value=stamp):
+            await service._on_game_state(frame(recentEvents=[event('long-chat', 'chat', text, player='Friend_1')]))
+        with patch('plugin.plugins.game_agent_minecraft.service.time.time', return_value=stamp + 180):
+            await service._on_game_state(frame(seq=2))
+            result = await service.observe_game([], 48)
+        self.assertEqual(result['deferredEvents'][0]['text'], text)
+        self.assertEqual(result['deferredEvents'][0]['player'], 'Friend_1')
+
+    async def test_two_verbose_pickups_stay_within_host_callback_budget(self):
+        service, calls = self.service(busy=True)
+        events = [event(f'gift-{n}', 'item_pickup', '收到铁镐，需核对背包。' * 60, player='ag_NEKO',
+            data={'selfCollected': True, 'nearbyPlayers': ['Friend_1'], 'donor': None,
+                  'item': {'name': 'iron_pickaxe', 'customName': '特殊装备' * 400}}) for n in range(2)]
+        await service._on_game_state(frame(recentEvents=events))
+        service._pending = None
+        service._task_finished = True
+        service._queue_deferred_chat_when_idle()
+        await service._push_game_context(attention=True)
+        cue = next(call for call in calls if call['ai_behavior'] == 'respond')
+        self.assertLessEqual(count_tokens(cue['parts'][0]['text']), 1000)
+        self.assertIn('do not invent who gave an item', cue['parts'][0]['text'])
