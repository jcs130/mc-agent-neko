 class ServerCommandTests(unittest.IsolatedAsyncioTestCase):
+    def test_latest_permission_is_scoped_and_does_not_erase_another_target_denial(self):
+        from utils.tokenize import count_tokens
+        for budget in (400, 700):
+            with self.subTest(budget=budget):
+                info = GameObservations()
+                initial = frame()
+                initial['state']['server']['protection'] = {
+                    'enabled': True, 'installed': True,
+                    'lastCheck': {'action': 'break', 'world': 'minecraft:overworld',
+                                  'x': 105, 'y': 17, 'z': 203, 'status': 'allow_likely',
+                                  'allowed': True, 'reason': 'no_known_protection',
+                                  'source': 'server_preflight',
+                                  'observedAt': initial['observedAt'] - 10000},
+                    'lastBlocked': {'action': 'break', 'world': 'minecraft:overworld',
+                                    'x': 104, 'y': 17, 'z': 203, 'status': 'deny',
+                                    'allowed': False, 'reason': 'original_building',
+                                    'source': 'server_dig_rejection',
+                                    'observedAt': initial['observedAt'] - 20000}}
+                initial['state']['server']['welcome'] = {
+                    'sessionId': initial['sessionId'], 'messages': [
+                        {'id': 'welcome:1', 'source': 'server', 'kind': 'system',
+                         'text': '村庄原建筑受到保护，植被可采集。', 'observedAt': initial['observedAt']}]}
+                info.ingest_state(initial)
+                text = info.context(max_tokens=budget)
+                summary = json.loads(text.split('\n', 1)[1])
+                protection = summary['protection']
+                latest = protection['lastCheck']
+                self.assertEqual(latest['status'], 'allow_likely')
+                self.assertIs(latest['allowed'], True)
+                self.assertEqual(latest['reason'], 'no_known_protection')
+                self.assertEqual((latest['action'], latest['world'], latest['x'], latest['y'], latest['z']),
+                                 ('break', 'minecraft:overworld', 105, 17, 203))
+                self.assertGreaterEqual(latest['ageSeconds'], 9)
+                self.assertLessEqual(latest['ageSeconds'], 12)
+                self.assertEqual(protection['lastBlocked']['x'], 104)
+                self.assertEqual(protection['lastBlocked']['status'], 'deny')
+                self.assertEqual(protection['lastBlocked']['world'], 'minecraft:overworld')
+                self.assertIn('tentative', protection['rule'])
+                self.assertIn('safety', protection['rule'])
+                self.assertLessEqual(count_tokens(text), budget)
+
+    def test_unknown_permission_is_not_rephrased_as_a_confirmed_denial(self):
+        info = GameObservations()
+        initial = frame()
+        initial['state']['server']['protection'] = {'enabled': True, 'installed': True,
+            'lastCheck': {'action': 'break', 'world': 'minecraft:overworld', 'x': 104, 'y': 17, 'z': 203,
+                          'status': 'unknown', 'allowed': None, 'reason': 'unknown_out_of_range',
+                          'observedAt': initial['observedAt']}}
+        info.ingest_state(initial)
+        summary = json.loads(info.context().split('\n', 1)[1])
+        self.assertEqual(summary['protection']['lastCheck']['status'], 'unknown')
+        self.assertIsNone(summary['protection']['lastCheck']['allowed'])
+        self.assertFalse(summary['protection']['lastBlocked'])
+
+    def test_permission_history_is_not_current_after_reconnect_or_stale_snapshot(self):
+        initial = frame()
+        now = initial['observedAt'] / 1000
+        info = GameObservations(clock=lambda: now)
+        initial['state']['server']['protection'] = {'enabled': True, 'installed': True,
+            'lastCheck': {'status': 'deny', 'reason': 'original_building'}}
+        info.ingest_state(initial)
+        self.assertIn('original_building', info.context())
+        info.clock = lambda: now + 50
+        self.assertNotIn('original_building', info.context())
+        info.clock = lambda: now
+        info.ingest_state(frame(session='reconnected'))
+        self.assertNotIn('original_building', info.context())
+
