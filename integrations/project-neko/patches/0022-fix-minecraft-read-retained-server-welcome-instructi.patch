         self._game_attention_ids: set[str] = set()
@@ -871,12 +873,32 @@ class GameAgentService:
                 self._last_inventory = {key: value for key, value in counts.items()
                                         if isinstance(key, str) and type(value) is int and 0 <= value <= 1000000}
                 self._last_inventory_at = time.time()
