+    async def _push_server_welcome(self) -> None:
+        try:
+            async with self._ingame_chat_push_lock:
+                session = self._game_observations.session_id
+                if session != self._server_welcome_session:
+                    self._server_welcome_session = session
+                    self._server_welcome_seen.clear()
+                for part in self._game_observations.welcome_context_parts():
+                    if part['key'] in self._server_welcome_seen:
+                        continue
+                    await asyncio.to_thread(self._push_message, source='game_agent_minecraft', visibility=[],
+                                            ai_behavior='read', parts=[{'type': 'text', 'text': part['text']}],
+                                            priority=4, coalesce_key='mc_server_welcome_' + part['key'])
+                    self._server_welcome_seen.add(part['key'])
+        except Exception as exc:
+            # Keep unsent chunks eligible for the next snapshot; receiving a
+            # guide must never start a task or interrupt the current action.
+            self._log_warning('Server welcome reading delivery failed: {}', exc)
+
     async def _on_game_events(self, data: dict[str, Any]) -> None:
         events = self._game_observations.ingest_events(data)
         if events:
@@ -2552,6 +2574,8 @@ class GameAgentService:
                 'sections': list(self._game_observations.state), 'eventCount': len(self._game_observations.events),
                 'sessionId': self._game_observations.session_id, 'seq': self._game_observations.seq,
                 'lastContextPushAt': self._game_context_push_at, 'lastAttentionAt': self._game_attention_at,
+                'welcomeMessages': len((self._game_observations.server_welcome() or {}).get('messages', [])),
