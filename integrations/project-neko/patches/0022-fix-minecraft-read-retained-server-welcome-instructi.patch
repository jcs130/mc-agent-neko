diff --git a/plugin/plugins/game_agent_minecraft/test_server_welcome.py b/plugin/plugins/game_agent_minecraft/test_server_welcome.py
new file mode 100644
index 0000000..2138455
--- /dev/null
+++ b/plugin/plugins/game_agent_minecraft/test_server_welcome.py
@@ -0,0 +1,114 @@
+import json
+import time
+import unittest
+
+from utils.tokenize import count_tokens
+
+from .observations import GameObservations
+from .service import GameAgentService
+from .test_observations import frame
+
+
+def welcome_frame(seq=1, session='fixture', texts=None):
+    data = frame(seq=seq, session=session)
+    data['state']['server']['welcome'] = {
+        'sessionId': session, 'startedAt': time.time() * 1000 - 180000,
+        'captureUntil': time.time() * 1000 - 150000, 'truncated': False, 'omittedMessages': 0,
+        'messages': [{'id': f'{session}:guide:{index}', 'kind': 'system', 'source': 'server',
+                      'observedAt': time.time() * 1000 - 179000, 'text': text, 'truncated': False}
+                     for index, text in enumerate(texts or ['技能目录 /mycli skills list profession',
+                         '倒地救援：靠近4格10秒或清场自动复活，无需学习/施法。'])],
+    }
+    return data
+
+
+class ServerWelcomeTests(unittest.IsolatedAsyncioTestCase):
+    def service(self):
+        calls = []
+        service = GameAgentService(logger=None, push_message_fn=lambda **kw: calls.append(kw))
+        service.set_lang('zh')
+        return service, calls
+
+    async def test_late_plugin_reads_old_welcome_without_recent_events_once(self):
+        service, calls = self.service()
+        data = welcome_frame()
+        await service._on_game_state(data)
+        welcome = [call for call in calls if call['coalesce_key'].startswith('mc_server_welcome_')]
+        self.assertEqual(len(welcome), 2)
+        self.assertTrue(all(call['ai_behavior'] == 'read' for call in welcome))
+        self.assertIn('/mycli skills list profession', welcome[0]['parts'][0]['text'])
+        self.assertIn('靠近4格10秒', welcome[1]['parts'][0]['text'])
+        await service._on_game_state(welcome_frame(seq=2))
+        self.assertEqual(len([call for call in calls if call['coalesce_key'].startswith('mc_server_welcome_')]), 2)
+        await service._on_game_state(welcome_frame(session='another-server'))
+        self.assertEqual(len([call for call in calls if call['coalesce_key'].startswith('mc_server_welcome_')]), 4)
+
+    async def test_large_welcome_is_complete_ordered_and_each_callback_fits_host_limit(self):
+        service, calls = self.service()
+        text = '服务器玩法说明：职业技能需要技能点，保护建筑不可破坏。' * 160 + '\n最后一步 /mycli world board'
+        await service._on_game_state(welcome_frame(texts=[text]))
+        pushes = [call for call in calls if call['coalesce_key'].startswith('mc_server_welcome_')]
+        self.assertGreater(len(pushes), 1)
+        self.assertEqual(len({call['coalesce_key'] for call in pushes}), len(pushes))
+        restored = ''.join(call['parts'][0]['text'].split('\n', 2)[2] for call in pushes)
+        self.assertEqual(restored, text)
+        for call in pushes:
+            self.assertEqual(call['ai_behavior'], 'read')
+            self.assertLessEqual(count_tokens(call['parts'][0]['text']), 900)
+        self.assertFalse(any(call['ai_behavior'] == 'respond' for call in calls))
+
+    async def test_compact_decisions_and_observe_keep_welcome_after_event_ttl(self):
+        info = GameObservations()
+        info.ingest_state(welcome_frame())
+        for budget in (400, 700):
+            text = info.context(max_tokens=budget)
+            self.assertIn('serverWelcome', text)
+            self.assertIn('minecraft_observe', text)
+            self.assertLessEqual(count_tokens(text), budget)
+        observed = info.view(sections=['server'], max_events=0)
+        self.assertIn('靠近4格10秒', observed['state']['server']['welcome']['messages'][1]['text'])
+        self.assertEqual(observed['recentEvents'], [])
+
+    async def test_failed_reading_callback_retries_without_resending_successful_parts(self):
+        service, calls = self.service()
+        original = service._push_message
+        failed = False
+
+        def push(**kwargs):
+            nonlocal failed
+            if 'mc_server_welcome_' in kwargs['coalesce_key'] and '靠近4格10秒' in kwargs['parts'][0]['text'] and not failed:
+                failed = True
+                raise RuntimeError('temporary callback failure')
+            return original(**kwargs)
+
+        service._push_message = push
+        await service._on_game_state(welcome_frame())
+        self.assertEqual(len(service._server_welcome_seen), 1)
+        await service._on_game_state(welcome_frame(seq=2))
+        pushes = [call for call in calls if call['coalesce_key'].startswith('mc_server_welcome_')]
+        self.assertEqual(len(pushes), 2)
+        self.assertEqual(len(service._server_welcome_seen), 2)
+
+    async def test_foreign_or_stale_welcome_is_not_delivered(self):
+        info = GameObservations()
+        data = welcome_frame()
+        data['state']['server']['welcome']['sessionId'] = 'foreign-session'
+        info.ingest_state(data)
+        self.assertEqual(info.welcome_context_parts(), [])
+        self.assertNotIn('serverWelcome', info.context())
+        info = GameObservations()
+        info.ingest_state(welcome_frame())
+        info.clock = lambda: time.time() + 60
+        self.assertEqual(info.welcome_context_parts(), [])
+
+    async def test_changed_welcome_sends_only_new_messages_and_never_replays_old_session(self):
+        service, calls = self.service()
+        await service._on_game_state(welcome_frame(texts=['first guide']))
+        await service._on_game_state(welcome_frame(seq=2, texts=['first guide', '新增照片玩法 /photohelp']))
+        pushes = [call for call in calls if call['coalesce_key'].startswith('mc_server_welcome_')]
+        self.assertEqual(len(pushes), 2)
+        self.assertIn('/photohelp', pushes[-1]['parts'][0]['text'])
+        next_frame = frame(session='new-empty-server')
+        await service._on_game_state(next_frame)
+        self.assertNotIn('first guide', service._game_observations.context())
+        self.assertNotIn('serverWelcome', service._game_observations.context())
