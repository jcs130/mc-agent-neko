@@ -1,4 +1,4 @@
-"""Bounded, timestamped game facts shared by passive context and decisions."""
+"""Complete timestamped game facts shared by passive context and decisions."""
 from __future__ import annotations
 
 import collections
@@ -42,6 +42,7 @@ class GameObservations:
         self.observed_at = 0.0
         self.received_at = 0.0
