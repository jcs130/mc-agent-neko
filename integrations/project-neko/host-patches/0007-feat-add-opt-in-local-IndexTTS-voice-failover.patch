diff --git a/main_logic/tts_client/local_backup.py b/main_logic/tts_client/local_backup.py
new file mode 100644
index 0000000..753292a
--- /dev/null
+++ b/main_logic/tts_client/local_backup.py
@@ -0,0 +1,79 @@
+"""Opt-in local speech backup using the existing runtime exclusion/replay chain."""
+from dataclasses import replace
+from functools import partial
+from urllib.parse import urlsplit
+
+PRIMARY_PROVIDER = 'free_local_backup'
+BACKUP_PROVIDER = 'index_local_backup'
+
+
+def _valid_config(config, voice_id):
+    if not isinstance(config, dict) or config.get('enabled') is not True:
+        return False
+    if not voice_id or config.get('source_voice_id') != voice_id:
+        return False
+    try:
+        url = urlsplit(str(config.get('base_url') or ''))
+        return bool(
+            url.scheme == 'http' and url.hostname in {'127.0.0.1', '::1'}
+            and url.port and not url.username and not url.password
+            and not url.query and not url.fragment and url.path == '/v1'
+            and isinstance(config.get('voice'), str) and config['voice'].strip()
+            and config.get('model') == 'indextts-2.5'
+        )
+    except (TypeError, ValueError):
+        return False
+
+
+def index_backup_worker(request_queue, response_queue, api_key, voice_id, *,
+                        base_url, local_voice, model):
+    # Both credentials and voice identity belong to the local clone, never to
+    # the failed online provider. 原在线凭证和音色 ID 不得透传到本地端点。
+    from .workers.openai import openai_tts_worker
+    return openai_tts_worker(
+        request_queue, response_queue, '', local_voice,
+        base_url=base_url, model=model, voice=local_voice,
+        label='本地 IndexTTS 2.5 备用语音', safe_error_provider=BACKUP_PROVIDER,
+        # This model rejects API sample_rate overrides. Decode its native
+        # 22.05 kHz correctly before resampling to Neko's 48 kHz output.
+        # 本地故障不叠加 SDK 隐式重试；其他语音提供方的 24 kHz 默认值不变。
+        extra_body_overrides={'extra_params': {'lang': 'zh'}},
+        request_timeout=60.0, max_retries=0, pcm_sample_rate=22050,
+    )
+
+
+def resolve_local_backup(config, voice_id, excluded, primary, silent_worker):
+    """Wrap only the matching free voice; preserve every other dispatch route."""
+    if primary[0] is silent_worker:
+        return primary
+    valid = _valid_config(config, voice_id)
+    if PRIMARY_PROVIDER in excluded:
+        # Configuration removal and local failure both exhaust this chain.
+        # 配置被移除或两端都失败后结束，不循环重连故障的在线服务。
+        if not valid or BACKUP_PROVIDER in excluded:
+            return silent_worker, '', None
+        return (
+            partial(index_backup_worker, base_url=config['base_url'],
+                    local_voice=config['voice'], model=config['model']),
+            '', BACKUP_PROVIDER,
+        )
+    if valid and primary[2] == 'free':
+        return primary[0], primary[1], PRIMARY_PROVIDER
+    return primary
+
+
+def register_local_backup_providers(registry, architectural_metadata):
+    """Runtime-only identities: no new selection priority or settings dropdown."""
+    for key in (PRIMARY_PROVIDER, BACKUP_PROVIDER):
+        registry.register(registry.TTSProvider(
+            key=key, kind='hosted' if key == PRIMARY_PROVIDER else 'local', priority=1000,
+            capabilities=frozenset({'preset'}), is_selected=lambda ctx: False,
+            resolve=lambda ctx: None, fallback_on_failure=True,
+            tts_config_visible=False,
+        ))
+    # Keep the primary's absent metadata, including its original normalization.
+    # The local HTTP worker confirms sentences, enabling suffix-only replay.
+    architectural_metadata[BACKUP_PROVIDER] = replace(
+        architectural_metadata['openai'], name=BACKUP_PROVIDER,
+        notes='仅供本地 IndexTTS 克隆音色故障回退',
+    )
