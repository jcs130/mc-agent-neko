+def test_local_index_worker_decodes_native_rate_and_requests_chinese_without_hidden_retries(monkeypatch):
+    rates = []
+    original_resample = openai_worker_module._resample_audio
+
+    def track_resample(audio, source_rate, *args, **kwargs):
+        rates.append(source_rate)
+        return original_resample(audio, source_rate, *args, **kwargs)
+
+    monkeypatch.setattr(openai_worker_module, "_resample_audio", track_resample)
+    clients, request_queue, response_queue, thread = _run_worker_once(
+        monkeypatch,
+        [b"\x00\x00"],
+        base_url="http://127.0.0.1:18040/v1",
+        model="indextts-2.5",
+        voice_id="yui-local",
+        audio_api_key="",
+        extra_body_overrides={"extra_params": {"lang": "zh"}},
+        request_timeout=60.0,
+        max_retries=0,
+        pcm_sample_rate=22050,
+    )
+    _wait_for_item(response_queue, lambda item: isinstance(item, bytes))
+    request_queue.put((tts_client.TTS_SHUTDOWN_SENTINEL, None))
+    thread.join(timeout=5)
+    assert not thread.is_alive()
+    assert clients[0].client_kwargs["timeout"] == 60.0
+    assert clients[0].client_kwargs["max_retries"] == 0
+    assert clients[0].create_calls[0]["extra_body"] == {
+        "extra_params": {"lang": "zh"},
+    }
+    assert rates and set(rates) == {22050}
+
+
