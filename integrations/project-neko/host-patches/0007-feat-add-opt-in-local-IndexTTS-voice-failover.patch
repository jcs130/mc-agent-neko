+"""Opt-in local voice backup: route identity, exhaustion and credential isolation."""
+from functools import partial
+import queue
+from unittest.mock import Mock
+
+import pytest
+
+from main_logic.tts_client.local_backup import (
+    BACKUP_PROVIDER, PRIMARY_PROVIDER, resolve_local_backup,
+)
+
+
+def primary_worker(*args):
+    pass
+
+
+def silent_worker(*args):
+    pass
+
+
+@pytest.fixture
+def config():
+    return {
+        'enabled': True, 'source_voice_id': 'online-yui',
+        'base_url': 'http://127.0.0.1:18040/v1',
+        'model': 'indextts-2.5', 'voice': 'yui-local',
+    }
+
+
+def route(config, excluded=(), voice='online-yui', provider='free'):
+    return resolve_local_backup(
+        config, voice, frozenset(excluded),
+        (primary_worker, 'online-secret', provider), silent_worker,
+    )
+
+
+@pytest.mark.parametrize('change', [{'enabled': False}, {'source_voice_id': 'other'}, {}])
+def test_disabled_or_other_voice_keeps_existing_route(config, change):
+    config.update(change)
+    if change == {}:
+        config.clear()
+    assert route(config) == (primary_worker, 'online-secret', 'free')
+
+
+def test_matching_voice_wraps_primary_identity_only(config):
+    assert route(config) == (primary_worker, 'online-secret', PRIMARY_PROVIDER)
+    assert route(config, provider='qwen') == (primary_worker, 'online-secret', 'qwen')
+
+
+def test_failure_uses_local_voice_without_online_credentials(config, monkeypatch):
+    from main_logic.tts_client.workers import openai as worker_module
+    worker = Mock()
+    monkeypatch.setattr(worker_module, 'openai_tts_worker', worker)
+    selected, key, provider = route(config, [PRIMARY_PROVIDER])
+    assert isinstance(selected, partial)
+    assert key == ''
+    assert provider == BACKUP_PROVIDER
+    selected('requests', 'responses', 'must-not-leak', 'online-yui')
+    assert worker.call_args.args == ('requests', 'responses', '', 'yui-local')
+    assert worker.call_args.kwargs['voice'] == 'yui-local'
+    assert worker.call_args.kwargs['base_url'] == config['base_url']
+    assert worker.call_args.kwargs['extra_body_overrides'] == {
+        'extra_params': {'lang': 'zh'},
+    }
+    assert worker.call_args.kwargs['max_retries'] == 0
+    assert worker.call_args.kwargs['pcm_sample_rate'] == 22050
+
+
+def test_both_failed_end_without_returning_to_primary(config):
+    assert route(config, [PRIMARY_PROVIDER, BACKUP_PROVIDER]) == (silent_worker, '', None)
+
+
+@pytest.mark.parametrize('url', [
+    'https://speech.example/v1', 'http://localhost:18040/v1',
+    'http://user:secret@127.0.0.1:18040/v1',
+    'http://127.0.0.1:18040/v1?key=secret', 'http://127.0.0.1:18040/other',
+])
+def test_invalid_endpoint_keeps_primary_and_never_retries_failed_primary(config, url):
+    config['base_url'] = url
+    assert route(config) == (primary_worker, 'online-secret', 'free')
+    assert route(config, [PRIMARY_PROVIDER]) == (silent_worker, '', None)
+
+
+def test_disable_tts_during_fallback_stays_silent(config):
+    assert resolve_local_backup(
+        config, 'online-yui', frozenset({PRIMARY_PROVIDER}),
+        (silent_worker, None, None), silent_worker,
+    ) == (silent_worker, None, None)
+
+
+def test_real_dispatch_is_opt_in_and_registry_can_fail_over(config, monkeypatch):
+    from main_logic import tts_client
+    from utils.tts import provider_registry
+    cm = Mock()
+    cm.load_json_config.return_value = config
+    monkeypatch.setattr(tts_client, 'get_config_manager', lambda: cm)
+    monkeypatch.setattr(tts_client, '_get_primary_tts_worker',
+                        lambda *a, **kw: (primary_worker, 'online-secret', 'free'))
+    assert tts_client.get_tts_worker('free', True, 'online-yui')[2] == PRIMARY_PROVIDER
+    fallback = tts_client.get_tts_worker('free', True, 'online-yui',
+                                        excluded_provider_keys={PRIMARY_PROVIDER})
+    assert fallback[1:] == ('', BACKUP_PROVIDER)
+    assert provider_registry.falls_back_on_failure(PRIMARY_PROVIDER)
+    assert provider_registry.falls_back_on_failure(BACKUP_PROVIDER)
+    assert not provider_registry.uses_configured_preset_voice(PRIMARY_PROVIDER)
+    assert not provider_registry.uses_configured_preset_voice(BACKUP_PROVIDER)
+    assert tts_client.TTS_PROVIDER_REGISTRY[BACKUP_PROVIDER].category == 'http_sentence'
+
+
+@pytest.mark.parametrize('audio_emitted', [False, True])
+def test_native_runtime_replays_only_safe_current_text(config, monkeypatch, audio_emitted):
+    from main_logic import tts_client
+    from main_logic.core import LLMSessionManager
+    cm = Mock()
+    cm.load_json_config.return_value = config
+    monkeypatch.setattr(tts_client, 'get_config_manager', lambda: cm)
+    monkeypatch.setattr(tts_client, '_get_primary_tts_worker',
+                        lambda *a, **kw: (primary_worker, 'online-secret', 'free'))
+    mgr = LLMSessionManager.__new__(LLMSessionManager)
+    mgr._tts_active_provider_key = PRIMARY_PROVIDER
+    mgr._tts_excluded_provider_keys = frozenset()
+    mgr.tts_request_queue = queue.Queue()
+    mgr.current_speech_id = 'current'
+    mgr.tts_pending_chunks = [('old', 'discard'), ('current', 'later')]
+    mgr._tts_replay_speech_id = 'current'
+    mgr._tts_replay_chunks = [('old', 'discard'), ('current', 'replay')]
+    mgr._tts_replay_done = True
+    mgr._tts_replay_audio_emitted = audio_emitted
+    mgr._tts_replay_progress_supported = False
+    mgr._tts_done_queued_for_turn = True
+    mgr._tts_done_pending_until_ready = False
+    mgr._tts_fallback_uses_default_voice = False
+    mgr._reset_tts_stream_normalizer = lambda: None
+    started = []
+
+    def start_fallback(*, preserve_provider_exclusions):
+        assert preserve_provider_exclusions
+        selected = tts_client.get_tts_worker(
+            'free', True, 'online-yui', excluded_provider_keys=mgr._tts_excluded_provider_keys)
+        started.append(selected)
+        mgr._tts_active_provider_key = selected[2]
+
+    mgr._start_tts_thread = start_fallback
+    assert mgr._activate_configured_tts_fallback('injected_failure') is True
+    assert mgr._tts_active_provider_key == BACKUP_PROVIDER
+    assert started[0][1] == ''
+    assert not mgr._tts_fallback_uses_default_voice
+    assert mgr.tts_request_queue.get_nowait() == ('__shutdown__', None)
+    assert mgr.tts_pending_chunks == (
+        [('current', 'later')] if audio_emitted else
+        [('current', 'replay'), ('current', 'later')])
+
+
+def test_retired_runtime_cannot_switch_the_live_voice():
+    from main_logic.core import LLMSessionManager
+    mgr = LLMSessionManager.__new__(LLMSessionManager)
+    mgr._tts_output_is_current = lambda: False
+    assert mgr._activate_configured_tts_fallback('late_failure') is False
