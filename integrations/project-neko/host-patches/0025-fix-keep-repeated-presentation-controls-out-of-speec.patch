@@ -140,11 +151,50 @@ class JointReplyFilter:
         self.started = True
         return visible
 
+    def _body_text(self, chunk, *, final=False):
+        """Drop the reserved protocol anywhere, holding only a split opener.
+
+        A repeated header cannot change this segment's leading emotion. Once
+        an opener is known, discard until its close instead of spilling an
+        overlong description into speech. Incomplete controls die at finalize.
+        """
+        data = self.body_pending + chunk
+        self.body_pending = ''
+        visible = []
+        index = 0
+        while index < len(data):
+            if self.body_discarding:
+                end = data.find(']', index)
+                if end < 0:
+                    break
+                self.body_discarding = False
+                index = end + 1
+                continue
+            start = data.find('[', index)
+            if start < 0:
+                visible.append(data[index:])
+                break
+            visible.append(data[index:start])
+            candidate = data[start:]
+            if candidate.startswith(HEADER):
+                self.body_discarding = True
+                index = start + len(HEADER)
+            elif HEADER.startswith(candidate):
+                if not final:
+                    self.body_pending = candidate
+                elif not candidate.startswith('[neko_'):
+                    visible.append(candidate)
+                break
+            else:
+                visible.append('[')
+                index = start + 1
+        return ''.join(visible)
+
     def feed(self, chunk):
-        return self.inner.feed(self._text(str(chunk)))
+        return self.inner.feed(self._body_text(self._text(str(chunk))))
 
     def finalize(self):
-        visible, event = self.inner.feed(self._text('', final=True))
+        visible, event = self.inner.feed(self._body_text(self._text('', final=True), final=True))
         tail, final_event = self.inner.finalize()
         return visible + tail, final_event or event
 
