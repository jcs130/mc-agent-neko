+@pytest.mark.parametrize('header', [
+    '[neko_emotion:happy|轻快、带笑意，语速适中]',
+    '[neko_emotion:unknown|不要朗读的描述]',
+    '[neko_emotion:happy|' + '描述' * 150 + ']',
+], ids=['valid-style', 'invalid-label', 'overlong-style'])
+def test_repeated_private_header_in_body_is_removed_at_every_boundary(header):
+    raw = '[neko_emotion:neutral]先看报价。' + header + '没有合适的交易。'
+    for split in range(len(raw) + 1):
+        text, metadata = render([raw[:split], raw[split:]])
+        assert text == '先看报价。没有合适的交易。'
+        assert metadata == {'mode': 'joint', 'emotion': 'neutral'}, 'only leading metadata owns emotion'
+    assert render(list(raw))[0] == '先看报价。没有合适的交易。'
+
+
+@pytest.mark.parametrize('partial', [
+    '[neko_emo', '[neko_emotion:happy|轻快',
+    '[neko_emotion:happy|' + '私有描述' * 500,
+], ids=['partial-opener', 'partial-style', 'overlong-unclosed'])
+def test_truncated_repeated_control_never_flushes_as_spoken_tail(partial):
+    text, metadata = render(list('正常正文。' + partial))
+    assert text == '正常正文。'
+    assert metadata['emotion'] == 'neutral'
+
+
+def test_long_incomplete_header_has_bounded_storage_and_can_resume_after_close():
+    parser = JointReplyFilter(ToolLeakFilter(), {'mode': 'joint', 'emotion': 'neutral'})
+    assert parser.feed('[neko_emotion:happy|' + '描述' * 10000)[0] == ''
+    assert len(parser.pending) <= 80
+    assert parser.feed(']恢复正文。')[0] == '恢复正文。'
+    assert parser.finalize()[0] == ''
+
+
+def test_ordinary_quotes_and_near_matches_are_preserved_across_chunks():
+    raw = '朋友说“语速慢一点”。[example]，[neko_friend]，普通（轻快）注释。'
+    for split in range(len(raw) + 1):
+        assert render([raw[:split], raw[split:]])[0] == raw
+
