+def test_repeated_header_is_private_before_native_http_speech_payload(monkeypatch):
+    from tests.unit.test_openai_compatible_tts import _install_fake_openai, _wait_for_item
+    from main_logic.tts_client.local_primary import voxcpm_primary_worker
+    from utils.joint_reply_emotion import JointReplyFilter
+    from utils.llm_tool_leak_filter import ToolLeakFilter
+
+    clients = _install_fake_openai(monkeypatch, [b'\x01\x00' * 4800])
+    requests, responses = queue.Queue(), queue.Queue()
+    worker = threading.Thread(target=voxcpm_primary_worker,
+        args=(requests, responses, '', 'ignored'),
+        kwargs={'base_url': 'http://127.0.0.1:18041/v1', 'local_voice': 'yui-local'}, daemon=True)
+    worker.start()
+    try:
+        _wait_for_item(responses, lambda item: item == ('__ready__', True))
+        metadata = {'mode': 'joint', 'emotion': 'neutral'}
+        parser = JointReplyFilter(ToolLeakFilter(), metadata)
+        raw = '[neko_emotion:happy|轻快]找到了[neko_emotion:sad|低沉、语速慢]！'
+        # Use fragmented model delivery, not a manually cleaned sentence.
+        for char in raw:
+            visible, _ = parser.feed(char)
+            if visible:
+                requests.put(('s', visible))
+        visible, _ = parser.finalize()
+        if visible:
+            requests.put(('s', visible))
+        requests.put((None, None))
+        receipt = _wait_for_item(responses, lambda item:
+            isinstance(item, tuple) and item[0] == '__tts_sentence_done__')
+        assert receipt == ('__tts_sentence_done__', 's', '找到了！')
+        assert [call['input'] for call in clients[0].create_calls] == ['找到了！']
+        assert metadata == {'mode': 'joint', 'emotion': 'happy', 'voice_style': '轻快'}
+    finally:
+        requests.put(('__shutdown__', None))
+        worker.join(5)
+        assert not worker.is_alive()
