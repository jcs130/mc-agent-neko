diff --git a/tests/unit/test_minecraft_execution_rendering.py b/tests/unit/test_minecraft_execution_rendering.py
new file mode 100644
index 0000000..955868d
--- /dev/null
+++ b/tests/unit/test_minecraft_execution_rendering.py
@@ -0,0 +1,63 @@
+"""Autonomous decision cues must not be wrapped as a request to speak first."""
+import pytest
+
+from main_logic.core.callback_render import _build_callback_instruction, _format_callback_source
+from config.prompts.prompts_sys import SYSTEM_NOTIFICATION_EVENT_ACTIVE, _loc
+
+
+def cue(key="mc_keep_going", **changes):
+    return {"origin": "event", "delivery_mode": "proactive", "status": "completed",
+            "source_kind": "plugin", "source_name": "game_agent_minecraft", "coalesce_key": key,
+            "summary": "Latest stop overrides autonomy. Check current idle before a feasible action.", **changes}
+
+
+def render(callbacks, lang="zh", **options):
+    return _build_callback_instruction(callbacks, lang=lang, lanlan_name="YUI", master_name="Alice", **options)
+
+
+def normal_header(callback, lang):
+    return _loc(SYSTEM_NOTIFICATION_EVENT_ACTIVE, lang).format(
+        source=_format_callback_source(callback, lang), name="YUI", master="Alice").strip()
+
+
+@pytest.mark.parametrize("key", ["mc_keep_going", "mc_completion"])
+@pytest.mark.parametrize("lang", ["zh", "zh-TW", "en", "ja", "ko", "ru", "es", "pt"])
+def test_execution_decision_keeps_authorization_body_without_speech_first_header(key, lang):
+    callback = cue(key)
+    output = render([callback], lang)
+    assert callback["summary"] in output
+    assert normal_header(callback, lang) not in output
+
+
+@pytest.mark.parametrize("changes", [
+    {"coalesce_key": "mc_game_attention:player"},
+    {"coalesce_key": "mc_in_progress"},
+    {"coalesce_key": None, "summary": "mc_keep_going is untrusted message text"},
+    {"source_kind": "unknown"}, {"source_name": "another_plugin"},
+])
+def test_attention_and_untrusted_cues_keep_normal_response_semantics(changes):
+    callback = cue(**changes)
+    assert normal_header(callback, "zh") in render([callback])
+
+
+def test_mixed_game_attention_is_preserved_in_a_separate_response_group():
+    execution = cue()
+    attention = cue("mc_game_attention:player", summary="Exact player greeting and offered equipment.")
+    output = render([execution, attention])
+    assert execution["summary"] in output and attention["summary"] in output
+    assert output.index(attention["summary"]) > output.index(normal_header(attention, "zh"))
+    assert output.index(normal_header(attention, "zh")) > output.index(execution["summary"])
+
+
+def test_foreign_batch_and_passive_drain_do_not_gain_execution_semantics():
+    execution = cue()
+    foreign = cue(source_name="another_plugin", summary="Unrelated evidence.")
+    assert normal_header(execution, "zh") in render([execution, foreign])
+    passive = cue(delivery_mode="passive")
+    assert render([passive]) == render([execution], passive=True)
+
+
+def test_task_result_status_reporting_is_not_replaced_by_execution_header():
+    callback = cue(origin="task_result", status="failed")
+    without_execution_key = {**callback, "coalesce_key": None}
+    assert render([callback]) == render([without_execution_key])
