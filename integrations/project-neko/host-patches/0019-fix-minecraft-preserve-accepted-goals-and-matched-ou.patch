diff --git a/main_logic/core/proactive.py b/main_logic/core/proactive.py
index 885f5c6..2e2f956 100644
--- a/main_logic/core/proactive.py
+++ b/main_logic/core/proactive.py
@@ -3344,6 +3344,9 @@ class ProactiveMixin:
                 AGENT_CALLBACK_QUEUE_MAX_ITEMS,
             )
             context_source = "topic.hook" if callback.get("channel") == "topic_hook" else "proactive.callback"
+            from utils.game_execution_context import is_minecraft_execution_callback
