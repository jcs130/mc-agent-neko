diff --git a/plugin/server/messaging/proactive_bridge.py b/plugin/server/messaging/proactive_bridge.py
index fc0d881..8535a52 100644
--- a/plugin/server/messaging/proactive_bridge.py
+++ b/plugin/server/messaging/proactive_bridge.py
@@ -485,10 +485,14 @@ class ProactiveBridge:
                 if plugin_id == "game_agent_minecraft" and schema == "push_message.v2":
                     # Minecraft decision context is already structured/bounded.
                     # The generic 200-token result-summary cap removes its
-                    # resources and outcomes before the 1,000-token host cap.
+                    # resources and outcomes before the host callback cap.
                     from config import AGENT_CALLBACK_TEXT_MAX_TOKENS
+                    from utils.game_execution_context import MINECRAFT_EXECUTION_CALLBACK_MAX_TOKENS
                     from utils.tokenize import truncate_to_tokens
-                    text = truncate_to_tokens(text, AGENT_CALLBACK_TEXT_MAX_TOKENS)
+                    budget = (MINECRAFT_EXECUTION_CALLBACK_MAX_TOKENS
+                              if ai_behavior == 'respond' and coalesce_key in ('mc_keep_going', 'mc_completion')
+                              else AGENT_CALLBACK_TEXT_MAX_TOKENS)
+                    text = truncate_to_tokens(text, budget)
                 else:
                     text = parse_push_message_content(text)
             except Exception as exc:
diff --git a/tests/unit/test_minecraft_proactive_budget.py b/tests/unit/test_minecraft_proactive_budget.py
index 47c5122..f91affd 100644
--- a/tests/unit/test_minecraft_proactive_budget.py
