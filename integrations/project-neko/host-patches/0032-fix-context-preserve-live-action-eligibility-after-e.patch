+@pytest.mark.parametrize('last_status,available', [('ready_if_authorized', True), ('busy', False), ('stopped', False)])
+def test_evidence_and_server_queries_keep_the_latest_live_decision_for_terminal_choice(last_status, available):
+    from main_logic.omni_offline_client._tools import _minecraft_action_followup_tools
+    names = ['minecraft_task', 'minecraft_server', 'minecraft_chat', 'minecraft_wait', 'minecraft_observe']
+    tools = [{'function': {'name': name}} for name in names]
+    messages = [{'role': 'tool', 'name': 'minecraft_observe', 'content': json.dumps({
+        'historical': True, 'valueIsIndex': True, 'decision': {'status': 'ready_if_authorized'}})},
+        {'role': 'tool', 'name': 'minecraft_server', 'content': json.dumps({
+            'readOnly': True, 'decision': {'status': last_status}})},
+        {'role': 'tool', 'name': 'minecraft_observe', 'content': json.dumps({'historical': True, 'value': 'exact old text'})}]
+    result = _minecraft_action_followup_tools(messages, tools)
+    assert {tool['function']['name'] for tool in result} == (set(names[:-1]) if available else set())
+
+
+@pytest.mark.asyncio
+async def test_capped_evidence_queries_can_choose_explicit_wait_instead_of_forced_plan_speech():
+    from utils.llm_client import LLMStreamChunk
+    from main_logic.tool_calling import ToolDefinition, ToolResult
+    llm = _FakeLLM([
+        [LLMStreamChunk(content='', tool_call_deltas=[{'index': 0, 'id': 'evidence', 'type': 'function',
+            'function': {'name': 'minecraft_observe', 'arguments': '{}'}}], finish_reason='tool_calls')],
+        [LLMStreamChunk(content='', tool_call_deltas=[{'index': 0, 'id': 'wait', 'type': 'function',
+            'function': {'name': 'minecraft_wait', 'arguments': '{"reason":"latest user stop"}'}}], finish_reason='tool_calls')]])
+    called = []
+    async def handler(call):
+        called.append(call.name)
+        return ToolResult(call_id=call.call_id, name=call.name, output=(
+            {'historical': True, 'valueIsIndex': True, 'decision': {'status': 'ready_if_authorized'}}
+            if call.name == 'minecraft_observe' else {'status': 'waiting'}))
+    client = _bare_tool_client(llm, ToolDefinition(name='minecraft_observe', description=''), handler, cap=1)
+    client._tool_definitions.extend([ToolDefinition(name='minecraft_task', description=''),
+                                      ToolDefinition(name='minecraft_wait', description='')])
+    async for _ in client._astream_with_tools([], _minecraft_execution_turn=True):
+        pass
+    assert called == ['minecraft_observe', 'minecraft_wait']
+    assert len(llm.calls) == 2, 'Reuse the existing final request, without an extra model call'
+    assert llm.calls[-1][1]['tool_choice'] == 'required'
+    assert {tool['function']['name'] for tool in llm.calls[-1][1]['tools']} == {'minecraft_task', 'minecraft_wait'}
+
+
