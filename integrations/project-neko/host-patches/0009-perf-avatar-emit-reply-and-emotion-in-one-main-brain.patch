diff --git a/tests/unit/test_joint_reply_emotion.py b/tests/unit/test_joint_reply_emotion.py
new file mode 100644
index 0000000..a3cb80b
--- /dev/null
+++ b/tests/unit/test_joint_reply_emotion.py
@@ -0,0 +1,133 @@
+import asyncio
+from unittest.mock import MagicMock
+
+import pytest
+from utils.llm_client.messages import HumanMessage, SystemMessage
+
+from utils.joint_reply_emotion import (
+    JointReplyFilter, JOINT_REPLY_INSTRUCTION, presentation_messages, reply_emotion_context,
+)
+from utils.llm_tool_leak_filter import ToolLeakFilter
+
+
+def render(chunks):
+    metadata = {'mode': 'joint', 'emotion': 'neutral'}
+    parser = JointReplyFilter(ToolLeakFilter(), metadata)
+    text = ''.join(parser.feed(c)[0] for c in chunks)
+    text += parser.finalize()[0]
+    return text, metadata
+
+
+@pytest.mark.parametrize('label', ['neutral', 'happy', 'sad', 'angry', 'surprised'])
+def test_every_chunk_boundary(label):
+    raw = f'[neko_emotion:{label}]\n你好，找到铁矿了。'
+    for split in range(len(raw) + 1):
+        text, metadata = render([raw[:split], raw[split:]])
+        assert text == '你好，找到铁矿了。'
+        assert metadata['emotion'] == label
+
+
+@pytest.mark.parametrize('raw, expected', [
+    ('普通回复。', '普通回复。'),
+    ('[neko_emotion:unknown]正常回复', '正常回复'),
+    ('[neko_emotion:happy', ''),
+    ('[neko_emo', ''),
+    ('正文示例：[neko_emotion:happy]。', '正文示例：[neko_emotion:happy]。'),
+    ('[example] 普通引用', '[example] 普通引用'),
+    ('[neko_emotion:happy]Hello! 日本語。中文。', 'Hello! 日本語。中文。'),
+])
+def test_missing_invalid_partial_and_literal_body(raw, expected):
+    text, _ = render(list(raw))
+    assert text == expected
+
+
+def test_tool_markup_stays_private_and_next_round_can_change_emotion():
+    metadata = {'mode': 'joint', 'emotion': 'neutral'}
+    parser = JointReplyFilter(ToolLeakFilter(), metadata)
+    text, _ = parser.feed('[neko_emotion:happy]找到了。<seed:tool_call><function=recall_memory>secret</function></seed:tool_call>')
+    text += parser.finalize()[0]
+    assert 'secret' not in text and 'neko_emotion' not in text
+    parser.reset()
+    assert parser.feed('[neko_emotion:sad]没有找到。')[0] == '没有找到。'
+    assert metadata['emotion'] == 'sad'
+
+
+def test_request_contract_is_stable_and_does_not_mutate_history():
+    history = [SystemMessage(content='Identity / permissions'), HumanMessage(content='你好')]
+    a = presentation_messages(history)
+    b = presentation_messages(history)
+    assert a[0].content == b[0].content == history[0].content + JOINT_REPLY_INSTRUCTION
+    assert history[0].content == 'Identity / permissions'
+    assert a[1] is history[1]
+
+
+def test_context_isolation_and_cancellation_cleanup():
+    async def run():
+        async def reply(label):
+            token = reply_emotion_context.set({'emotion': label})
+            try:
+                await asyncio.sleep(0)
+                return reply_emotion_context.get()['emotion']
+            finally:
+                reply_emotion_context.reset(token)
+        assert await asyncio.gather(reply('happy'), reply('sad')) == ['happy', 'sad']
+        assert reply_emotion_context.get() is None
+    asyncio.run(run())
+
+
