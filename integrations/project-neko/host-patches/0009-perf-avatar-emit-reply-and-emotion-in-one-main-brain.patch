+"""Bounded, turn-local emotion header for one-generation spoken replies.
+
+Only a reserved header at the start of an assistant segment is interpreted.
+The rest of the reply remains ordinary streamed text. No extra model call.
+"""
+
+from contextvars import ContextVar
+from dataclasses import replace
+from functools import wraps
+
+EMOTIONS = frozenset({'neutral', 'happy', 'sad', 'angry', 'surprised'})
+HEADER = '[neko_emotion:'
+JOINT_REPLY_INSTRUCTION = (
+    '\n\n[Reply presentation protocol]\n'
+    'For each spoken reply, output one short header first: '
+    '[neko_emotion:neutral], [neko_emotion:happy], [neko_emotion:sad], '
+    '[neko_emotion:angry], or [neko_emotion:surprised]. '
+    'Choose your outward emotion, then immediately write the normal reply in '
+    'the requested language. This header is private UI metadata, not speech. '
+    'Do not describe it, repeat it inside the reply, or put it in tool arguments. '
+    'Native tool calls keep their original schema. No extra emotion-analysis call.'
+)
+
+# A fresh dictionary belongs to each reply coroutine, not to the shared
+# client. ContextVars keep interleaved proactive/user replies separate.
+reply_emotion_context: ContextVar[dict | None] = ContextVar(
+    'reply_emotion_context', default=None
+)
+
+
+def joint_reply_scope(function):
+    """Own metadata in the coroutine, never in an async generator finalizer."""
+    @wraps(function)
+    async def run(self, *args, **kwargs):
+        metadata = (
+            {'mode': 'joint', 'emotion': 'neutral'}
+            if getattr(self, 'joint_reply_emotion', False) else None
+        )
+        token = reply_emotion_context.set(metadata)
+        try:
+            return await function(self, *args, **kwargs)
+        finally:
+            reply_emotion_context.reset(token)
+    return run
+
+
+def presentation_messages(messages):
+    """Add a stable contract to a copy of the system message, never history."""
+    from utils.llm_client.messages import SystemMessage
+
+    result = list(messages)
+    if result and isinstance(result[0], SystemMessage) and isinstance(result[0].content, str):
+        result[0] = replace(result[0], content=result[0].content + JOINT_REPLY_INSTRUCTION)
+    else:
+        result.insert(0, SystemMessage(content=JOINT_REPLY_INSTRUCTION))
+    return result
+
+
+class JointReplyFilter:
+    """Compose before the existing tool-leak filter, including its history path."""
+
+    def __init__(self, inner, metadata):
+        self.inner = inner
+        self.metadata = metadata
+        self.pending = ''
+        self.started = False
+        self.trim_header_gap = False
+
+    def _text(self, chunk, *, final=False):
+        if self.started:
+            if self.trim_header_gap:
+                chunk = chunk.lstrip('\r\n ')
+                self.trim_header_gap = not bool(chunk)
+            return chunk
+        self.pending += chunk
+        candidate = self.pending.lstrip()
+        if not candidate and not final:
+            return ''
+        if HEADER.startswith(candidate) and not final:
+            return ''
+        if final and HEADER.startswith(candidate) and candidate.startswith('[neko_'):
+            self.pending = ''
+            self.started = True
+            return ''
+        if candidate.startswith(HEADER):
+            end = candidate.find(']')
+            if end < 0 and len(candidate) <= 80 and not final:
+                return ''
+            # Truncated/invalid reserved metadata must never be spoken.
+            if end < 0:
+                visible = '' if len(candidate) <= 80 else candidate[80:]
+                label = 'neutral'
+            else:
+                label = candidate[len(HEADER):end]
+                visible = candidate[end + 1:].lstrip('\r\n ')
+            self.metadata['emotion'] = label if label in EMOTIONS else 'neutral'
+            self.trim_header_gap = not bool(visible)
+        else:
+            visible = self.pending
+        self.pending = ''
+        self.started = True
+        return visible
+
+    def feed(self, chunk):
+        return self.inner.feed(self._text(str(chunk)))
+
+    def finalize(self):
+        visible, event = self.inner.feed(self._text('', final=True))
+        tail, final_event = self.inner.finalize()
+        return visible + tail, final_event or event
+
+    def reset(self):
+        self.inner.reset()
+        self.pending = ''
+        self.started = False
+        self.trim_header_gap = False
+
+
+def split_reply_emotion(text):
+    """Buffered counterpart for Phase 2; strip before guards, TTS and history."""
+    from utils.llm_tool_leak_filter import ToolLeakFilter
+
+    metadata = {'mode': 'joint', 'emotion': 'neutral'}
+    parser = JointReplyFilter(ToolLeakFilter(), metadata)
+    visible, _ = parser.feed(text)
+    tail, _ = parser.finalize()
+    return visible + tail, metadata
