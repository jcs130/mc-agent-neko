+def _minecraft_speech_chunks(chunks):
+    """Scrub explicitly marked reasoning from an already buffered game round.
+
+    Local compatible providers can leak tags even with reasoning disabled.
+    Keep every metadata/receipt sentinel and leave ordinary chat untouched.
+    Unmarked text is not guessed to be reasoning.
+    """
+    text = ''.join(getattr(chunk, 'content', '') or '' for chunk in chunks)
+    if not re.search(r'</?think(?:ing)?\s*>', text, re.IGNORECASE):
+        yield from chunks
+        return
+    visible = strip_thinking_segments(text)
+    unclosed = re.search(r'<think(?:ing)?\s*>', visible, re.IGNORECASE)
+    if unclosed:
+        visible = visible[:unclosed.start()].rstrip()
+    for chunk in chunks:
+        if getattr(chunk, 'content', None):
+            chunk = copy.copy(chunk)
+            chunk.content, visible = visible, ''
+        yield chunk
+
