+@pytest.mark.asyncio
+@pytest.mark.parametrize('scope', [False, True])
+@pytest.mark.parametrize('parts,clean', [
+    (['<thi', 'nk>private diagnostic reasoning', '</thi', 'nk>已确认，换个办法。'], '已确认，换个办法。'),
+    (['private diagnostic reasoning', '</think>已确认，换个办法。'], '已确认，换个办法。'),
+    (['<think>unfinished diagnostic reasoning'], ''),
+    (['[neutral]已确认，换个办法。'], '[neutral]已确认，换个办法。'),
+])
+async def test_minecraft_buffer_does_not_send_explicit_thinking_to_speech(scope, parts, clean):
+    from utils.llm_client import LLMStreamChunk
+    from main_logic.tool_calling import ToolDefinition
+
+    llm = _FakeLLM([[*[LLMStreamChunk(content=text) for text in parts],
+                     LLMStreamChunk(content='', finish_reason='stop')]])
+
+    async def handler(_call):
+        pytest.fail('A text-only diagnostic must not execute a tool')
+
+    client = _bare_tool_client(llm, ToolDefinition(name='minecraft_task', description=''), handler, cap=3)
+    chunks = [c async for c in client._astream_with_tools([], _minecraft_execution_turn=scope)]
+    assert ''.join(c.content or '' for c in chunks) == (clean if scope else ''.join(parts))
+    assert len(llm.calls) == 1
+    assert any(c.finish_reason == 'stop' for c in chunks), 'Keep provider completion metadata'
+
+
+@pytest.mark.asyncio
+async def test_minecraft_forced_final_scrubs_thinking_without_losing_tool_receipts():
+    from utils.llm_client import LLMStreamChunk
+    from main_logic.tool_calling import ToolDefinition, ToolResult
+
+    llm = _FakeLLM([[LLMStreamChunk(content='', tool_call_deltas=[{
+        'index': 0, 'id': 'observe', 'type': 'function',
+        'function': {'name': 'minecraft_observe', 'arguments': '{}'},
+    }], finish_reason='tool_calls')], [
+        LLMStreamChunk(content='<think>private diagnostic reasoning'),
+        LLMStreamChunk(content='</think>需要先解决工具缺失。', finish_reason='stop'),
+    ]])
+
+    async def handler(call):
+        return ToolResult(call_id=call.call_id, name=call.name, output={'online': True})
+
+    client = _bare_tool_client(llm, ToolDefinition(name='minecraft_observe', description=''), handler, cap=1)
+    messages = []
+    chunks = [c async for c in client._astream_with_tools(messages, _minecraft_execution_turn=True)]
+    assert ''.join(c.content or '' for c in chunks) == '需要先解决工具缺失。'
+    assert len(llm.calls) == 2
+    assert len([m for m in messages if m.get('role') == 'tool']) == 1
+    assert len([c for c in chunks if getattr(c, 'tool_round_persisted', False)]) == 1
+
+
