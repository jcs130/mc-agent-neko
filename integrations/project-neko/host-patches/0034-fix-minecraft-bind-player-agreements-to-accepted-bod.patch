@@ -3522,6 +3522,38 @@ def test_game_handoff_never_infers_acceptance_from_prose_or_partial_receipts(nam
     assert not _minecraft_async_task_accepted([{'role': 'tool', 'name': name, 'content': json.dumps(receipt)}])
 
 
+@pytest.mark.asyncio
+@pytest.mark.parametrize('receipt,spoken', [
+    ({'status': 'failed', 'pending': False}, False),
+    ({'status': 'blocked', 'communication': {'status': 'not_sent'}}, False),
+    ({'status': 'accepted', 'pending': True, 'completion': 'asynchronous', 'task_id': 'owned',
+      'nativeAccepted': False}, False),
+    ({'status': 'accepted', 'pending': True, 'completion': 'asynchronous', 'task_id': 'owned',
+      'nativeAccepted': True}, True),
+])
+async def test_player_action_prelude_waits_for_actual_receipt_and_preserves_original_history(receipt, spoken):
+    from utils.llm_client import LLMStreamChunk
+    from main_logic.tool_calling import ToolDefinition, ToolResult
+    prelude = '我马上去入口。'
+    llm = _FakeLLM([
+        [LLMStreamChunk(content=prelude), LLMStreamChunk(content='', tool_call_deltas=[{
+            'index': 0, 'id': 'linked', 'type': 'function',
+            'function': {'name': 'minecraft_task', 'arguments': '{}'}}], finish_reason='tool_calls')],
+        [LLMStreamChunk(content='路径不可达，我还在原地。', finish_reason='stop')]])
+
+    async def handler(call):
+        return ToolResult(call_id=call.call_id, name=call.name, output=receipt)
+
+    client = _bare_tool_client(llm, ToolDefinition(name='minecraft_task', description=''), handler, cap=3)
+    messages = [{'role': 'user', 'content': 'Player cooperation'}]
+    chunks = [c async for c in client._astream_with_tools(messages, _minecraft_execution_turn=True)]
+    assert (prelude in ''.join(c.content or '' for c in chunks)) is spoken
+    assert any(m.get('role') == 'assistant' and m.get('content') == prelude for m in messages)
+    assert any(m.get('role') == 'tool' and json.loads(m['content']) == receipt for m in messages)
+    assert any(c.tool_round_persisted for c in chunks)
+    assert len(llm.calls) == (1 if receipt['status'] == 'accepted' else 2)
+
+
