diff --git a/main_logic/omni_offline_client/_tools.py b/main_logic/omni_offline_client/_tools.py
index 3d997ea..1bd5eec 100644
--- a/main_logic/omni_offline_client/_tools.py
+++ b/main_logic/omni_offline_client/_tools.py
@@ -144,6 +144,27 @@ def _minecraft_async_task_accepted(messages):
     return False
 
 
+def _minecraft_pretool_speech_allowed(messages):
+    """Gate outgoing narration on this round's actual task receipt.
+
+    Saved model history and game evidence are unchanged. A failed or
+    unconfirmed task cannot substantiate a pre-tool action promise.
+    """
+    if _minecraft_query_only_round(messages):
+        return False
+    for message in messages:
+        if not isinstance(message, dict) or message.get('role') != 'tool' or message.get('name') != 'minecraft_task':
+            continue
+        try:
+            receipt = json.loads(message.get('content', ''))
+        except (TypeError, ValueError):
+            return False
+        if (not isinstance(receipt, dict) or receipt.get('status') != 'accepted'
+                or receipt.get('nativeAccepted') is False):
+            return False
+    return True
+
+
