@@ -0,0 +1,210 @@
+"""Local VoxCPM2 opt-in routing and the native failure boundary."""
+from functools import partial
+import queue
+import threading
+from unittest.mock import Mock
+
+import pytest
+
+from main_logic.tts_client.local_primary import (
+    LOCAL_PRIMARY_PROVIDER, resolve_local_primary,
+)
+
+
+def online(*args):
+    pass
+
+
+def silent(*args):
+    pass
+
+
+@pytest.fixture
+def config():
+    return {'enabled': True, 'source_voice_id': 'online-yui',
+            'base_url': 'http://127.0.0.1:18041/v1',
+            'model': 'voxcpm2', 'voice': 'yui-local'}
+
+
+def resolve(config, *, voice='online-yui', provider='free', excluded=()):
+    return resolve_local_primary(config, voice, frozenset(excluded),
+                                 (online, 'online-secret', provider), silent)
+
+
+@pytest.mark.parametrize('change', [{}, {'enabled': False},
+    {'source_voice_id': 'different'}, {'model': 'other'}, {'voice': ''},
+    {'base_url': 'http://localhost:18041/v1'},
+    {'base_url': 'https://remote.example/v1'},
+    {'base_url': 'http://user:secret@127.0.0.1:18041/v1'},
+    {'base_url': 'http://127.0.0.1:18041/v1?secret=x'},
+    {'base_url': 'http://127.0.0.1:18041/v1#fragment'},
+    {'base_url': 'http://127.0.0.1:18041/other'},
+    {'base_url': 'http://127.0.0.1:bad/v1'}])
+def test_invalid_or_disabled_keeps_online(config, change):
+    config = {**config, **change} if change else {}
+    assert resolve(config) == (online, 'online-secret', 'free')
+
+
+def test_exact_matching_voice_only_and_explicit_providers_preserved(config):
+    assert resolve(config, voice='another') == (online, 'online-secret', 'free')
+    assert resolve(config, provider='custom') == (online, 'online-secret', 'custom')
+    assert resolve(config, provider='qwen') == (online, 'online-secret', 'qwen')
+    assert resolve_local_primary(config, 'online-yui', frozenset(),
+                                 (silent, None, None), silent) == (silent, None, None)
+
+
+def test_native_http_worker_streams_48khz_and_never_forwards_online_identity(config, monkeypatch):
+    from main_logic.tts_client.workers import openai as worker_module
+    captured = Mock()
+    monkeypatch.setattr(worker_module, 'openai_tts_worker', captured)
+    worker, key, provider = resolve(config)
+    assert isinstance(worker, partial)
+    assert (key, provider) == ('', LOCAL_PRIMARY_PROVIDER)
+    worker('requests', 'responses', 'must-not-leak', 'online-yui')
+    adapter, *args = captured.call_args.args
+    assert adapter.queue == 'requests'
+    assert args == ['responses', '', 'yui-local']
+    options = captured.call_args.kwargs
+    assert options['extra_body_overrides'] == {'stream': True, 'stream_format': 'audio'}
+    assert options['pcm_sample_rate'] == 48000
+    assert options['max_retries'] == 0
+    assert options['base_url'] == config['base_url']
+    assert options['safe_error_provider'] == LOCAL_PRIMARY_PROVIDER
+    assert options['text_transform']('你好。', 'sid') == '(自然、亲切，语速适中)你好。'
+
+
+def test_tone_is_per_speech_id_and_never_changes_native_receipts():
+    from main_logic.tts_client.local_primary import _StyledRequestQueue, VOICE_STYLE_SENTINEL
+    requests = queue.Queue()
+    adapter = _StyledRequestQueue(requests)
