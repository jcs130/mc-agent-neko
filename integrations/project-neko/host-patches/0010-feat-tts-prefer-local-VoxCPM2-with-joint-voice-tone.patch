+def clean_voice_style(value):
+    """Accept a bounded description that cannot escape VoxCPM2's parentheses."""
+    if not isinstance(value, str):
+        return ''
+    value = value.strip()
+    if not value or len(value) > 32:
+        return ''
+    if any(ord(c) < 32 or c in '()（）[]【】{}<>|' for c in value):
+        return ''
+    return value
+
+
+def reply_voice_style(metadata):
+    """Use the same generation's description, with modest emotion defaults."""
+    metadata = metadata if isinstance(metadata, dict) else {}
+    return clean_voice_style(metadata.get('voice_style')) or {
+        'happy': '轻快、带笑意，语速适中',
+        'sad': '轻柔、略带低落，语速稍慢',
+        'angry': '认真、坚定，语速适中',
+        'surprised': '略带惊讶，语速适中',
+    }.get(metadata.get('emotion'), '自然、亲切，语速适中')
+
