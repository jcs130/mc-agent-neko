+"""Exact-voice local speech preference with the existing online failover."""
+from dataclasses import replace
+from functools import partial
+from urllib.parse import urlsplit
+
+from utils.joint_reply_emotion import clean_voice_style, reply_voice_style
+
+LOCAL_PRIMARY_PROVIDER = 'voxcpm_local_primary'
+VOICE_STYLE_SENTINEL = '__voice_style__'
+
+
+class _StyledRequestQueue:
+    """Consume private controls; preserve native text and interrupt protocol."""
+
+    def __init__(self, queue):
+        self.queue = queue
+        self.styles = {}
+
+    def get(self, *args, **kwargs):
+        while True:
+            sid, text = self.queue.get(*args, **kwargs)
+            if sid == VOICE_STYLE_SENTINEL:
+                if isinstance(text, dict):
+                    speech_id = text.get('speech_id')
+                    style = clean_voice_style(text.get('style'))
+                    if isinstance(speech_id, str) and speech_id and style:
+                        self.styles[speech_id] = style
+                        while len(self.styles) > 32:
+                            self.styles.pop(next(iter(self.styles)))
+                continue
+            if sid in {'__interrupt__', '__shutdown__'}:
+                self.styles.clear()
+            return sid, text
+
+    def transform(self, text, speech_id):
+        style = self.styles.get(speech_id) or reply_voice_style(None)
+        return f'({style}){text}'
+
+
+def _valid_config(config, voice_id):
+    if not isinstance(config, dict) or config.get('enabled') is not True:
+        return False
+    if not voice_id or config.get('source_voice_id') != voice_id:
+        return False
+    try:
+        url = urlsplit(str(config.get('base_url') or ''))
+        return bool(
+            url.scheme == 'http' and url.hostname in {'127.0.0.1', '::1'}
+            and url.port and not url.username and not url.password
+            and not url.query and not url.fragment and url.path == '/v1'
+            and isinstance(config.get('voice'), str) and config['voice'].strip()
+            and config.get('model') == 'voxcpm2'
+        )
+    except (TypeError, ValueError):
+        return False
+
+
+def voxcpm_primary_worker(request_queue, response_queue, api_key, voice_id, *,
+                          base_url, local_voice):
+    from .workers.openai import openai_tts_worker
+    styled_queue = _StyledRequestQueue(request_queue)
+    # Preserve native sentence ordering, progress receipts and cancellation.
+    # Reference-only speaker names avoid the pinned Omni continuation cache bug.
+    return openai_tts_worker(
+        styled_queue, response_queue, '', local_voice,
+        base_url=base_url, model='voxcpm2', voice=local_voice,
+        label='Local VoxCPM2', safe_error_provider=LOCAL_PRIMARY_PROVIDER,
+        extra_body_overrides={'stream': True, 'stream_format': 'audio'},
+        request_timeout=60.0, max_retries=0, pcm_sample_rate=48000,
+        text_transform=styled_queue.transform,
+    )
+
+
+def resolve_local_primary(config, voice_id, excluded, primary, silent_worker):
+    """Only replace the matching online free voice; exclusions end preference."""
+    if (primary[0] is silent_worker or LOCAL_PRIMARY_PROVIDER in excluded
+            or primary[2] not in {'free', 'free_local_backup'}
+            or not _valid_config(config, voice_id)):
+        return primary
+    return (partial(voxcpm_primary_worker, base_url=config['base_url'],
+                    local_voice=config['voice']), '', LOCAL_PRIMARY_PROVIDER)
+
+
+def register_local_primary_provider(registry, architectural_metadata):
+    registry.register(registry.TTSProvider(
+        key=LOCAL_PRIMARY_PROVIDER, kind='local', priority=1000,
+        capabilities=frozenset({'preset'}), is_selected=lambda ctx: False,
+        resolve=lambda ctx: None, fallback_on_failure=True,
+        tts_config_visible=False,
+    ))
+    architectural_metadata[LOCAL_PRIMARY_PROVIDER] = replace(
+        architectural_metadata['openai'], name=LOCAL_PRIMARY_PROVIDER,
+        notes='Opt-in local VoxCPM2 reference voice with native online failover',
+    )
