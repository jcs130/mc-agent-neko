+def test_real_http_sentence_worker_styles_payload_but_acknowledges_clean_text(monkeypatch):
+    from tests.unit.test_openai_compatible_tts import _install_fake_openai, _wait_for_item
+    from main_logic.tts_client.local_primary import voxcpm_primary_worker, VOICE_STYLE_SENTINEL
