@@ -104,4 +101,7 @@ def test_host_extra_budget_requires_execution_route(wrong):
                 'channel': 'plugin:game_agent_minecraft', 'coalesce_key': 'mc_keep_going',
                 'delivery_mode': 'proactive', 'summary': body, 'detail': body, **wrong}
     manager.enqueue_agent_callback(callback)
