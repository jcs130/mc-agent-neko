@@ -724,10 +725,64 @@ async def _non_bistream_tts_main_loop(
 
     # ── 主循环 ──
     loop = asyncio.get_running_loop()
+    deferred_requests = deque()
+    pending_request = None
+
+    def _read_request():
+        # Reuse the outstanding blocking get: cancelling an executor Future
+        # cannot stop queue.get and would leave a second consumer stealing data.
+        nonlocal pending_request
+        if pending_request is None:
+            pending_request = loop.run_in_executor(None, request_queue.get)
+        return pending_request
+
+    async def _interrupt_speech():
+        nonlocal current_speech_id
+        audio_done.begin_interrupt()
+        try:
+            await _cancel_all()
+        finally:
+            audio_done.end_interrupt()
+        sentence_buf.clear()
+        current_speech_id = None
+
+    async def _drain_interruptibly():
+        nonlocal pending_request
+        closing = asyncio.create_task(_drain_remaining())
+        try:
+            while not closing.done():
+                request = _read_request()
+                ready, _ = await asyncio.wait(
+                    (closing, request), return_when=asyncio.FIRST_COMPLETED
+                )
+                if request in ready:
+                    item = request.result()
+                    pending_request = None
+                    if item[0] == "__interrupt__":
+                        # Preserve FIFO for ordinary rounds, but an explicit
+                        # interrupt invalidates all queued pre-interrupt text.
+                        deferred_requests.clear()
+                        closing.cancel()
+                        await _interrupt_speech()
+                        return False, True
+                    deferred_requests.append(item)
+                    if item[0] == TTS_SHUTDOWN_SENTINEL:
+                        # Shutdown remains FIFO. Do not start another blocking
+                        # queue.get after consuming the final sentinel.
+                        return await closing, False
+            return closing.result(), False
+        finally:
+            if not closing.done():
+                closing.cancel()
+            await asyncio.gather(closing, return_exceptions=True)
 
     while True:
