+def test_local_pcm_waits_for_complete_sentence_and_preserves_every_sample(monkeypatch):
+    from tests.unit.test_openai_compatible_tts import _install_fake_openai, _wait_for_item
+    from main_logic.tts_client.local_primary import voxcpm_primary_worker
+    gate, started = threading.Event(), threading.Event()
+    pcm = np.arange(9600, dtype='<i2').tobytes()
+
+    async def slow_chunks():
+        yield pcm[:9601]  # Transport boundaries may bisect a PCM sample.
+        started.set()
+        while not gate.is_set():
+            await asyncio.sleep(0.01)
+        yield pcm[9601:]
+
+    _install_fake_openai(monkeypatch, slow_chunks)
+    requests, responses = queue.Queue(), queue.Queue()
+    thread = threading.Thread(target=voxcpm_primary_worker,
+        args=(requests, responses, '', 'ignored'),
+        kwargs={'base_url': 'http://127.0.0.1:18041/v1', 'local_voice': 'yui-local'}, daemon=True)
+    thread.start()
+    try:
+        _wait_for_item(responses, lambda item: item == ('__ready__', True))
+        requests.put(('s1', '测试连续语音。'))
+        requests.put((None, None))
+        assert started.wait(5)
+        # Nothing may reach playback while the slow HTTP sentence is incomplete.
+        with pytest.raises(queue.Empty):
+            responses.get(timeout=0.2)
+        gate.set()
+        audio = []
+        while True:
+            item = responses.get(timeout=5)
+            if isinstance(item, bytes):
+                audio.append(item)
+            elif item == ('__audio_done__', 's1'):
+                break
+        assert b''.join(audio) == pcm
+    finally:
+        gate.set()
+        requests.put(('__shutdown__', None))
+        thread.join(5)
+        assert not thread.is_alive()
+
+
+def test_local_truncated_sentence_never_leaks_partial_audio_before_fallback(monkeypatch):
+    from tests.unit.test_openai_compatible_tts import _install_fake_openai, _wait_for_item
+    from main_logic.tts_client.local_primary import voxcpm_primary_worker
+    _install_fake_openai(monkeypatch, [b'\x01\x00' * 4800, b'\x01'])
+    requests, responses = queue.Queue(), queue.Queue()
+    thread = threading.Thread(target=voxcpm_primary_worker,
+        args=(requests, responses, '', 'ignored'),
+        kwargs={'base_url': 'http://127.0.0.1:18041/v1', 'local_voice': 'yui-local'}, daemon=True)
+    thread.start()
+    try:
+        _wait_for_item(responses, lambda item: item == ('__ready__', True))
+        requests.put(('broken', '不应播放残缺片段。'))
+        requests.put((None, None))
+        requests.put(('__shutdown__', None))
+        thread.join(5)
+        assert not thread.is_alive()
+        items = []
+        while not responses.empty():
+            items.append(responses.get_nowait())
+        assert not any(isinstance(item, bytes) for item in items)
+        assert ('__tts_sentence_failed__', 'broken', '不应播放残缺片段。') in items
+        assert ('__tts_sentence_done__', 'broken', '不应播放残缺片段。') not in items
+    finally:
+        if thread.is_alive():
+            requests.put(('__shutdown__', None))
+            thread.join(5)
+
