-            sid, tts_text = await loop.run_in_executor(None, request_queue.get)
+            if deferred_requests:
+                sid, tts_text = deferred_requests.popleft()
+            else:
+                sid, tts_text = await _read_request()
+                pending_request = None
         except Exception:
             break
 
