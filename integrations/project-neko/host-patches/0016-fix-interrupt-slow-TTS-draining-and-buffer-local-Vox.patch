+def test_interrupt_after_terminal_marker_cancels_slow_synthesis_before_next_round():
+    gate, started = threading.Event(), threading.Event()
+    requests, responses, thread = _start_worker(_gated_setup(gate, started, "Old."))
+    try:
+        requests.put(("old", "Old."))
+        requests.put((None, None))
+        assert started.wait(5)
+        # Ordinary queued rounds remain FIFO unless an explicit interrupt arrives.
+        requests.put(("also-old", "Discarded."))
+        requests.put((None, None))
+        requests.put(("__interrupt__", None))
+        requests.put(("new", "Current."))
+        requests.put((None, None))
+        assert _wait_for_item(
+            responses, lambda item: item == b"audio-Current.", timeout=1.5
+        ) == b"audio-Current."
+        assert not gate.is_set()
+        _wait_for_item(responses, lambda item: item == (TTS_AUDIO_DONE_SENTINEL, "new"))
+        assert not any(
+            item in (b"audio-Old.", b"audio-Discarded.")
+            or (isinstance(item, tuple) and item[-1] in ("old", "also-old"))
+            for item in _drain(responses)
+        )
+    finally:
+        gate.set()
+        _shutdown(requests, thread)
+
