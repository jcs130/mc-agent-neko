index a8788f6..bcacee7 100644
--- a/utils/llm_client/prefill.py
+++ b/utils/llm_client/prefill.py
@@ -1,7 +1,9 @@
 """Opt-in policy for the local Strata engine. Only Minecraft owns its pin."""
 from contextvars import ContextVar
 import asyncio
+import json
 import os
+import re
 from urllib.parse import urlsplit
 import weakref
 
@@ -46,8 +48,49 @@ def request_policy(body: dict, base_url, call_type: str) -> dict:
 
 
 def project_game_history(messages):
-    """Keep complete game history; caching must not discard evidence."""
-    return messages
+    """Index earlier archived observations in this request, never saved history.
+
+    Exact detail reads stay whole. A later observation does not need another
+    copy of each earlier current-fact view: its complete immutable snapshot is
+    already available through the same observe tool. Keep the last observation
+    and all authorization/error/human messages; this is not a text budget.
+    """
+    observations = []
+    for index, message in enumerate(messages):
+        if (not isinstance(message, dict) or message.get('role') != 'tool'
+                or message.get('name') != 'minecraft_observe'):
+            continue
+        if not isinstance(message.get('content'), str):
+            continue
+        try:
+            value = json.loads(message['content'])
+        except (ValueError, TypeError):
+            continue
+        if not isinstance(value, dict):
+            continue
+        evidence = value.get('rawEvidence')
+        if (value.get('inputPolicy') != 'current_facts_with_full_evidence'
+                or value.get('fresh') is not True or value.get('status') not in (None, 'ok')
+                or not isinstance(evidence, dict)
+                or not isinstance(evidence.get('id'), str)
+                or not re.fullmatch(r'[0-9a-f]{64}', evidence['id'])):
+            continue
+        observations.append((index, value, evidence))
+    projected = None
+    # A detail read (for example a book page) does not replace current facts.
+    # Keep the newest complete current-fact view even after further lookups.
+    for index, value, evidence in observations[:-1]:
+        message = messages[index]
+        view = {key: value[key] for key in ('rawEvidence', 'available', 'fresh', 'online',
+                'status', 'observedAt', 'sessionId', 'sequence', 'source', 'decision',
+                'authentication', 'resources', 'protection', 'collision') if key in value}
+        view.update(inputPolicy='historical_observation_query_index', historical=True,
+            read={'tool': 'minecraft_observe', 'evidence_id': evidence['id'], 'reference_path': '/'},
+            note='Earlier observation, not current authority. Its complete original snapshot remains available at the exact evidence ID and JSON paths. Latest observations and human stop/pause take precedence; unknown detail is not empty or successful.')
+        if projected is None:
+            projected = list(messages)
+        projected[index] = {**message, 'content': json.dumps(view, ensure_ascii=False, separators=(',', ':'))}
+    return messages if projected is None else projected
 
 
 async def background_admission(base_url, call_type, *, probe=None, max_wait=10.0, interval=0.25):
