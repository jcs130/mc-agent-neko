+import asyncio
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from utils.llm_client import timing
+from utils.llm_client.openai_client import ChatOpenAI
+
+
+def test_metadata_never_contains_text_and_missing_usage_is_unknown():
+    now, records = [0.0], []
+    trace = timing.RequestTrace('PRIVATE_TYPE', False, now=lambda: now[0], wall=lambda: 1700000000, sink=records.append)
+    now[0] = .1; trace.mark('assembly_start')
+    now[0] = .12; trace.mark('dispatch')
+    now[0] = .62; trace.returned({'prompt_tokens': 1000, 'completion_tokens': 20,
+        'prompt_tokens_details': {'cached_tokens': 800}, 'content': 'PRIVATE_RESPONSE'})
+    trace.finish('completed')
+    record = records[-1]
+    assert record['prepare_wait_ms'] == 100
+    assert record['prompt_assembly_ms'] == 20
+    assert record['sdk_roundtrip_ms'] == 500
+    assert record['new_input_tokens'] == 200
+    assert record['first_effective_content_at'] is None
+    assert record['server_queue_ms'] is None
+    assert 'PRIVATE' not in json.dumps(records)
+    other = timing.RequestTrace('conversation', False, sink=records.append)
+    other.returned({'prompt_tokens': 10, 'prompt_tokens_details': {'cached_tokens': 100}})
+    other.finish('completed')
+    assert records[-1]['reused_tokens'] is None
+    assert records[-1]['new_input_tokens'] is None
+
+
+@pytest.mark.asyncio
+async def test_real_client_dispatch_records_admission_and_keeps_request_body_clean(monkeypatch):
+    records = []
+    monkeypatch.setattr(timing, 'new_trace', lambda _client, stream=False:
+        timing.RequestTrace('proactive', stream, sink=records.append))
+    async def admission(*_args):
+        await asyncio.sleep(.01)
+    monkeypatch.setattr('utils.llm_client.prefill.background_admission', admission)
+    client = ChatOpenAI(model='local', base_url='http://127.0.0.1:18030/v1', api_key='PRIVATE_KEY')
+    resp = SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content='PRIVATE_RESPONSE'), finish_reason='stop')],
+        usage=SimpleNamespace(model_dump=lambda: {'prompt_tokens': 12, 'completion_tokens': 1}))
+    client._aclient.chat.completions.create = AsyncMock(return_value=resp)
+    result = await client.ainvoke([{'role': 'user', 'content': 'PRIVATE_PROMPT'}])
+    assert result.content == 'PRIVATE_RESPONSE'
+    assert records[-1]['prepare_wait_ms'] >= 9
+    assert records[-1]['input_tokens'] == 12
+    assert records[-1]['reused_tokens'] is None
+    assert 'PRIVATE' not in json.dumps(records)
+    kwargs = client._aclient.chat.completions.create.call_args.kwargs
+    assert 'request_id' not in kwargs
+    assert kwargs['messages'][0]['content'] == 'PRIVATE_PROMPT'
+    await client.aclose()
+
+
+@pytest.mark.asyncio
+async def test_stream_excludes_reasoning_and_accounts_for_consumer_pause(monkeypatch):
+    records = []
+    monkeypatch.setattr(timing, 'new_trace', lambda _client, stream=False:
+        timing.RequestTrace('proactive', stream, sink=records.append))
+    @timing.trace_stream
+    async def source(_client):
+        timing.mark('assembly_start'); timing.mark('dispatch')
+        yield SimpleNamespace(content='', reasoning_content='PRIVATE_THINK', tool_call_deltas=None,
+            finish_reason=None, usage_metadata=None)
+        yield SimpleNamespace(content='PRIVATE_TEXT', tool_call_deltas=None, finish_reason=None, usage_metadata=None)
+        yield SimpleNamespace(content='', tool_call_deltas=None, finish_reason='stop',
+            usage_metadata={'prompt_tokens': 100, 'completion_tokens': 2, 'prompt_tokens_details': {'cached_tokens': 90}})
+    async for _chunk in source(None):
+        await asyncio.sleep(.01)
+    record = records[-1]
+    assert record['first_effective_content_at'] is not None
+    assert record['consumer_pause_ms'] >= 25
+    assert record['new_input_tokens'] == 10
+    assert record['command_validated_at'] is None
+    assert 'PRIVATE' not in json.dumps(records)
+
+
+@pytest.mark.asyncio
+async def test_concurrent_calls_have_distinct_traces_and_errors_never_log_messages(monkeypatch):
+    records = []
+    monkeypatch.setattr(timing, 'new_trace', lambda _client, stream=False:
+        timing.RequestTrace('conversation', stream, sink=records.append))
+    @timing.trace_async
+    async def source(_client, fail=False):
+        timing.mark('assembly_start'); timing.mark('dispatch')
+        await asyncio.sleep(.005)
+        if fail:
+            raise RuntimeError('PRIVATE_ERROR_KEY')
+        return SimpleNamespace(response_metadata={'token_usage': {'prompt_tokens': 4}})
+    results = await asyncio.gather(source(None), source(None, True), return_exceptions=True)
+    assert isinstance(results[1], RuntimeError)
+    finished = [r for r in records if r['event'] == 'finished']
+    assert len(finished) == 2
+    assert len({r['request_id'] for r in finished}) == 2
+    assert {r['outcome'] for r in finished} == {'completed', 'error'}
+    assert 'PRIVATE' not in json.dumps(records)
+    assert timing.current_trace.get() is None
+
+
+def test_diagnostics_default_off(monkeypatch):
+    monkeypatch.delenv('NEKO_LLM_TIMING', raising=False)
+    assert timing.new_trace(MagicMock()) is None
+
+
+@pytest.mark.asyncio
+async def test_early_stream_close_releases_context_and_closes_source(monkeypatch):
+    records, closed = [], []
+    monkeypatch.setattr(timing, 'new_trace', lambda _client, stream=False:
+        timing.RequestTrace('proactive', stream, sink=records.append))
+    @timing.trace_stream
+    async def source(_client):
+        try:
+            timing.mark('assembly_start'); timing.mark('dispatch')
+            yield SimpleNamespace(content='', reasoning_content='PRIVATE_THINK', tool_call_deltas=[{'id': 'PRIVATE_ID', 'function': {}}])
+            yield SimpleNamespace(content='never consumed')
+        finally:
+            closed.append(True)
+    stream = source(None)
+    await stream.__anext__()
+    assert timing.current_trace.get() is None
+    await stream.aclose()
+    assert closed == [True]
+    assert records[-1]['outcome'] == 'cancelled'
+    assert records[-1]['first_effective_content_at'] is None
+    assert records[-1]['completed_at'] is None
+
+
+@pytest.mark.asyncio
+async def test_broken_usage_getter_cannot_fail_a_successful_call(monkeypatch):
+    records = []
+    monkeypatch.setattr(timing, 'new_trace', lambda _client, stream=False:
+        timing.RequestTrace('conversation', stream, sink=records.append))
+    class Reply:
+        @property
+        def usage(self):
+            raise RuntimeError('PRIVATE_PROVIDER_METADATA')
+    reply = Reply()
+    @timing.trace_async
+    async def source(_client):
+        return reply
+    assert await source(None) is reply
+    assert records[-1]['outcome'] == 'completed'
+    assert records[-1]['input_tokens'] is None
+
+
+@pytest.mark.asyncio
+async def test_real_stream_keeps_tool_fragments_and_provider_body_unchanged(monkeypatch):
+    records = []
+    monkeypatch.setattr(timing, 'new_trace', lambda _client, stream=False:
+        timing.RequestTrace('proactive', stream, scope='minecraft', sink=records.append))
+    client = ChatOpenAI(model='local', base_url='http://127.0.0.1:18030/v1', api_key='PRIVATE_KEY',
+        tools=[{'type': 'function', 'function': {'name': 'game', 'parameters': {'type': 'object'}}}])
+    async def raw_chunks():
+        yield SimpleNamespace(choices=[SimpleNamespace(delta=SimpleNamespace(content='', tool_calls=None,
+            reasoning_content='PRIVATE_REASONING'), finish_reason=None)], usage=None)
+        yield SimpleNamespace(choices=[SimpleNamespace(delta=SimpleNamespace(content='', tool_calls=[
+            SimpleNamespace(index=0, id='PRIVATE_TOOL_ID', type='function',
+                function=SimpleNamespace(name='game', arguments='{"note":"PRIVATE_ARGUMENT"}'))]),
+            finish_reason='tool_calls')], usage=None)
+        yield SimpleNamespace(choices=[], usage=SimpleNamespace(model_dump=lambda:
+            {'prompt_tokens': 200, 'completion_tokens': 10, 'prompt_tokens_details': {'cached_tokens': 150}}))
+    client._aclient.chat.completions.create = AsyncMock(return_value=raw_chunks())
+    chunks = [chunk async for chunk in client.astream([{'role': 'user', 'content': 'PRIVATE_PROMPT'}])]
+    assert chunks[1].tool_call_deltas[0]['function']['arguments'] == '{"note":"PRIVATE_ARGUMENT"}'
+    record = records[-1]
+    assert record['outcome'] == 'completed'
+    assert record['new_input_tokens'] == 50
+    assert record['tool_count'] == 1
+    assert record['first_effective_content_at'] is not None
+    assert record['command_validated_at'] is None
+    assert 'PRIVATE' not in json.dumps(records)
+    assert client._aclient.chat.completions.create.call_args.kwargs['stream'] is True
+    await client.aclose()
