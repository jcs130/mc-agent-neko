diff --git a/utils/llm_client/timing.py b/utils/llm_client/timing.py
new file mode 100644
index 0000000..7d357b5
--- /dev/null
+++ b/utils/llm_client/timing.py
@@ -0,0 +1,279 @@
+"""Opt-in local client timing. Content and credentials never enter the schema."""
+import asyncio
+from contextvars import ContextVar
+from datetime import datetime, timezone
+import functools
+import json
+import logging
+from logging.handlers import RotatingFileHandler
+import os
+from pathlib import Path
+import queue
+import threading
+import time
+import uuid
+
+current_trace = ContextVar('llm_metadata_trace', default=None)
+_TYPES = frozenset({'proactive', 'conversation', 'emotion', 'long_response_summary', 'galgame_options',
+    'agent_cua', 'activity_enrichment', 'topic_deep_search', 'memory_summary'})
+_writer = None
+_writer_lock = threading.Lock()
+
+
+def _sink(record):
+    global _writer
+    if _writer is None:
+        with _writer_lock:
+            if _writer is None:
+                directory = Path(os.environ.get('NEKO_RUNTIME_STATE_DIR') or 'logs') / 'llm_timing'
+                directory.mkdir(parents=True, exist_ok=True)
+                # Own only metadata logs, never other runtime/control files.
+                files = sorted(directory.glob('host-*.jsonl*'), key=lambda p: p.stat().st_mtime)
+                size = sum(p.stat().st_size for p in files)
+                for file in files:
+                    if size <= 16 * 1024 * 1024:
+                        break
+                    size -= file.stat().st_size
+                    file.unlink()
+                handler = RotatingFileHandler(directory / f'host-{os.getpid()}.jsonl',
+                    maxBytes=8 * 1024 * 1024, backupCount=1, encoding='utf8')
+                pending = queue.Queue(maxsize=256)
+                def consume():
+                    while True:
+                        line = pending.get()
+                        try:
+                            handler.emit(logging.LogRecord('llm_timing', logging.INFO, '', 0, line, (), None))
+                        except Exception:
+                            pass
+                threading.Thread(target=consume, name='llm-metadata-writer', daemon=True).start()
+                _writer = pending
+    try:
+        _writer.put_nowait(json.dumps(record, separators=(',', ':')))
+    except queue.Full:
+        pass  # Diagnostics must not block model or audio work.
+
+
+def _count(value):
+    return value if type(value) is int and value >= 0 else None
+
+
+def _usage(result):
+    try:
+        usage = getattr(result, 'usage_metadata', None)
+        if not isinstance(usage, dict):
+            meta = getattr(result, 'response_metadata', None)
+            usage = meta.get('token_usage') if isinstance(meta, dict) else None
+        if not isinstance(usage, dict):
+            usage = getattr(result, 'usage', None)
+            dump = getattr(usage, 'model_dump', None)
+            usage = dump() if callable(dump) else usage
+        return usage if isinstance(usage, dict) else {}
+    except Exception:
+        return {}
+
+
+class RequestTrace:
+    def __init__(self, call_type, stream, *, scope='other', now=time.monotonic, wall=time.time, sink=_sink):
+        self.now, self.sink = now, sink
+        self.start, self.wall = now(), wall()
+        self.request_id = str(uuid.uuid4())
+        self.call_type = call_type if call_type in _TYPES else 'other'
+        self.scope = scope if scope in {'minecraft', 'background'} else 'other'
+        self.stream, self.closed = bool(stream), False
+        self.points, self.usage = {}, {}
+        self.body_metadata = {}
+        self.pause, self.pause_before_complete = 0.0, 0.0
+
+    def mark(self, stage):
+        if self.closed or stage not in {'assembly_start', 'dispatch'} or stage in self.points:
+            return
+        self.points[stage] = self.now()
+        if stage == 'dispatch':
+            self.emit('dispatch')
+
+    def returned(self, usage):
+        if self.closed:
+            return
+        self.points['completed'] = self.now()
+        self.pause_before_complete = self.pause
+        usage = usage if isinstance(usage, dict) else {}
+        details = usage.get('prompt_tokens_details') or {}
+        input_tokens = _count(usage.get('prompt_tokens'))
+        reused = _count(details.get('cached_tokens')) if isinstance(details, dict) else None
+        if input_tokens is None or reused is None or reused > input_tokens:
+            reused = None
+        self.usage = {'input_tokens': input_tokens, 'reused_tokens': reused,
+            'new_input_tokens': input_tokens - reused if reused is not None else None,
+            'output_tokens': _count(usage.get('completion_tokens'))}
+
+    def observe(self, result):
+        content = getattr(result, 'content', None)
+        tools = getattr(result, 'tool_call_deltas', None)
+        tool_payload = isinstance(tools, list) and any(isinstance(tool, dict)
+            and isinstance(tool.get('function'), dict)
+            and (tool['function'].get('name') or tool['function'].get('arguments')) for tool in tools)
+        if self.stream and 'first_content' not in self.points and (
+            isinstance(content, str) and content.strip() or tool_payload):
+            self.points['first_content'] = self.now()
+        usage = _usage(result)
+        if usage or self.stream and getattr(result, 'finish_reason', None):
+            self.returned(usage or self.usage)
+
+    def finish(self, outcome):
+        if self.closed:
+            return
+        self.closed = True
+        if outcome == 'completed' and 'completed' not in self.points:
+            self.points['completed'] = self.now()
+            self.pause_before_complete = self.pause
+        self.emit('finished', outcome if outcome in {'completed', 'error', 'cancelled', 'superseded'} else 'error')
+
+    def emit(self, event, outcome=None):
+        def ms(end, start):
+            return None if end is None or start is None else round(max(0, end - start) * 1000, 2)
+        def iso(point):
+            return None if point is None else datetime.fromtimestamp(self.wall + point - self.start, timezone.utc).isoformat()
+        p = self.points
+        interval = ms(p.get('completed'), p.get('dispatch'))
+        record = {'schema': 1, 'caller': 'neko_host', 'event': event, 'outcome': outcome,
+            'request_id': self.request_id, 'call_type': self.call_type, 'request_scope': self.scope,
+            'task_version': None, 'response_mode': 'stream' if self.stream else 'non_stream',
+            'task_version_source': 'not_propagated',
+            'send_boundary': 'sdk_call', 'sdk_retry_visibility': 'unknown',
+            'started_at': iso(self.start), 'sdk_dispatch_at': iso(p.get('dispatch')),
+            'completed_at': iso(p.get('completed')), 'first_effective_content_at': iso(p.get('first_content')),
+            'first_effective_content_ms': ms(p.get('first_content'), self.start), 'command_validated_at': None,
+            'client_elapsed_ms': ms(self.now(), self.start), 'prepare_wait_ms': ms(p.get('assembly_start'), self.start),
+            'prompt_assembly_ms': ms(p.get('dispatch'), p.get('assembly_start')), 'sdk_roundtrip_ms': interval,
+            'consumer_pause_ms': round(self.pause * 1000, 2),
+            'consumer_pause_before_complete_ms': round(self.pause_before_complete * 1000, 2),
+            'server_queue_ms': None, 'server_input_ms': None, 'server_output_ms': None,
+            'unattributed_dispatch_ms': interval,
+            'input_tokens': self.usage.get('input_tokens'), 'reused_tokens': self.usage.get('reused_tokens'),
+            'new_input_tokens': self.usage.get('new_input_tokens'), 'output_tokens': self.usage.get('output_tokens')}
+        record.update(self.body_metadata)
+        try:
+            self.sink(record)
+        except Exception:
+            pass
+
+
+def new_trace(client, stream=False):
+    if os.environ.get('NEKO_LLM_TIMING') != '1':
+        return None
+    try:
+        from . import prefill
+        from utils.token_tracker.call_context import _current_call_type
+        if not prefill.enabled(client.base_url):
+            return None
+        call_type = _current_call_type.get()
+        scope = 'minecraft' if prefill.game_scope.get() is not None else 'background' if call_type in prefill._BACKGROUND else 'other'
+        return RequestTrace(call_type, stream, scope=scope)
+    except Exception:
+        return None
+
+
+def mark(stage):
+    trace = current_trace.get()
+    if trace is not None:
+        trace.mark(stage)
+
+
+def dispatch(body):
+    trace = current_trace.get()
+    if trace is None:
+        return
+    try:
+        extra = body.get('extra_body') or {}
+        messages = body.get('messages') or []
+        effort = extra.get('reasoning_effort', body.get('reasoning_effort'))
+        # Body inspection supplies numbers/flags only, never copies text or schemas.
+        trace.body_metadata = {'message_count': len(messages), 'tool_count': len(body.get('tools') or []),
+            'image_count': sum(isinstance(part, dict) and part.get('type') in {'image', 'image_url', 'input_image'}
+                for message in messages if isinstance(message, dict) and isinstance(message.get('content'), list)
+                for part in message['content']),
+            'max_output_tokens': _count(body.get('max_completion_tokens', body.get('max_tokens'))),
+            'reasoning_effort': effort if effort in {'none', 'low', 'medium', 'high'} else None,
+            'explicit_prefix': bool(extra.get('strata_prefix')), 'checkpoint': extra.get('strata_checkpoint')
+                if type(extra.get('strata_checkpoint')) is bool else None}
+        trace.mark('dispatch')
+    except Exception:
+        pass
+
+
+def trace_async(fn):
+    @functools.wraps(fn)
+    async def wrapped(client, *args, **kwargs):
+        trace = new_trace(client)
+        token = current_trace.set(trace)
+        try:
+            result = await fn(client, *args, **kwargs)
+            if trace:
+                trace.returned(_usage(result)); trace.finish('completed')
+            return result
+        except BaseException as exc:
+            if trace:
+                trace.finish('cancelled' if isinstance(exc, asyncio.CancelledError) else
+                    'superseded' if type(exc).__name__ == 'BackgroundSuperseded' else 'error')
+            raise
+        finally:
+            current_trace.reset(token)
+    return wrapped
+
+
+def trace_sync(fn):
+    @functools.wraps(fn)
+    def wrapped(client, *args, **kwargs):
+        trace = new_trace(client)
+        token = current_trace.set(trace)
+        try:
+            result = fn(client, *args, **kwargs)
+            if trace:
+                trace.returned(_usage(result)); trace.finish('completed')
+            return result
+        except BaseException:
+            if trace:
+                trace.finish('error')
+            raise
+        finally:
+            current_trace.reset(token)
+    return wrapped
+
+
+def trace_stream(fn):
+    @functools.wraps(fn)
+    async def wrapped(client, *args, **kwargs):
+        trace = new_trace(client, stream=True)
+        source = fn(client, *args, **kwargs)
+        outcome = 'cancelled'
+        try:
+            while True:
+                # Never leave our context installed while yielding to a consumer.
+                token = current_trace.set(trace)
+                try:
+                    chunk = await source.__anext__()
+                except StopAsyncIteration:
+                    outcome = 'completed'
+                    break
+                finally:
+                    current_trace.reset(token)
+                if trace:
+                    try:
+                        trace.observe(chunk)
+                    except Exception:
+                        pass
+                yielded = time.monotonic() if trace else 0.0
+                yield chunk
+                if trace:
+                    trace.pause += time.monotonic() - yielded
+        except BaseException as exc:
+            outcome = 'cancelled' if isinstance(exc, (asyncio.CancelledError, GeneratorExit)) else (
+                'superseded' if type(exc).__name__ == 'BackgroundSuperseded' else 'error')
+            raise
+        finally:
+            try:
+                await source.aclose()
+            finally:
+                if trace:
+                    trace.finish(outcome)
+    return wrapped
