diff --git a/utils/llm_client/prefill.py b/utils/llm_client/prefill.py
new file mode 100644
index 0000000..9c6ca59
--- /dev/null
+++ b/utils/llm_client/prefill.py
@@ -0,0 +1,93 @@
+"""Opt-in policy for the local Strata engine. Only Minecraft owns its pin."""
+from contextvars import ContextVar
+import asyncio
+import os
+from urllib.parse import urlsplit
+import weakref
+
+game_scope: ContextVar[str | None] = ContextVar('minecraft_stable_prefix', default=None)
+_ONE_SHOT = frozenset({'emotion', 'long_response_summary', 'galgame_options', 'agent_cua'})
+_BACKGROUND = frozenset({'emotion', 'long_response_summary', 'galgame_options'})
+_LOOPS = weakref.WeakKeyDictionary()
+
+
+class BackgroundSuperseded(RuntimeError):
+    """An optional background request became obsolete before model dispatch."""
+
+
+def enabled(base_url) -> bool:
+    if os.environ.get('NEKO_LOCAL_STRATA_PREFILL') != '1':
+        return False
+    try:
+        url = urlsplit(str(base_url or ''))
+        return url.scheme == 'http' and url.hostname in {'127.0.0.1', 'localhost', '::1'} and url.port == 18030
+    except ValueError:
+        return False
+
+
+def request_policy(body: dict, base_url, call_type: str) -> dict:
+    if not enabled(base_url):
+        return body
+    prefix = game_scope.get()
+    extra = dict(body.get('extra_body') or {})
+    if call_type in _ONE_SHOT or (prefix is not None and not body.get('tools')):
+        extra.setdefault('strata_checkpoint', False)
+    messages = body.get('messages') or []
+    has_images = any(isinstance(m.get('content'), list) and any(
+        isinstance(p, dict) and p.get('type') in {'image', 'image_url', 'input_image'}
+        for p in m['content']) for m in messages)
+    first = messages[0] if messages else {}
+    content = first.get('content')
+    if prefix and body.get('tools') and not has_images and first.get('role') == 'system' and isinstance(content, str) and content.startswith(prefix):
+        extra.setdefault('strata_prefix', {'message': 0, 'chars': len(prefix)})
+    if not extra:
+        return body
+    return {**body, 'extra_body': extra}
+
+
+def project_game_history(messages):
+    """Keep all user wording and tool receipts; bound only old tagged narration."""
+    def narration(message):
+        meta = getattr(message, 'additional_kwargs', None) or getattr(message, 'metadata', None) or {}
+        return getattr(message, 'type', None) == 'ai' and meta.get('dialog_source') == 'proactive'
+    indexes = [index for index, message in enumerate(messages) if narration(message)]
+    discard = set(indexes[:-6])
+    return [message for index, message in enumerate(messages) if index not in discard] if discard else messages
+
+
+async def background_admission(base_url, call_type, *, probe=None, max_wait=10.0, interval=0.25):
+    """Keep optional local work out of a busy game inference queue.
+
+    Pending requests of the same background category use latest-wins. Running
+    inference is never cancelled; a game request never waits on this lock.
+    """
+    if not enabled(base_url) or call_type not in _BACKGROUND:
+        return
+    loop = asyncio.get_running_loop()
+    state = _LOOPS.setdefault(loop, {'lock': asyncio.Lock(), 'versions': {}})
+    versions = state['versions']
+    ticket = versions[call_type] = versions.get(call_type, 0) + 1
+    deadline = loop.time() + max_wait
+    if probe is None:
+        async def probe():
+            from utils.internal_http_client import get_internal_http_client
+            url = urlsplit(str(base_url))
+            try:
+                response = await get_internal_http_client().get(f'{url.scheme}://{url.netloc}/metrics', timeout=1.0)
+                live = response.json().get('live') or {}
+                return live.get('state') == 'idle' and not live.get('queued')
+            except Exception:
+                # Let the normal provider error handling report an unavailable
+                # endpoint; a diagnostic probe must not replace that behavior.
+                return True
+    async with state['lock']:
+        while True:
+            if versions.get(call_type) != ticket:
+                raise BackgroundSuperseded('A newer optional background request replaced this one')
+            if loop.time() > deadline:
+                raise BackgroundSuperseded('Optional background request expired while game inference was busy')
+            if await probe():
+                if versions.get(call_type) != ticket:
+                    raise BackgroundSuperseded('A newer optional background request replaced this one')
+                return
+            await asyncio.sleep(interval)
