@@ -0,0 +1,25 @@
+import json
+
+from utils import llm_prompt_audit as audit
+
+
+def test_audit_captures_tools_and_wire_without_media_or_transport_secrets(tmp_path, monkeypatch):
+    monkeypatch.setattr(audit, "_ENABLED", True)
+    monkeypatch.setattr(audit, "_LOG_DIR", tmp_path)
+    params = {
+        "model": "local-model", "stream": True,
+        "messages": [{"role": "system", "content": "stable"},
+                     {"role": "user", "content": [{"type": "text", "text": "fresh"},
+                      {"type": "image_url", "image_url": {"url": "data:image/png;base64,PRIVATE"}}]}],
+        "tools": [{"type": "function", "function": {"name": "game", "description": "game tools"}}],
+        "extra_body": {"reasoning_effort": "none"}, "api_key": "SECRET", "extra_headers": {"Authorization": "SECRET"},
+    }
+    audit.record_llm_request(model="local-model", base_url="http://127.0.0.1:18030/v1",
+                             params=params, field_name=None, field_value=None)
+    raw = next(tmp_path.glob("*.jsonl")).read_text(encoding="utf8")
+    row = json.loads(raw)
+    assert row["wire_request"]["tools"] == params["tools"]
+    assert row["tokens_tools_estimate"] > 0
+    assert row["wire_request"]["messages"][0]["content"] == "stable"
+    assert "SECRET" not in raw and "PRIVATE" not in raw
+    assert params["messages"][1]["content"][1]["image_url"]["url"].endswith("PRIVATE")
