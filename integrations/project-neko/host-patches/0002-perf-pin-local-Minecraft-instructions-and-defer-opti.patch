             with _today_path().open("a", encoding="utf-8") as f:
                 f.write(line)
                 f.write("\n")
+            _RECORDS_WRITTEN += 1
     except Exception as e:
         # 审计永远不能影响主流程：jsonl 写盘 / token 计数 / encoding
         # 任意一步失败都吞掉，main LLM call 必须能继续。
