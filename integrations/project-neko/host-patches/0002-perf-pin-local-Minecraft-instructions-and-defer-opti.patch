+import copy
+import asyncio
+from types import SimpleNamespace
+
+from utils.llm_client import prefill
+
+
+def test_only_opted_in_local_game_scope_can_pin_the_validated_prefix(monkeypatch):
+    monkeypatch.setenv('NEKO_LOCAL_STRATA_PREFILL', '1')
+    original = {'messages': [{'role': 'system', 'content': 'fixed rules\nchanging memory'},
+                             {'role': 'user', 'content': 'fresh game state'}],
+                'tools': [{'type': 'function', 'function': {'name': 'minecraft_chat'}}]}
+    before = copy.deepcopy(original)
+    token = prefill.game_scope.set('fixed rules')
+    try:
+        actual = prefill.request_policy(original, 'http://127.0.0.1:18030/v1', 'proactive')
+        assert actual['extra_body']['strata_prefix'] == {'message': 0, 'chars': len('fixed rules')}
+        assert original == before
+        assert prefill.request_policy(original, 'https://api.example.com/v1', 'proactive') is original
+        changed = copy.deepcopy(original)
+        changed['messages'][0]['content'] = 'different persona'
+        assert 'strata_prefix' not in prefill.request_policy(changed, 'http://127.0.0.1:18030/v1', 'proactive').get('extra_body', {})
+    finally:
+        prefill.game_scope.reset(token)
+
+
+def test_background_and_toolless_final_calls_do_not_replace_the_game_pin(monkeypatch):
+    monkeypatch.setenv('NEKO_LOCAL_STRATA_PREFILL', '1')
+    body = {'messages': [{'role': 'system', 'content': 'stable'}]}
+    for kind in ('emotion', 'long_response_summary', 'galgame_options'):
+        result = prefill.request_policy(body, 'http://127.0.0.1:18030/v1', kind)
+        assert result['extra_body']['strata_checkpoint'] is False
+        assert 'strata_prefix' not in result['extra_body']
+    token = prefill.game_scope.set('stable')
+    try:
+        assert prefill.request_policy(body, 'http://127.0.0.1:18030/v1', 'proactive')['extra_body']['strata_checkpoint'] is False
+        image = {**body, 'tools': [{'type': 'function', 'function': {'name': 'game'}}],
+                 'messages': body['messages'] + [{'role': 'user', 'content': [{'type': 'image_url', 'image_url': {'url': 'data:test'}}]}]}
+        assert 'strata_prefix' not in prefill.request_policy(image, 'http://127.0.0.1:18030/v1', 'proactive').get('extra_body', {})
+    finally:
+        prefill.game_scope.reset(token)
+
+
+def test_default_policy_is_byte_identical(monkeypatch):
+    monkeypatch.delenv('NEKO_LOCAL_STRATA_PREFILL', raising=False)
+    body = {'messages': [{'role': 'user', 'content': 'text'}]}
+    assert prefill.request_policy(body, 'http://127.0.0.1:18030/v1', 'emotion') is body
+
+
+def test_history_projection_retains_users_tools_and_recent_narration():
+    history = [SimpleNamespace(type='ai', content=str(i), additional_kwargs={'dialog_source': 'proactive'}) for i in range(20)]
+    user = SimpleNamespace(type='human', content='停止、规则、玩家的原话', additional_kwargs={})
+    tool = {'role': 'tool', 'tool_call_id': 'actual', 'content': 'protection denied'}
+    original = [user, *history, tool]
+    actual = prefill.project_game_history(original)
+    assert actual == [user, *history[-6:], tool]
+    assert len(original) == 22
+
+
+def test_optional_background_is_coalesced_while_game_requests_bypass_it(monkeypatch):
+    monkeypatch.setenv('NEKO_LOCAL_STRATA_PREFILL', '1')
+    async def run():
+        ready = False
+        async def probe():
+            return ready
+        old = asyncio.create_task(prefill.background_admission('http://127.0.0.1:18030/v1', 'emotion', probe=probe, interval=0.001))
+        await asyncio.sleep(0.005)
+        new = asyncio.create_task(prefill.background_admission('http://127.0.0.1:18030/v1', 'emotion', probe=probe, interval=0.001))
+        await prefill.background_admission('http://127.0.0.1:18030/v1', 'proactive', probe=probe)
+        await asyncio.sleep(0.005)
+        ready = True
+        results = await asyncio.gather(old, new, return_exceptions=True)
+        assert isinstance(results[0], prefill.BackgroundSuperseded)
+        assert results[1] is None
+    asyncio.run(run())
+
+
+def test_optional_dialogue_choices_expire_without_waiting_game_work(monkeypatch):
+    monkeypatch.setenv('NEKO_LOCAL_STRATA_PREFILL', '1')
+    async def run():
+        async def busy():
+            return False
+        try:
+            await prefill.background_admission('http://127.0.0.1:18030/v1', 'galgame_options',
+                                               probe=busy, max_wait=0.002, interval=0.001)
+            assert False, 'Obsolete optional work must not reach inference'
+        except prefill.BackgroundSuperseded:
+            pass
+        await prefill.background_admission('http://127.0.0.1:18030/v1', 'proactive', probe=busy)
+    asyncio.run(run())
