+
+    This remains behind the existing explicit full-prompt audit switch. Counts
+    in this module are estimates; replay this body through the target model's
+    tokenizer/template to measure exact input tokens.
+    """
+    result = {key: params[key] for key in (
+        "model", "tools", "tool_choice", "reasoning_effort", "chat_template_kwargs",
