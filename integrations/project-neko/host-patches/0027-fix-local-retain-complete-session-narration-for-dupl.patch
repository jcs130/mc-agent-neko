         narration_message, remember_narration,
     )
@@ -43,7 +43,7 @@ def test_speech_recency_keeps_whole_quotes_and_expires_without_replaying_old_res
     assert [text for _, text in client._minecraft_narration] == [str(n) + '语' * 300 for n in range(9)]
