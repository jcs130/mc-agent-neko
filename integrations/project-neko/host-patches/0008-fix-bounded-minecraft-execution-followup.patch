+def _minecraft_action_followup_tools(messages, tools):
+    """Give known-query-only idle turns an optional, bounded action opportunity.
+
+    Inspect this invocation's tool replies, never old history. Unknown server
+    commands are not classified as queries. This grants no user authority.
+    """
+    decision = None
+    seen = False
+    for message in messages:
+        if not isinstance(message, dict) or message.get("role") != "tool":
+            continue
+        seen = True
+        try:
+            output = json.loads(message.get("content", ""))
+        except (TypeError, ValueError):
+            return []
+        if not isinstance(output, dict):
+            return []
+        if message.get("name") == "minecraft_observe":
+            decision = output.get("decision")
+        elif message.get("name") != "minecraft_server" or output.get("readOnly") is not True:
+            return []
+    if not seen or not isinstance(decision, dict) or decision.get("status") != "ready_if_authorized":
+        return []
+    return [tool for tool in tools or [] if tool.get("function", {}).get("name") in
+            {"minecraft_task", "minecraft_server", "minecraft_chat"}]
+
