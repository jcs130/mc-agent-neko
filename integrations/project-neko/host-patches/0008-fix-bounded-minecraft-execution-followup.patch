+@pytest.mark.asyncio
+@pytest.mark.parametrize("cancel_final", [False, True])
+async def test_minecraft_final_opportunity_can_pause_or_be_cancelled_without_acting(cancel_final, monkeypatch):
+    from main_logic.omni_offline_client import _tools
+    from main_logic.tool_calling import ToolDefinition, ToolResult
+    from utils.llm_client import LLMStreamChunk
+
+    active = True
+    seen = []
+    chunks = [LLMStreamChunk(content="", tool_call_deltas=[{
+        "index": 0, "id": "observation", "type": "function",
+        "function": {"name": "minecraft_observe", "arguments": "{}"},
+    }], finish_reason="tool_calls")]
+
+    class PausingLLM(_FakeLLM):
+        def astream(self, messages, **options):
+            stream = super().astream(messages, **options)
+            if len(self.calls) != 4:
+                return stream
+
+            async def final():
+                nonlocal active
+                if cancel_final:
+                    active = False
+                    yield LLMStreamChunk(content="late", tool_call_deltas=[{
+                        "index": 0, "id": "late", "type": "function",
+                        "function": {"name": "minecraft_task", "arguments": "{}"},
+                    }], finish_reason="tool_calls")
+                else:
+                    yield LLMStreamChunk(content="先暂停", finish_reason="stop")
+            return final()
+
+    monkeypatch.setattr(_tools, "_generation_check", lambda *_: lambda: active)
+
+    async def handler(call):
+        seen.append(call.name)
+        return ToolResult(call_id=call.call_id, name=call.name,
+                          output={"decision": {"status": "ready_if_authorized"}})
+
+    llm = PausingLLM([chunks, chunks, chunks, []])
+    client = _bare_tool_client(llm, ToolDefinition(name="minecraft_observe", description=""), handler, cap=3)
+    client._tool_definitions.append(ToolDefinition(name="minecraft_task", description=""))
