+async def test_minecraft_query_cap_preserves_one_existing_action_opportunity(
+    scope, ready, server_read_only, expect_action,
+):
+    from utils.llm_client import LLMStreamChunk
+    from main_logic.tool_calling import ToolDefinition, ToolResult
+
+    def call(name, number):
+        return [LLMStreamChunk(content="", tool_call_deltas=[{
+            "index": 0, "id": f"mc{number}", "type": "function",
+            "function": {"name": name, "arguments": "{}"},
+        }], finish_reason="tool_calls")]
+
+    script = [call("minecraft_observe", 1), call("minecraft_server", 2),
+              call("minecraft_observe", 3)]
+    script.append(call("minecraft_task", 4) if expect_action else
+                  [LLMStreamChunk(content="暂停", finish_reason="stop")])
+    llm = _FakeLLM(script)
+    executed = []
+
+    async def handler(tool_call):
+        executed.append(tool_call.name)
+        output = {"decision": {"status": "ready_if_authorized" if ready else "busy"}}
+        if tool_call.name == "minecraft_server":
+            output = {"readOnly": server_read_only, "status": "received"}
+        return ToolResult(call_id=tool_call.call_id, name=tool_call.name, output=output)
+
+    client = _bare_tool_client(llm, ToolDefinition(name="minecraft_observe", description=""), handler, cap=3)
+    client._tool_definitions = [ToolDefinition(name=name, description="") for name in
+                                ("minecraft_observe", "minecraft_task", "minecraft_server", "minecraft_chat", "other")]
+    messages = [{"role": "user", "content": "continue if still authorized"}]
+    async for _chunk in client._astream_with_tools(messages, _minecraft_execution_turn=scope):
+        pass
+    assert len(llm.calls) == 4, "reuse the existing final request; never add another model round"
+    options = llm.calls[-1][1]
+    assert "_minecraft_execution_turn" not in options
+    if expect_action:
+        assert executed[-1] == "minecraft_task"
+        assert {tool["function"]["name"] for tool in options["tools"]} == {
+            "minecraft_task", "minecraft_server", "minecraft_chat"}
+        assert options.get("tool_choice", "auto") == "auto", "pause/stop must remain possible"
+        assert messages[-1]["role"] == "tool"
+    else:
+        assert executed == ["minecraft_observe", "minecraft_server", "minecraft_observe"]
+        assert "tools" not in options
+
