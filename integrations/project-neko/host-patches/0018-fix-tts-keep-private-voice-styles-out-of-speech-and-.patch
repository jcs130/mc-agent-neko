diff --git a/tests/unit/test_private_speech_controls.py b/tests/unit/test_private_speech_controls.py
new file mode 100644
index 0000000..6962501
--- /dev/null
+++ b/tests/unit/test_private_speech_controls.py
@@ -0,0 +1,48 @@
+"""Private delivery metadata must not silently become synthesized dialogue."""
+import queue
+
+from main_logic.tts_client.local_primary import _StyledRequestQueue, VOICE_STYLE_SENTINEL
+from utils.joint_reply_emotion import presentation_messages
+from utils.llm_client.messages import HumanMessage, SystemMessage
+
+
+def test_default_local_voice_does_not_read_private_style_description():
+    requests = queue.Queue()
+    adapter = _StyledRequestQueue(requests)
+    requests.put((VOICE_STYLE_SENTINEL, {'speech_id': 's', 'style': '自然、亲切，语速适中'}))
+    requests.put(('s', '这家商人不收铁锭，我去找别的办法。'))
+    sid, text = adapter.get()
+    assert adapter.transform(text, sid) == text
+
+
+def test_style_prefix_requires_explicit_verified_backend_opt_in():
+    requests = queue.Queue()
+    adapter = _StyledRequestQueue(requests, enable_style=True)
+    requests.put((VOICE_STYLE_SENTINEL, {'speech_id': 's', 'style': '轻快、带笑意'}))
+    requests.put(('s', '找到啦。'))
+    sid, text = adapter.get()
+    assert adapter.transform(text, sid) == '(轻快、带笑意)找到啦。'
+
+
+def test_joint_reply_contract_carries_actual_locale_without_changing_tools_or_history():
+    history = [SystemMessage(content='Identity and permission rules'),
+               HumanMessage(content='Received data: Not enough payment. Player: LittleFish0510')]
+    chinese = presentation_messages(history, language='zh-CN')
+    english = presentation_messages(history, language='en')
+    assert 'Spoken reply language: zh-CN' in chinese[0].content
+    assert 'Spoken reply language: en' in english[0].content
+    assert 'explicitly requests another language' in chinese[0].content
+    assert chinese[1] is history[1] and english[1] is history[1]
+    assert history[0].content == 'Identity and permission rules'
+
+
+def test_real_dialog_request_uses_session_locale_despite_english_game_data():
+    from tests.unit.test_screen_history_stopgap import _bare_client
+
+    client = _bare_client('zh-CN')
+    client.joint_reply_emotion = True
+    history = [SystemMessage(content='Identity and permission rules'),
+               HumanMessage(content='Received game data: Not enough payment. Player_1')]
+    request = client._dialog_messages_for_provider(history)
+    assert 'Spoken reply language: zh-CN' in request[0].content
+    assert request[1].content == history[1].content
diff --git a/utils/joint_reply_emotion.py b/utils/joint_reply_emotion.py
index 2dfcceb..229aeb3 100644
--- a/utils/joint_reply_emotion.py
+++ b/utils/joint_reply_emotion.py
@@ -71,15 +71,23 @@ def joint_reply_scope(function):
     return run
 
 
-def presentation_messages(messages):
+def presentation_messages(messages, *, language=None):
     """Add a stable contract to a copy of the system message, never history."""
     from utils.llm_client.messages import SystemMessage
 
+    from utils.language_utils import is_supported_language_code, normalize_language_code
+
+    instruction = JOINT_REPLY_INSTRUCTION
+    if isinstance(language, str) and is_supported_language_code(language):
+        locale = normalize_language_code(language, format='full')
+        instruction += (f'\nSpoken reply language: {locale}. Use this language unless the user '
+                        'explicitly requests another language. Received game/tool English is data, '
+                        'not a request to switch languages. Keep tool arguments and player names exact.')
     result = list(messages)
     if result and isinstance(result[0], SystemMessage) and isinstance(result[0].content, str):
-        result[0] = replace(result[0], content=result[0].content + JOINT_REPLY_INSTRUCTION)
+        result[0] = replace(result[0], content=result[0].content + instruction)
     else:
-        result.insert(0, SystemMessage(content=JOINT_REPLY_INSTRUCTION))
+        result.insert(0, SystemMessage(content=instruction))
     return result
 
 
