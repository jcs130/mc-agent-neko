+from main_logic.core import LLMSessionManager
+from tests.unit.test_openai_compatible_tts import _install_fake_openai, _wait_for_item
+from tests.unit.test_tts_audio_done_forward import (
+    _RecordingWebsocket, _make_mgr, _start_handler, _stop, _wait_for,
+)
+
+
+@pytest.mark.asyncio
+async def test_slow_local_audio_keeps_source_turn_and_identical_new_reply_is_not_lost(monkeypatch):
+    gate = threading.Event()
+    started = threading.Event()
+    pcm = b'\x01\x00' * 4800
+
+    async def chunks():
+        started.set()
+        while not gate.is_set():
+            await asyncio.sleep(0.005)
+        yield pcm
+
+    clients = _install_fake_openai(monkeypatch, chunks)
+    requests, responses = queue.Queue(), queue.Queue()
+    worker = threading.Thread(target=voxcpm_primary_worker,
+        args=(requests, responses, '', 'ignored'),
+        kwargs={'base_url': 'http://127.0.0.1:18041/v1', 'local_voice': 'test-local'}, daemon=True)
+    worker.start()
+    handler = None
+    try:
+        await asyncio.to_thread(_wait_for_item, responses, lambda item: item == ('__ready__', True))
+        requests.put(('reply-a', '收到。'))
+        requests.put((None, None))
+        assert await asyncio.to_thread(started.wait, 3)
+        # A later model turn is already current while A's HTTP audio is pending.
+        requests.put(('reply-b', '收到。'))
+        requests.put((None, None))
+        ws = _RecordingWebsocket()
+        manager = _make_mgr(ws)
+        manager.current_speech_id = 'reply-b'
+        manager.tts_response_queue = responses
+        handler = await _start_handler(manager)
+        gate.set()
+        assert await _wait_for(lambda: sum(kind == 'json' and value.get('type') == 'audio_done'
+            for kind, value in ws.calls) == 2, timeout=5)
+        headers = [value for kind, value in ws.calls if kind == 'json' and value['type'] == 'audio_chunk']
+        assert {header['speech_id'] for header in headers} == {'reply-a', 'reply-b'}
+        assert all(header['turn_id'] == header['speech_id'] for header in headers)
+        by_speech = {'reply-a': bytearray(), 'reply-b': bytearray()}
+        active = None
+        for kind, value in ws.calls:
+            if kind == 'json' and value['type'] == 'audio_chunk':
+                active = value['speech_id']
+            elif kind == 'bytes':
+                by_speech[active].extend(value)
+        assert bytes(by_speech['reply-a']) == bytes(by_speech['reply-b']) == pcm
+        assert [call['input'] for call in clients[0].create_calls] == ['收到。', '收到。']
+    finally:
+        gate.set()
+        if handler:
+            await _stop(handler)
+        requests.put(('__shutdown__', None))
+        await asyncio.to_thread(worker.join, 5)
+        assert not worker.is_alive()
+
+
+@pytest.mark.asyncio
+async def test_old_audio_cannot_acknowledge_the_new_turn_fallback_ledger():
+    ws = _RecordingWebsocket()
+    manager = _make_mgr(ws)
+    manager.current_speech_id = 'reply-b'
+    manager._tts_replay_speech_id = 'reply-b'
+    manager._tts_replay_sent_chunks = [('reply-b', '新答复。')]
+    handler = await _start_handler(manager,
+        ('__audio__', 'reply-a', b'\x01\x00'),
+        ('__tts_sentence_done__', 'reply-a', '旧答复。'),
+        ('__tts_sentence_done__', 'reply-b', '新答复。'),
+        ('__audio_done__', 'reply-a'))
+    try:
+        assert await _wait_for(lambda: ws.audio_done_seen.is_set())
+        assert manager._tts_replay_sent_chunks == [('reply-b', '新答复。')]
+        assert manager._tts_replay_audio_emitted is False
+    finally:
+        await _stop(handler)
+
+
+def test_long_local_utterance_does_not_timeout_while_new_audio_is_delivered():
+    manager = LLMSessionManager.__new__(LLMSessionManager)
+    manager.lanlan_name = 'test'
+    manager._voice_playback_active = True
+    manager._voice_playback_started_ts = time.monotonic() - manager._VOICE_PLAYBACK_STALE_S - 5
+    manager._tts_active_provider_key = LOCAL_PRIMARY_PROVIDER
+    manager._last_speech_output_time = time.time() - 1
+    assert manager._is_voice_playing() is True
+    manager._last_speech_output_time = time.time() - manager._VOICE_PLAYBACK_STALE_S - 5
+    assert manager._is_voice_playing() is False
+
+
+def test_other_providers_keep_existing_playback_watchdog():
+    manager = LLMSessionManager.__new__(LLMSessionManager)
+    manager.lanlan_name = 'test'
+    manager._voice_playback_active = True
+    manager._voice_playback_started_ts = time.monotonic() - manager._VOICE_PLAYBACK_STALE_S - 5
+    manager._tts_active_provider_key = 'test-online'
+    manager._last_speech_output_time = time.time() - 1
+    assert manager._is_voice_playing() is False
